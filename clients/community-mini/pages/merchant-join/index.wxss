/* Exact Owner20261024 upload-first visual system; fields remain original contracts. */
.onboarding-header{background:#c54450;color:#fff;padding:24rpx 26rpx;font-size:29rpx;font-weight:700}
.onboarding-header text{display:block}.onboarding-header .header-note{font-size:21rpx;font-weight:400;color:#f1d5da;margin-top:8rpx}
.onboarding-page{padding:20rpx 24rpx 190rpx;color:#34292d;background:#fff5f6}
.onboarding-page .title{font-size:44rpx;margin:22rpx 0 12rpx}.onboarding-page .subtitle{font-size:25rpx;color:#b83b48;margin-bottom:25rpx}
.onboarding-page .card{border:1rpx solid #f1d5da;border-radius:27rpx;box-shadow:none;padding:26rpx;margin:24rpx 0}
.onboarding-page .section-title{font-size:33rpx;margin:0 0 20rpx}.onboarding-page .fields-heading{display:block;font-weight:700;font-size:27rpx;margin:24rpx 0 16rpx}
.onboarding-page picker{background:#ffe4e8;border:1.5rpx solid #d77988;border-radius:12rpx;padding:23rpx 18rpx;color:#b83b48;font-weight:600;font-size:26rpx;margin:16rpx 0 22rpx}
.onboarding-page label{display:block;margin:20rpx 0 26rpx;color:#756068;font-size:23rpx}.onboarding-page input{margin:8rpx 0 0;padding:17rpx 16rpx;border:1rpx solid #e7bdc4;border-radius:9rpx;font-size:25rpx;min-height:72rpx;color:#34292d;background:#fff}
.onboarding-page .upload-slot{margin:18rpx 0}.onboarding-page .upload-choice{display:block;text-align:left;white-space:normal;line-height:1.6;background:#fff5f6;color:#b83b48;border:3rpx solid #d77988;border-radius:13rpx;padding:19rpx 17rpx;min-height:152rpx;margin:0}
.upload-choice text{display:block}.upload-choice .upload-title{font-weight:700;margin-bottom:13rpx}.upload-choice .upload-help{font-size:20rpx;color:#756068}
.onboarding-page .material-state,.onboarding-page .hint{display:block;font-size:22rpx;color:#756068;line-height:1.65;margin-top:18rpx}
.onboarding-page .material-preview{display:block;width:100%;height:360rpx;margin-top:16rpx;border-radius:18rpx;background:#fff5f6}
.onboarding-page .text-link,.onboarding-page .back-link{background:transparent;color:#b83b48;text-align:left;padding:10rpx 0;margin:8rpx 0;min-height:50rpx;font-size:24rpx;font-weight:400}
.onboarding-page .back-link{color:#b83b48}.onboarding-page .primary{background:#c54450;color:white;border-radius:11rpx;font-size:27rpx;font-weight:700}
.onboarding-page .save-next{margin:28rpx 0}.status-notice{font-size:23rpx;padding:16rpx 20rpx;border-left:5rpx solid #d77988;background:#ffe4e8;margin:20rpx 0;color:#b83b48}.group-recognition{border-bottom:1rpx solid #f1d5da;padding-bottom:12rpx}.field-error{color:#b42318;font-size:23rpx}

.onboarding-page .progress-state{display:block;margin:14rpx 0;color:#34292d;line-height:1.65}

/* Confirmed 60f1 UI: readable values first, original editable controls retained. */
.confirmed-field-list{border-top:1rpx solid #f1d5da;margin-top:20rpx}.confirmed-field{display:flex;flex-direction:column;padding:22rpx 0;border-bottom:1rpx solid #f1d5da;gap:10rpx}.confirmed-label{font-size:24rpx;color:#756068}.confirmed-value{font-size:28rpx;color:#34292d;word-break:break-all}.edit-group{font-size:24rpx;color:#c54450;}

/* Confirmed 60f1 native layout; original form events and data stay intact. */
.onboarding-header{background:#fff;color:#34292d;text-align:center;padding:26rpx 36rpx;font-size:30rpx;font-weight:600;border-bottom:1rpx solid #eee9ec}
.onboarding-intro{padding:52rpx 40rpx 40rpx;background:linear-gradient(135deg,#ffe4e8,#fff5f6);color:#34292d}
.intro-pill{display:inline-block;border-radius:30rpx;padding:8rpx 16rpx;background:#fff;color:#b83b48;font-size:20rpx}
.intro-title{display:block;font-size:48rpx;font-weight:650;margin:18rpx 0;letter-spacing:-1rpx}
.intro-description{font-size:24rpx;color:#756068}
.onboarding-page{padding:20rpx 28rpx 190rpx;background:#fff5f6;color:#34292d}
.onboarding-stages{display:flex;flex-wrap:wrap;gap:10rpx;margin:20rpx 0 34rpx}.stage-item{flex:1;min-width:120rpx;padding:16rpx 8rpx;text-align:center;color:#756068;font-size:21rpx;border-bottom:3rpx solid #f1d5da}.stage-item.active{color:#b83b48;border-color:#b83b48;font-weight:700}
.onboarding-page .card{background:#fff;border:1rpx solid #f1d5da;border-radius:28rpx;padding:32rpx;margin:22rpx 0;box-shadow:none}
.onboarding-page .title{font-size:36rpx;color:#34292d;font-weight:650}.onboarding-page .subtitle{font-size:24rpx;color:#756068;line-height:1.7}
.onboarding-page .section-title{font-size:32rpx;color:#34292d;font-weight:650;margin-bottom:28rpx}
.onboarding-page .upload-choice{border:1rpx solid #f1d5da;background:#fff5f6;border-radius:22rpx;padding:30rpx 22rpx;min-height:140rpx;text-align:left;color:#34292d}
.onboarding-page picker{background:#fff5f6;border:1rpx solid #f1d5da;border-radius:18rpx;padding:24rpx 18rpx;color:#34292d;font-size:25rpx;font-weight:400}
.onboarding-page .primary{background:#c54450;color:#fff;border:0;border-radius:22rpx;min-height:88rpx;font-size:28rpx}.onboarding-page .hint{color:#756068;font-size:23rpx;line-height:1.8}

/* Explicit touch target, not a color-only link. */
.onboarding-page .edit-group{display:block;width:100%;min-height:88rpx;margin:24rpx 0 16rpx;padding:16rpx 24rpx;border:2rpx solid #c54450;border-radius:16rpx;background:#ffe4e8;color:#b83b48;font-size:30rpx;font-weight:600;line-height:1.6;text-align:center}
.onboarding-page .edit-group-pressed{background:#e7bdc4}
.onboarding-page .edit-group[disabled]{background:#eee9ec;color:#756068;border-color:#eee9ec}

.onboarding-page .redemption-picker{margin:12rpx 0;padding:16rpx 20rpx;border:2rpx solid #d77988;border-radius:12rpx;font-size:28rpx;color:#b83b48;background:#fff5f6}

/* Upload feedback stays centered on its own image, independent of OCR/pending. */
.onboarding-page .material-preview-frame{position:relative;margin-top:16rpx;border-radius:18rpx;overflow:hidden}
.onboarding-page .material-preview-frame .material-preview{margin-top:0}
.material-upload-overlay{position:absolute;top:0;right:0;bottom:0;left:0;display:flex;align-items:center;justify-content:center;background:rgba(25,46,48,.30);padding:24rpx;box-sizing:border-box}
.material-upload-label{display:block;max-width:100%;padding:18rpx 24rpx;border-radius:16rpx;background:rgba(25,46,48,.90);color:#fff;font-size:30rpx;font-weight:600;line-height:1.6;text-align:center;word-break:break-word}

.material-ocr-overlay .material-ocr-label{font-size:36rpx;font-weight:700;line-height:1.5}

/* The industry picker must shrink inside the mobile card, including long labels. */
.industry-section{min-width:0;max-width:100%;box-sizing:border-box;}
.industry-picker{display:block;width:100%;min-width:0;max-width:100%;box-sizing:border-box;}
.industry-picker view{min-width:0;max-width:100%;white-space:normal;overflow-wrap:anywhere;word-break:break-all;box-sizing:border-box;}
.industry-section .hint{display:block;max-width:100%;overflow-wrap:anywhere;word-break:break-word;}

.missing-field-highlight{outline:4rpx solid #b94732;background:#fff4ef}.missing-summary{border:2rpx solid #b94732}.missing-summary button{white-space:normal;text-align:left;color:#b83b48}

page{background:linear-gradient(180deg,#ffe4e8 0,#fff5f6 460rpx)}
