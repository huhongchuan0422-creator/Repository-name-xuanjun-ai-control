/* Exact Owner20261024 upload-first visual system; fields remain original contracts. */
.onboarding-header{background:#174c38;color:#fff;padding:24rpx 26rpx;font-size:29rpx;font-weight:700}
.onboarding-header text{display:block}.onboarding-header .header-note{font-size:21rpx;font-weight:400;color:#c1d9cb;margin-top:8rpx}
.onboarding-page{padding:20rpx 24rpx 190rpx;color:#203e31;background:#f3f7f4}
.onboarding-page .title{font-size:44rpx;margin:22rpx 0 12rpx}.onboarding-page .subtitle{font-size:25rpx;color:#46765b;margin-bottom:25rpx}
.onboarding-page .card{border:1rpx solid #d7e4db;border-radius:27rpx;box-shadow:none;padding:26rpx;margin:24rpx 0}
.onboarding-page .section-title{font-size:33rpx;margin:0 0 20rpx}.onboarding-page .fields-heading{display:block;font-weight:700;font-size:27rpx;margin:24rpx 0 16rpx}
.onboarding-page picker{background:#e6f1e9;border:1.5rpx solid #91bba1;border-radius:12rpx;padding:23rpx 18rpx;color:#175839;font-weight:600;font-size:26rpx;margin:16rpx 0 22rpx}
.onboarding-page label{display:block;margin:20rpx 0 26rpx;color:#63796b;font-size:23rpx}.onboarding-page input{margin:8rpx 0 0;padding:17rpx 16rpx;border:1rpx solid #b9ccbf;border-radius:9rpx;font-size:25rpx;min-height:72rpx;color:#203e31;background:#fff}
.onboarding-page .upload-slot{margin:18rpx 0}.onboarding-page .upload-choice{display:block;text-align:left;white-space:normal;line-height:1.6;background:#f4faf6;color:#226644;border:3rpx solid #79a78b;border-radius:13rpx;padding:19rpx 17rpx;min-height:152rpx;margin:0}
.upload-choice text{display:block}.upload-choice .upload-title{font-weight:700;margin-bottom:13rpx}.upload-choice .upload-help{font-size:20rpx;color:#63796b}
.onboarding-page .material-state,.onboarding-page .hint{display:block;font-size:22rpx;color:#63796b;line-height:1.65;margin-top:18rpx}
.onboarding-page .text-link,.onboarding-page .back-link{background:transparent;color:#337250;text-align:left;padding:10rpx 0;margin:8rpx 0;min-height:50rpx;font-size:24rpx;font-weight:400}
.onboarding-page .back-link{color:#68967c}.onboarding-page .primary{background:#1d7653;color:white;border-radius:11rpx;font-size:27rpx;font-weight:700}
.onboarding-page .save-next{margin:28rpx 0}.status-notice{font-size:23rpx;padding:16rpx 20rpx;border-left:5rpx solid #8da891;background:#edf3f0;margin:20rpx 0;color:#526e5a}.group-recognition{border-bottom:1rpx solid #dce6df;padding-bottom:12rpx}.field-error{color:#b42318;font-size:23rpx}
