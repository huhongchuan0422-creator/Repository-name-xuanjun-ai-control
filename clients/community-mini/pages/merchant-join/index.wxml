<view class="onboarding-header"><text>商家入驻</text></view><view class="onboarding-intro"><text class="intro-pill">安心准备，逐项核对</text><text class="intro-title">开启您的邻里生意</text></view>
<view class="page onboarding-page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="xj-nav"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view>
<button class="back-link" bindtap="goBack">‹ 返回同一申请</button><view class="onboarding-stages"><text wx:for="{{steps}}" wx:key="*this" class="stage-item {{index===step?'active':''}}">{{index+1}} {{item}}</text></view>
<text class="title">{{steps[step]}}</text><text class="subtitle">{{step===0?'先选类型 → 上传材料 → 核对识别结果':step===1?'确认实际经营 → 选择材料 → 填写经营资料':step===2?'填写结算账户资料':'分别核对上传、平台审核与微信进度'}}</text>
<view class="status-notice" wx:if="{{status}}" aria-live="polite">{{status}}</view>
<view wx:if="{{!authenticated}}" class="card"><text class="section-title">微信登录后开始办理</text><text class="hint">无需已有门店账号。仅保存本人的申请，不自动关联门店、赋予商家权限或开通支付。</text><button class="primary" bindtap="connectApplicant" loading="{{pending}}" disabled="{{pending}}">{{pending?'正在验证身份':'微信登录 / 注册并开始入驻'}}</button></view>
<view wx:if="{{authenticated&&!ready&&readState==='LOADING'}}" class="card"><text class="section-title">正在读取入驻资料</text><text class="hint">微信身份已验证，正在读取材料清单和本人申请，请稍候。</text></view>
<view wx:if="{{authenticated&&!ready&&readState==='FAILED'}}" class="card"><text class="section-title">入驻资料暂未读取完成</text><text class="hint">{{readError}}</text><button class="primary" bindtap="retryApplicantRead" loading="{{pending}}" disabled="{{pending}}">{{pending?'正在重新读取':'重新读取资料'}}</button></view>
<view wx:if="{{leavePrompt}}" class="card"><text>当前有未保存修改。</text><button class="primary" bindtap="saveAndLeave" disabled="{{pending}}">保存并离开</button><button bindtap="cancelLeave" disabled="{{pending}}">继续填写</button></view>
<view class="card" wx:if="{{!application && applications.length}}"><text class="section-title">继续本人的原申请</text><button wx:for="{{applications}}" wx:key="application" data-application="{{item.application}}" bindtap="select">{{item.fields.store_name||'未填写商户名称'}} · {{stateLabels[item.status]||'状态待核对'}}</button></view>
<block wx:if="{{ready||status&&!pending}}">
<view class="card" wx:if="{{step===1}}"><text class="section-title">爱心捐赠比例</text><view class="field"><text>爱心捐赠比例（%）</text><input type="digit" value="{{splitInput}}" bindinput="inputSplitPercent" disabled="{{pending||!canEditPlatform||splitSaveUnknown}}" placeholder="请填写爱心捐赠比例" /></view><text>已保存：{{requestedSplitLabel}}</text><view wx:if="{{splitSaveUnknown}}"><text class="field-error">保存结果待核实，不自动重试。</text><button bindtap="reloadSplitChoice" disabled="{{pending}}">重新读取原申请</button></view></view>
<view class="card redemption-card" wx:if="{{step===1}}"><text class="section-title">爱心积分抵扣收款金额比例</text><picker class="redemption-picker" range="{{redemptionOptions}}" value="{{redemptionIndex}}" bindchange="chooseRedemption" disabled="{{pending||!canEditPlatform}}" aria-label="爱心积分抵扣收款金额比例"><view>当前申请：{{pendingRedemptionPercent}}% · {{canEditPlatform?'点击选择':'当前只读'}} ▾</view></picker></view>
<view wx:for="{{materialGroups}}" wx:for-item="group" wx:key="id" id="material-{{group.id}}" class="card material-group">
 <text class="section-title">{{group.title}}</text><view wx:if="{{group.id==='store'}}"><text class="confirmed-label">实际经营地区</text><text>{{regionResolved?regionLabel:regionRetained?'原地区资料已保留':'待确认'}}</text><text wx:if="{{regionResolutionMessage}}" class="field-error">{{regionResolutionMessage}}</text></view><button wx:if="{{group.optional}}" class="text-link" bindtap="toggleOptional">{{showOptionalMaterials?'收起原选填补充':'展开原选填补充（非必填）'}}</button>
 <picker wx:if="{{group.condition}}" range="{{group.conditionLabels}}" value="{{group.conditionValue}}" data-key="{{group.condition}}" bindchange="condition" disabled="{{pending||!canEditPlatform}}"><view>{{group.conditionLabel}} ›</view></picker>
 <picker wx:if="{{group.docPath}}" range="{{group.docLabels}}" value="{{group.docValue}}" data-path="{{group.docPath}}" bindchange="selectDocumentType" disabled="{{pending||!canEditWechat}}"><view>证件类型 * · {{group.docLabel}} ›</view></picker>
 <text wx:if="{{group.materialWarning}}" class="field-error">{{group.materialWarning}}</text>
 <text wx:if="{{!ready&&group.materials.length}}" class="hint">登录后读取材料清单</text><view wx:for="{{group.materials}}" wx:if="{{!group.optional||showOptionalMaterials}}" wx:key="id" class="upload-slot">
  <button class="upload-choice" data-kind="{{item.id}}" bindtap="upload" disabled="{{pending||!canEditPlatform||!item.connected}}"><text class="upload-title">＋ {{item.title}} {{item.required?'*':''}}</text><text>{{item.uploaded?'重新拍照 / 从相册更换':'拍照 / 从相册选择'}}</text><text class="upload-help">{{group.photos?'本框1张，可更换；不做文字识别':'请上传清晰完整的证照照片'}}</text></button>
  <view wx:if="{{materialPreviews[item.id]}}" class="material-preview-frame">
   <image class="material-preview" src="{{materialPreviews[item.id]}}" mode="aspectFit" />
   <view wx:if="{{uploadFeedback&&uploadFeedback.kind===item.id}}" class="material-upload-overlay" aria-live="polite"><text class="material-upload-label">{{uploadFeedback.label}}</text></view>
   <view wx:elif="{{ocrFeedback&&ocrFeedback.kind===item.id}}" class="material-upload-overlay material-ocr-overlay" aria-live="polite"><text class="material-upload-label material-ocr-label">{{ocrFeedback.label}}</text></view>
  </view>
  <text wx:if="{{materialPreviewHints[item.id]}}" class="hint">{{materialPreviewHints[item.id]}}</text>
  <text wx:if="{{step!==1||item.uploaded||item.synced}}" class="material-state">{{item.uploaded?'原申请已上传':'未选择材料'}} · {{item.synced?'已选用于微信申请':'尚未选用于微信申请'}}{{item.uploaded?' · 审核：'+(stateLabels[item.review]||'状态待核对'):''}}</text>
  <button wx:if="{{item.uploaded}}" class="text-link" data-kind="{{item.id}}" bindtap="syncMaterial" disabled="{{pending||!canEditWechat}}">{{item.synced?'更新申请照片':'用于微信申请'}}</button>
  <button wx:if="{{group.photos&&item.synced&&item.id!=='cashier_photo'}}" class="text-link" data-kind="{{item.id}}" bindtap="removeScenePhoto" disabled="{{pending||!canEditWechat}}">取消选用（保留原照片）</button>
  <button wx:if="{{item.id==='cashier_photo'&&item.uploaded}}" class="text-link" bindtap="removeCashierPhoto" disabled="{{pending||!canEditPlatform}}">移除本次收银台材料（历史保留）</button>
 </view>
 <view wx:if="{{group.ocrKind&&application}}" class="group-recognition">
  <button class="text-link" data-kind="{{group.ocrKind}}" bindtap="recognizeDocument" disabled="{{pending}}">{{group.ocrKind==='bank_card'?'识别银行卡':group.ocrBackKind?'识别身份证人像面':'识别营业执照'}}</button>
  <button wx:if="{{group.ocrBackKind}}" class="text-link" data-kind="{{group.ocrBackKind}}" bindtap="recognizeDocument" disabled="{{pending}}">识别身份证国徽面</button>
  <view wx:if="{{ocrKind===group.ocrKind||(group.ocrBackKind&&ocrKind===group.ocrBackKind)}}"><text class="hint" aria-live="polite">{{ocrStatus}}</text><view wx:for="{{ocrRows}}" wx:key="key" wx:if="{{item.key==='issuing_authority'}}"><label>{{item.label}}<input value="{{item.value}}" data-key="{{item.key}}" bindinput="editOcrSuggestion" bindfocus="focusOcrSuggestion" bindblur="blurOcrSuggestion" disabled="{{pending}}" /><text wx:if="{{item.hint}}" class="hint">{{item.hint}}</text></label></view><button wx:if="{{ocrJob}}" class="text-link" bindtap="readOcr" disabled="{{pending}}">查看识别结果</button><button wx:if="{{ocrRows.length}}" bindtap="confirmOcr" disabled="{{pending}}">确认已核对</button><button wx:if="{{ocrConfirmed}}" bindtap="fillOcrDraft" disabled="{{pending||!canEditWechat}}">保存已核对资料（仅填空白，不覆盖已有内容）</button></view>
  <text wx:else class="hint">点击识别后请核对结果，已填写的资料不会被自动覆盖。</text>
 </view>
 <button wx:if="{{group.hasOcrFields}}" class="edit-group" hover-class="edit-group-pressed" aria-label="{{editMaterialGroup===group.id?'收起资料编辑，未保存修改仍保留':'点击修改本组识别资料'}}" data-group="{{group.id}}" bindtap="toggleMaterialEdit" disabled="{{pending||!canEditWechat}}">{{editMaterialGroup===group.id?'收起修改':'点击修改'}}</button>
 <text wx:if="{{group.hasOcrFields}}" class="fields-heading">识别结果请核对</text>
 <view class="confirmed-field-list" wx:if="{{group.hasOcrFields && group.id!=='qualification' && editMaterialGroup!==group.id}}"><view wx:for="{{group.fields}}" wx:key="path" wx:if="{{item.ocrResultPresent && item.path!=='business_info.sales_info.biz_store_info.biz_address_code' && item.path!=='bank_account_info.bank_branch_id'}}" class="confirmed-field"><text class="confirmed-label">{{item.label}} {{item.required?'*':''}}</text><text class="confirmed-value">{{item.choices?item.choiceLabel:item.value||'待核对填写'}}</text><text wx:if="{{item.ocrHint}}" class="hint">{{item.ocrHint}}</text></view></view>
 <view class="fields" wx:if="{{group.fields.length && group.id!=='qualification'}}"><block wx:for="{{group.fields}}" wx:key="path"><label wx:if="{{(!item.ocrResultPresent||editMaterialGroup===group.id) && item.path!=='business_info.sales_info.biz_store_info.biz_address_code' && item.path!=='bank_account_info.bank_branch_id'}}"><text>{{item.label}} {{item.required?'*':'（选填）'}}</text><text wx:if="{{item.path==='bank_account_info.bank_branch_id'&&bankBranchGroupHint}}" class="hint">{{bankBranchGroupHint}}</text><picker wx:if="{{item.choices}}" range="{{item.choiceLabels}}" value="{{item.choiceIndex}}" data-index="{{item.index}}" bindchange="choice" disabled="{{pending||!canEditWechat}}"><view>{{item.choiceLabel}} ›</view></picker><text wx:elif="{{item.path==='business_info.sales_info.mini_program_info.mini_program_appid'}}" class="hint">{{platformAppidStatus}}，无需商家手填 AppID。</text><input wx:else type="text" inputmode="{{item.path==='contact_info.mobile_phone'?'tel':'text'}}" aria-label="{{item.label}}" value="{{item.value}}" data-path="{{item.path}}" bindinput="inputUnifiedField" bindfocus="focusUnifiedField" bindblur="blurUnifiedField" disabled="{{pending||!canEditWechat}}" maxlength="{{item.path==='contact_info.mobile_phone'?item.maxlength:512}}" placeholder="{{item.path==='contact_info.mobile_phone'?item.phoneHint:group.materials.length&&!group.photos?'识别后待核对 / 可手动填写':'请填写原申请资料'}}"/><text wx:if="{{item.ocrHint}}" class="hint">{{item.ocrHint}}</text><text wx:if="{{item.path==='contact_info.mobile_phone'}}" class="hint">11位数字联系电话，不含空格、+或-</text><text wx:if="{{item.path==='contact_info.mobile_phone'&&mobilePhoneError}}" class="field-error">{{mobilePhoneError}}</text></label><view wx:if="{{item.path==='bank_account_info.bank_account_type'}}"><text wx:if="{{group.accountTypePending}}" class="field-error">企业法人个人账户支持条件核实中，当前提交尚未接通</text><button class="primary bank-ocr-entry" data-kind="bank_card" bindtap="recognizeDocument" disabled="{{pending||!application||!application.materials.bank_card}}">银行卡识别</button><text class="hint">仅本地识别卡面印刷信息，需人工核对后保存；不验证账户归属，不上传微信媒体。</text><button class="primary bank-photo-entry" data-kind="bank_card" bindtap="upload" disabled="{{pending||!canEditPlatform}}">{{application.materials.bank_card?'更换银行卡照片':'上传银行卡照片'}}</button><view wx:if="{{materialPreviews.bank_card}}" class="material-preview-frame"><image class="material-preview" src="{{materialPreviews.bank_card}}" mode="aspectFit"/><view wx:if="{{uploadFeedback&&uploadFeedback.kind==='bank_card'}}" class="material-upload-overlay" aria-live="polite"><text class="material-upload-label">{{uploadFeedback.label}}</text></view><view wx:elif="{{ocrFeedback&&ocrFeedback.kind==='bank_card'}}" class="material-upload-overlay material-ocr-overlay" aria-live="polite"><text class="material-upload-label material-ocr-label">{{ocrFeedback.label}}</text></view></view><text wx:if="{{materialPreviewHints.bank_card}}" class="hint">{{materialPreviewHints.bank_card}}</text><text wx:if="{{application.materials.bank_card}}" class="material-state">银行卡照片已私密保存</text><view wx:if="{{group.personalAccount}}" class="confirmed-field"><text>账户名称</text><text class="readonly-account-name" style="color:#83958b">{{group.personalAccountName}}</text><text wx:if="{{group.personalAccountNameHint}}" class="hint">{{group.personalAccountNameHint}}</text><button class="text-link" data-step="0" data-group="legal" bindtap="returnMaterial" disabled="{{pending}}">返回第一步修改户名</button></view></view></block></view>
 <view wx:if="{{group.reuseHint && (step!==1 || group.conflictActions.length)}}" class="reuse-notice"><text class="hint">{{group.reuseHint}}</text><view wx:for="{{group.conflictActions}}" wx:key="targetPath" class="reuse-conflict"><text>{{item.label}}：原值 {{item.previousValue}}</text><text>第一步资料：{{item.sourceValue}}</text><button class="edit-group" data-target="{{item.targetPath}}" data-source="{{item.sourceValue}}" data-previous="{{item.previousValue}}" bindtap="startReuseConfirmation" disabled="{{pending||!canEditWechat}}">采用第一步资料</button><view wx:if="{{reuseConfirmation&&reuseConfirmation.target===item.targetPath}}"><text>确认将原值替换为 {{reuseConfirmation.source}}？修改后仍需保存。</text><button class="edit-group" bindtap="confirmReuse" disabled="{{pending||!canEditWechat}}">确认采用</button><button bindtap="cancelReuse">取消</button></view></view><button wx:if="{{step===0}}" class="edit-group" data-step="0" data-group="license" bindtap="returnMaterial" disabled="{{pending}}">返回第一步完善</button></view>
</view>
<view wx:if="{{step===3}}">
 <text class="hint">{{canEditPlatform?'平台申请资料可返回修改。':'平台申请当前只读；审核中的资料须由审核方退回补正后修改。'}}{{canEditWechat?'微信资料草稿可返回修改。':'微信资料当前只读；内部审核中的资料须退回补正后修改。'}}</text>
 <button class="edit-group" data-step="0" data-group="license" bindtap="returnMaterial" disabled="{{pending}}">修改资料</button>
 <view class="card"><text class="section-title">爱心捐赠比例</text><text>申请比例：{{requestedSplitLabel}}</text><text>审核生效比例：{{effectiveSplitLabel}}</text></view>
 <view class="card"><text class="section-title">爱心积分抵扣收款金额比例</text><text>爱心积分抵扣收款金额比例（申请值）：{{application&&application.redemption_percent?application.redemption_percent:0}}%</text></view>
 <view class="card" wx:for="{{displayReviewGroups}}" wx:key="id"><text class="section-title">{{item.title}}</text><text class="hint" wx:if="{{item.total}}">{{item.completed}} / {{item.total}} 项{{item.configuration?'微信结算配置已就绪':'资料已有内容（含自动获取及已上传证照）'}}；不代表已保存、实名校验或审核通过。</text><text class="hint" wx:else>本组当前无适用必填资料项。</text><text class="hint" wx:if="{{item.missingText}}">{{item.configuration?'进件配置待完成：':'尚未取得：'}}{{item.missingText}}</text><text class="hint" wx:if="{{item.pendingText}}">{{item.pendingText}}</text><text class="hint" wx:if="{{item.configuration}}">由平台核定微信结算配置，不要求您填写内部编号；配置未就绪前不会向微信提交。</text><button wx:if="{{!item.configuration}}" class="edit-group" data-step="{{item.step}}" data-group="{{item.id}}" bindtap="returnMaterial" disabled="{{pending}}">{{canEditWechat||canEditPlatform?'修改本组资料':'查看本组资料（当前只读）'}} ›</button></view>
 <view class="card"><text class="section-title">状态分别确认</text><text class="progress-state">平台审核：{{stateLabels[platformState]||'状态待核对'}}</text><text class="progress-state">微信资料内部审核：{{stateLabels[wechatReviewState]||'状态待核对'}}</text><text class="progress-state">微信认证与签约：{{stateLabels[wechatState]||'状态待核对'}}</text><text class="progress-state">工作台：{{stateLabels[openingState]||'状态待核对'}}</text><text class="hint">收款资格与审核状态分别核验，不能以上传成功作为开通证明。</text><button class="primary" bindtap="submitAllReview" disabled="{{pending||!ready||!application}}" loading="{{pending}}">提交审核</button><button wx:if="{{signUrl}}" bindtap="copySigning">复制微信官方认证/签约链接</button><text wx:else class="hint">尚未取得微信官方认证/签约指引，等待原申请服务端核验。</text><button bindtap="refreshApplication" disabled="{{pending||!ready||!application}}">刷新原申请进度</button><button wx:if="{{platformState==='APPROVED' && openingState==='OPENED'}}" bindtap="workbench">日常商家工作台</button><text wx:elif="{{platformState==='APPROVED'}}" class="hint">申请已通过，工作台尚未开通；请查看原申请进度。</text></view>
</view>
<button wx:if="{{step<3}}" class="primary save-next" bindtap="next" disabled="{{pending}}" loading="{{pending}}">{{ready?'保存草稿并继续下一项':'查看下一项资料要求'}}</button>
<button wx:if="{{ready&&step<3}}" class="text-link" bindtap="save" disabled="{{pending||(!canEditPlatform&&!canEditWechat)}}">保存同一份申请草稿，暂不离开</button><button wx:if="{{step>0}}" class="edit-group previous-step" bindtap="back" disabled="{{pending}}">返回上一步</button>

</block>
</view>
