<view class="page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="xj-nav"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view><button class="secondary" bindtap="goBack">‹ 返回</button><text class="title">商家入驻</text><text class="subtitle">本人申请 · 无需预先拥有门店</text><text class="description">{{status}}</text><view wx:if="{{!ready}}" class="card"><text class="section-title">微信登录后开始办理</text><text class="hint">首次使用按原身份服务注册；申请只属于本人。不会自动成为商家、关联门店或开通支付。</text><button class="primary" bindtap="connectApplicant" loading="{{pending}}" disabled="{{pending}}">{{pending?'正在验证身份':'微信登录 / 注册并开始入驻'}}</button></view><view wx:if="{{leavePrompt}}" class="card"><text>当前有未保存修改。</text><button bindtap="saveAndLeave" disabled="{{pending}}">保存并离开</button><button bindtap="cancelLeave" disabled="{{pending}}">继续填写</button></view><view class="card" wx:if="{{!application && applications.length}}"><text>继续本次原申请</text><button wx:for="{{applications}}" wx:key="application" data-application="{{item.application}}" bindtap="select">{{item.fields.store_name}} · {{item.status}}</button></view>
<text class="section-title">{{step+1}} / 4 · {{steps[step]}}</text>
<view wx:if="{{step===0}}" class="card"><picker range="{{['企业','个体工商户']}}" data-key="entity" bindchange="condition" disabled="{{pending||!canEditPlatform}}"><view>主体：{{options.entity==='ENTERPRISE'?'企业':'个体工商户'}} ›</view></picker><picker wx:if="{{options.entity==='ENTERPRISE'}}" range="{{['仅法人一人','1位其他受益人','2位其他受益人','3位其他受益人','4位其他受益人']}}" data-key="ubos" bindchange="condition" disabled="{{pending||!canEditPlatform}}"><view>其他受益人 {{options.ubos}} 位 ›</view></picker><picker wx:if="{{options.ubos>0}}" range="{{uboLabels}}" data-key="uboIndex" bindchange="condition" disabled="{{pending||!canEditPlatform}}"><view>编辑第 {{options.uboIndex+1}} 位受益人 ›</view></picker><picker range="{{['普通经营','餐饮食品']}}" data-key="category" bindchange="condition" disabled="{{pending||!canEditPlatform}}"><view>经营类别：{{options.category==='FOOD'?'餐饮食品':'普通经营'}} ›</view></picker></view>
<view wx:if="{{showLicenseUpload}}" class="card"><text class="section-title">营业执照资料</text><text class="hint">执照字段在本页填写。请先选择执照上传；OCR按需调用且默认关闭，未请求或当前不可用时字段仍须人工核对。原申请上传与微信审核是不同状态。</text><text>{{licenseMaterial?(licenseMaterial.uploaded?'原申请已上传':'原申请未上传'):(ready?'材料清单暂不可用，请重新连接':'登录后读取材料清单')}} · {{licenseMaterial?(licenseMaterial.synced?'已关联微信草稿':'未关联微信草稿'):''}}</text><button data-kind="business_license" bindtap="upload" disabled="{{pending||!canEditPlatform}}">{{licenseMaterial&&licenseMaterial.uploaded?'补充营业执照版本':'选择营业执照并保存到原申请'}}</button><text class="hint">识别：按需调用；上传本身不自动生成识别结果或自动回填，未请求/不可用时可继续人工输入并核对。</text><button wx:if="{{licenseMaterial&&licenseMaterial.uploaded}}" data-kind="business_license" bindtap="syncMaterial" disabled="{{pending}}">{{licenseMaterial.synced?'重新关联微信资料草稿':'关联到微信资料草稿'}}</button></view>
<view wx:if="{{step===0}}" class="card"><text>上传完成后核对门店名称、经营地址；OCR默认关闭并按需识别，未请求或不可用时不自动填写。</text><label>门店名称 *<input value="{{base.store_name}}" data-key="store_name" bindinput="baseInput" disabled="{{pending||!canEditPlatform}}" maxlength="120"/></label><label>经营地址 *<input value="{{base.address}}" data-key="address" bindinput="baseInput" disabled="{{pending||!canEditPlatform}}" maxlength="512"/></label></view><view wx:if="{{step===1}}" class="card"><picker range="{{['仅小程序','小程序及线下门店']}}" data-key="scene" bindchange="condition" disabled="{{pending||!canEditPlatform}}"><view>经营场景：{{options.scene==='mini'?'仅小程序':'小程序及线下门店'}} ›</view></picker></view>
<view wx:if="{{step===1 && options.scene==='both'}}" class="card"><text class="section-title">线下实际经营场景照片</text><text class="hint">门头、店内环境是本场景必需；收银台照为选填补充。本版各框最多1张，并非微信官方张数限制。支持PDF、PNG、JPEG，单份最多5MB。</text><view wx:for="{{scenePhotoCards}}" wx:key="id" class="scene-photo-card"><text>{{item.title}} {{item.required?'*':'（选填）'}} · {{item.uploaded?'1/1':'0/1'}} · {{item.synced?'已关联微信资料草稿':item.uploaded?'原申请已上传':'未上传'}}</text><text>人工审核：{{item.review}}</text><button wx:if="{{item.connected}}" data-kind="{{item.id}}" bindtap="upload" disabled="{{pending||!canEditPlatform}}">{{item.uploaded?'替换本框照片':'选择并上传照片'}}</button><button wx:if="{{item.connected && item.uploaded}}" data-kind="{{item.id}}" bindtap="syncMaterial" disabled="{{pending||!canEditWechat}}">关联微信资料草稿</button><button wx:if="{{item.connected && item.synced && item.id!=='cashier_photo'}}" data-kind="{{item.id}}" bindtap="removeScenePhoto" disabled="{{pending||!canEditWechat}}">移除草稿关联（原上传保留）</button><button wx:if="{{item.id==='cashier_photo' && item.uploaded}}" bindtap="removeCashierPhoto" disabled="{{pending||!canEditPlatform}}">移除本次收银台材料（历史保留）</button><text wx:if="{{item.id==='cashier_photo'}}" class="hint">选填材料；原申请上传与微信资料草稿关联分开。微信媒体通道关闭时仍可保存原申请，不能显示已关联。addition_info.business_addition_pics与其他补充共最多5项。</text><text wx:if="{{!item.connected}}" class="hint">原申请材料目录尚未提供此项，不能上传。</text><text class="hint">场景照片无需OCR；仅查看上传、替换及审核状态，不执行识别或自动回填。</text></view></view>
<view wx:if="{{step===1 && miniSceneMaterials.length}}" class="card"><text>小程序服务截图（与线下照片分开）</text><view wx:for="{{miniSceneMaterials}}" wx:key="id"><text>{{item.title}} · {{item.uploaded?'1/1':'0/1'}}</text><button data-kind="{{item.id}}" bindtap="upload" disabled="{{pending||!canEditPlatform}}">{{item.uploaded?'替换截图':'选择并上传截图'}}</button><button wx:if="{{item.uploaded}}" data-kind="{{item.id}}" bindtap="syncMaterial" disabled="{{pending||!canEditWechat}}">关联微信资料草稿</button></view><text>mini_program_pics官方最多5张；本版每次选择1张，不代表可覆盖原列表。</text></view>
<view wx:for="{{documentGroups}}" wx:for-item="group" wx:key="path" class="card"><text class="section-title">{{group.title}}</text><picker range="{{group.labels}}" data-path="{{group.path}}" bindchange="selectDocumentType" disabled="{{pending||!canEditWechat}}"><view>证件类型：{{group.label}} ›</view></picker><text class="hint">先选择证件类型，再上传下方对应材料，最后核对资料。境外护照不要求背面。</text><view wx:for="{{group.materials}}" wx:key="id" class="material-slot"><text>{{item.title}} · {{item.uploaded?'已上传至本人申请':'尚未上传'}}</text><button data-kind="{{item.id}}" bindtap="upload" disabled="{{pending||!canEditPlatform}}">{{item.uploaded?'补充材料版本':'选择并上传'}}{{item.title}}</button><button wx:if="{{item.uploaded}}" data-kind="{{item.id}}" bindtap="syncMaterial" disabled="{{pending||!canEditWechat}}">关联到微信资料草稿</button></view><text wx:if="{{!group.materials.length}}" class="hint">登录后读取原材料目录；当前未上传任何文件。</text><text class="hint">上传不等于审核通过；识别建议需人工核对，不能自动覆盖资料。</text></view>
<view class="card" wx:if="{{step<3}}"><text wx:if="{{fields.length}}" class="hint">第{{fieldCursor+1}}项 / 共{{fields.length}}项</text><label wx:for="{{fields}}" wx:key="path" wx:if="{{index===fieldCursor||(index===fieldCursor+1&&fields[fieldCursor].path==='bank_account_info.bank_branch_id'&&item.path==='bank_account_info.bank_name')}}"><text wx:if="{{item.path==='bank_account_info.bank_branch_id'&&bankBranchGroupHint}}" class="hint" style="display:block;">{{bankBranchGroupHint}}</text>{{item.label}} {{item.required?'*':'（选填）'}}<picker wx:if="{{item.choices}}" range="{{item.choices}}" data-index="{{index}}" bindchange="choice" disabled="{{pending||!canEditWechat}}"><view>{{item.value || '请选择'}} ›</view></picker><input wx:else type="text" value="{{item.value}}" data-path="{{item.path}}" bindinput="input" bindblur="blur" disabled="{{pending||!canEditWechat}}" maxlength="{{item.path==='contact_info.mobile_phone'?item.maxlength:512}}" placeholder="{{item.path==='contact_info.mobile_phone'?item.phoneHint:'请输入'}}"/><text wx:if="{{item.path==='contact_info.mobile_phone'}}" class="hint">5–20位，可含数字、+或-，不含空格</text><text wx:if="{{item.path==='contact_info.mobile_phone'&&mobilePhoneError}}" class="field-error" style="color:#b42318;font-size:24rpx;line-height:1.5;display:block;">{{mobilePhoneError}}</text></label></view>
<view wx:if="{{step===2}}" class="card"><text>原申请材料</text><view wx:for="{{materials}}" wx:key="id" wx:if="{{index===materialCursor}}"><text>{{item.title}} {{item.required?'*':'（选填）'}} · {{item.uploaded?'原申请已上传':'原申请未上传'}} · {{item.synced?'已关联微信草稿':item.uploaded?'待关联微信草稿':'未上传至原申请'}} · {{item.review}}</text><button wx:if="{{application}}" data-kind="{{item.id}}" bindtap="upload" disabled="{{pending||!canEditPlatform}}">{{item.uploaded?'补充新版本':'选择并上传至原申请'}}</button><button wx:if="{{item.uploaded}}" data-kind="{{item.id}}" bindtap="syncMaterial" disabled="{{pending}}">{{item.synced?'重新关联微信资料草稿':'关联到微信资料草稿'}}</button></view><button wx:if="{{materialCursor>0}}" bindtap="previousMaterial" disabled="{{pending}}">上一项材料</button><button wx:if="{{materialCursor+1<materials.length}}" bindtap="nextMaterial" disabled="{{pending}}">下一项材料</button><text class="hint">上传至本次原申请。仅微信主体与经营场景必要材料标*；历史版本保留。</text></view>
<view wx:if="{{step===3}}" class="card"><text>平台审核：{{platformState}}</text><text>微信认证与签约：{{wechatState}}</text><text>工作台：{{openingState}}</text><text>收款码：待真实资格及取得链核验</text><button bindtap="submitWechatReview" disabled="{{pending||!ready||!application}}">提交微信资料内部审核</button><button wx:if="{{signUrl}}" bindtap="copySigning">复制微信官方认证/签约链接</button><text wx:else>尚未取得微信官方认证/签约指引，等待原申请服务端核验。</text><button bindtap="submit" disabled="{{pending||!canEditPlatform||!application}}">提交平台审核</button><button bindtap="refreshApplication" disabled="{{pending||!ready||!application}}">刷新原申请进度</button><button bindtap="workbench">日常商家工作台</button></view>
<button wx:if="{{fieldCursor>0}}" bindtap="previousField" disabled="{{pending}}">上一项资料</button><button wx:if="{{fieldCursor+1<fields.length}}" bindtap="nextField" disabled="{{pending}}">下一项资料</button><button bindtap="save" disabled="{{pending||(!canEditPlatform&&!canEditWechat)}}" loading="{{pending}}">保存同一份申请草稿</button><button wx:if="{{step<3}}" bindtap="next" disabled="{{pending}}">{{ready?'保存并下一步':'查看下一步资料要求'}}</button><button wx:if="{{step>0}}" bindtap="back" disabled="{{pending}}">上一步</button><text class="hint">本次候选不自动提交微信或发起支付；审核与支付资格分别核验。</text></view>

<view class="card" wx:if="{{application}}">
 <text>证照识别建议（需人工核对）</text><text>{{ocrStatus}}</text>
 <button data-kind="business_license" bindtap="recognizeDocument" disabled="{{pending}}">识别已上传营业执照</button>
 <button wx:if="{{options.doc==='IDENTIFICATION_TYPE_IDCARD'}}" data-kind="id_front" bindtap="recognizeDocument" disabled="{{pending}}">识别已上传身份证正面</button>
 <view wx:for="{{ocrRows}}" wx:key="key"><text>{{item.label}}</text><input value="{{item.value}}" data-key="{{item.key}}" bindinput="editOcrSuggestion" /></view>
 <button wx:if="{{ocrJob}}" bindtap="readOcr" disabled="{{pending}}">读取当前识别建议</button>
 <button wx:if="{{ocrRows.length}}" bindtap="confirmOcr" disabled="{{pending}}">我已核对，留存人工确认</button>
 <text>门头照、店内环境照、收银台照不做OCR。识别不证明证件真实或审核通过；不自动覆盖申请字段。</text>
</view>
