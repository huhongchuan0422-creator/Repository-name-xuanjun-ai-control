<view class="page"><text class="title">商家入驻</text><text class="description">{{status}}</text><view class="card" wx:if="{{!application && applications.length}}"><text>继续本次原申请</text><button wx:for="{{applications}}" wx:key="application" data-application="{{item.application}}" bindtap="select">{{item.fields.store_name}} · {{item.status}}</button></view>
<text class="section-title">{{step+1}} / 4 · {{steps[step]}}</text>
<view wx:if="{{step===0}}" class="card"><picker range="{{['企业','个体工商户']}}" data-key="entity" bindchange="condition" disabled="{{pending||!canEditPlatform}}"><view>主体：{{options.entity==='ENTERPRISE'?'企业':'个体工商户'}} ›</view></picker><picker wx:if="{{options.entity==='ENTERPRISE'}}" range="{{['仅法人一人','1位其他受益人','2位其他受益人','3位其他受益人','4位其他受益人']}}" data-key="ubos" bindchange="condition"><view>其他受益人 {{options.ubos}} 位 ›</view></picker><picker wx:if="{{options.ubos>0}}" range="{{uboLabels}}" data-key="uboIndex" bindchange="condition"><view>编辑第 {{options.uboIndex+1}} 位受益人 ›</view></picker><picker range="{{['普通经营','餐饮食品']}}" data-key="category" bindchange="condition" disabled="{{pending||!canEditPlatform}}"><view>经营类别：{{options.category==='FOOD'?'餐饮食品':'普通经营'}} ›</view></picker><label>门店名称 *<input value="{{base.store_name}}" data-key="store_name" bindinput="baseInput" disabled="{{pending||!canEditPlatform}}" maxlength="120"/></label><label>经营地址 *<input value="{{base.address}}" data-key="address" bindinput="baseInput" disabled="{{pending||!canEditPlatform}}" maxlength="512"/></label></view>
<view wx:if="{{step===1}}" class="card"><picker range="{{['仅小程序','小程序及线下门店']}}" data-key="scene" bindchange="condition" disabled="{{pending}}"><view>经营场景：{{options.scene==='mini'?'仅小程序':'小程序及线下门店'}} ›</view></picker></view>
<view class="card" wx:if="{{step<3}}"><label wx:for="{{fields}}" wx:key="path"><text wx:if="{{item.path==='bank_account_info.bank_branch_id'&&bankBranchGroupHint}}" class="hint" style="display:block;">{{bankBranchGroupHint}}</text>{{item.label}} {{item.required?'*':'（选填）'}}<picker wx:if="{{item.choices}}" range="{{item.choices}}" data-index="{{index}}" bindchange="choice" disabled="{{pending||!canEditWechat}}"><view>{{item.value || '请选择'}} ›</view></picker><input wx:else type="text" value="{{item.value}}" data-path="{{item.path}}" bindinput="input" bindblur="blur" disabled="{{pending||!canEditWechat}}" maxlength="{{item.path==='contact_info.mobile_phone'?item.maxlength:512}}" placeholder="{{item.path==='contact_info.mobile_phone'?item.phoneHint:'请输入'}}"/><text wx:if="{{item.path==='contact_info.mobile_phone'}}" class="hint">5–20位，可含数字、+或-，不含空格</text><text wx:if="{{item.path==='contact_info.mobile_phone'&&mobilePhoneError}}" class="field-error" style="color:#b42318;font-size:24rpx;line-height:1.5;display:block;">{{mobilePhoneError}}</text></label></view>
<view wx:if="{{step===2}}" class="card"><text>原申请材料</text><view wx:for="{{materials}}" wx:key="id"><text>{{item.title}} {{item.required?'*':'（选填）'}} · {{item.review}}</text><button wx:if="{{application}}" data-kind="{{item.id}}" bindtap="upload" disabled="{{pending||!canEditPlatform}}">{{item.uploaded?'补充新版本':'选择并上传'}}</button><button wx:if="{{item.uploaded}}" data-kind="{{item.id}}" bindtap="syncMaterial" disabled="{{pending}}">同步原材料至微信</button></view><text class="hint">上传至本次原申请。仅微信主体与经营场景必要材料标*；历史版本保留。</text></view>
<view wx:if="{{step===3}}" class="card"><text>平台审核：{{platformState}}</text><text>微信认证与签约：{{wechatState}}</text><text>工作台：{{openingState}}</text><text>收款码：待真实资格及取得链核验</text><button bindtap="submitWechatReview" disabled="{{pending}}">提交微信资料内部审核</button><button wx:if="{{signUrl}}" bindtap="copySigning">复制微信官方认证/签约链接</button><text wx:else>尚未取得微信官方认证/签约指引，等待原申请服务端核验。</text><button bindtap="submit" disabled="{{pending||!canEditPlatform}}">提交平台审核</button><button bindtap="refreshApplication" disabled="{{pending}}">刷新原申请进度</button><button bindtap="workbench">日常商家工作台</button></view>
<button bindtap="save" disabled="{{pending||(!canEditPlatform&&!canEditWechat)}}" loading="{{pending}}">保存同一份申请草稿</button><button wx:if="{{step<3}}" bindtap="next" disabled="{{pending}}">保存并下一步</button><button wx:if="{{step>0}}" bindtap="back" disabled="{{pending}}">上一步</button><text class="hint">本次候选不自动提交微信或发起支付；审核与支付资格分别核验。</text></view>
