<view class="onboarding-header"><text>邻里生活 · 商家入驻</text><text class="header-note">同一份微信申请资料 · 先上传，再核对</text></view>
<view class="page onboarding-page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="xj-nav"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view>
<button class="back-link" bindtap="goBack">‹ 返回同一申请</button>
<text class="title">{{steps[step]}}</text><text class="subtitle">{{step===0?'先选类型 → 上传材料 → 核对识别结果':step===1?'确认实际经营 → 选择材料 → 填写经营资料':step===2?'原结算规则 → 核对账户资料':'分别核对上传、平台审核与微信进度'}}</text>
<view class="status-notice" wx:if="{{status}}" aria-live="polite">{{status}}</view>
<view wx:if="{{!ready}}" class="card"><text class="section-title">微信登录后开始办理</text><text class="hint">无需已有门店账号。仅保存本人的申请，不自动关联门店、赋予商家权限或开通支付。</text><button class="primary" bindtap="connectApplicant" loading="{{pending}}" disabled="{{pending}}">{{pending?'正在验证身份':'微信登录 / 注册并开始入驻'}}</button></view>
<view wx:if="{{leavePrompt}}" class="card"><text>当前有未保存修改。</text><button class="primary" bindtap="saveAndLeave" disabled="{{pending}}">保存并离开</button><button bindtap="cancelLeave" disabled="{{pending}}">继续填写</button></view>
<view class="card" wx:if="{{!application && applications.length}}"><text class="section-title">继续本人的原申请</text><button wx:for="{{applications}}" wx:key="application" data-application="{{item.application}}" bindtap="select">{{item.fields.store_name||'未填写商户名称'}} · {{stateLabels[item.status]||'状态待核对'}}</button></view>
<view wx:for="{{materialGroups}}" wx:for-item="group" wx:key="id" id="material-{{group.id}}" class="card material-group">
 <text class="section-title">{{group.title}}</text><button wx:if="{{group.optional}}" class="text-link" bindtap="toggleOptional">{{showOptionalMaterials?'收起原选填补充':'展开原选填补充（非必填）'}}</button>
 <picker wx:if="{{group.condition}}" range="{{group.conditionLabels}}" value="{{group.conditionValue}}" data-key="{{group.condition}}" bindchange="condition" disabled="{{pending||!canEditPlatform}}"><view>{{group.conditionLabel}} ›</view></picker>
 <picker wx:if="{{group.docPath}}" range="{{group.docLabels}}" value="{{group.docValue}}" data-path="{{group.docPath}}" bindchange="selectDocumentType" disabled="{{pending||!canEditWechat}}"><view>证件类型 * · {{group.docLabel}} ›</view></picker>
 <text wx:if="{{!ready&&group.materials.length}}" class="hint">登录后读取材料清单</text><view wx:for="{{group.materials}}" wx:if="{{!group.optional||showOptionalMaterials}}" wx:key="id" class="upload-slot">
  <button class="upload-choice" data-kind="{{item.id}}" bindtap="upload" disabled="{{pending||!canEditPlatform||!item.connected}}"><text class="upload-title">＋ {{item.title}} {{item.required?'*':''}}</text><text>{{item.uploaded?'更换材料 / 补充新版本':'选择材料 / 文件'}}</text><text class="upload-help">{{group.photos?'本框1张，可更换；不做文字识别':'文件要求以原材料说明为准'}}</text></button>
  <text class="material-state">{{item.uploaded?'原申请已上传':'未选择材料'}} · {{item.synced?'已关联微信草稿':'未关联微信草稿'}}{{item.uploaded?' · 审核：'+(stateLabels[item.review]||'状态待核对'):''}}</text>
  <button wx:if="{{item.uploaded}}" class="text-link" data-kind="{{item.id}}" bindtap="syncMaterial" disabled="{{pending||!canEditWechat}}">{{item.synced?'重新关联当前材料':'关联当前微信资料草稿'}}</button>
  <button wx:if="{{group.photos&&item.synced&&item.id!=='cashier_photo'}}" class="text-link" data-kind="{{item.id}}" bindtap="removeScenePhoto" disabled="{{pending||!canEditWechat}}">移除草稿关联（原上传保留）</button>
  <button wx:if="{{item.id==='cashier_photo'&&item.uploaded}}" class="text-link" bindtap="removeCashierPhoto" disabled="{{pending||!canEditPlatform}}">移除本次收银台材料（历史保留）</button>
 </view>
 <view wx:if="{{group.ocrKind&&application}}" class="group-recognition">
  <button class="text-link" data-kind="{{group.ocrKind}}" bindtap="recognizeDocument" disabled="{{pending}}">识别本组已上传证照</button>
  <view wx:if="{{ocrKind===group.ocrKind}}"><text class="hint" aria-live="polite">{{ocrStatus}}</text><view wx:for="{{ocrRows}}" wx:key="key"><label>{{item.label}}<input value="{{item.value}}" data-key="{{item.key}}" bindinput="editOcrSuggestion" disabled="{{pending}}" /></label></view><button wx:if="{{ocrJob}}" class="text-link" bindtap="readOcr" disabled="{{pending}}">读取本组识别状态</button><button wx:if="{{ocrRows.length}}" bindtap="confirmOcr" disabled="{{pending}}">我已核对，留存人工确认</button><button wx:if="{{ocrConfirmed}}" bindtap="fillOcrDraft" disabled="{{pending||!canEditWechat}}">把已核对资料填入空白项并保存</button></view>
  <text wx:else class="hint">尚未请求识别。识别结果需人工核对，不自动覆盖已填写资料。</text>
 </view>
 <text wx:if="{{group.fields.length}}" class="fields-heading">{{group.materials.length?(group.photos?'经营资料自行填写，可修改':'上传后核对资料，可修改'):'核对资料，可修改'}}</text>
 <view class="fields" wx:if="{{group.fields.length}}"><label wx:for="{{group.fields}}" wx:key="path"><text>{{item.label}} {{item.required?'*':'（选填）'}}</text><text wx:if="{{item.path==='bank_account_info.bank_branch_id'&&bankBranchGroupHint}}" class="hint">{{bankBranchGroupHint}}</text><picker wx:if="{{item.choices}}" range="{{item.choiceLabels}}" value="{{item.choiceIndex}}" data-index="{{item.index}}" bindchange="choice" disabled="{{pending||!canEditWechat}}"><view>{{item.choiceLabel}} ›</view></picker><input wx:else type="text" value="{{item.value}}" data-path="{{item.path}}" bindinput="input" bindblur="blur" disabled="{{pending||!canEditWechat}}" maxlength="{{item.path==='contact_info.mobile_phone'?item.maxlength:512}}" placeholder="{{item.path==='contact_info.mobile_phone'?item.phoneHint:group.materials.length&&!group.photos?'识别后待核对 / 可手动填写':'请填写原申请资料'}}"/><text wx:if="{{item.path==='contact_info.mobile_phone'}}" class="hint">5–20位，可含数字、+或-，不含空格</text><text wx:if="{{item.path==='contact_info.mobile_phone'&&mobilePhoneError}}" class="field-error">{{mobilePhoneError}}</text></label></view>
 <text wx:if="{{group.note}}" class="hint">{{group.note}}</text><text wx:if="{{group.docPath}}" class="hint">境外护照不要求反面；其他证件按原材料规则。上传和识别不代表审核通过。</text>
</view>
<view wx:if="{{step===3}}">
 <view class="card" wx:for="{{reviewGroups}}" wx:key="id"><text class="section-title">{{item.title}}</text><text class="hint">{{item.uploaded}} / {{item.materialCount}} 项原申请材料已上传；字段与识别结果须分别核对。</text><button class="text-link" data-step="{{item.step}}" data-group="{{item.id}}" bindtap="returnMaterial">返回本材料组核对 ›</button></view>
 <view class="card"><text class="section-title">状态分别确认</text><text class="progress-state">平台审核：{{stateLabels[platformState]||'状态待核对'}}</text><text class="progress-state">微信认证与签约：{{stateLabels[wechatState]||'状态待核对'}}</text><text class="progress-state">工作台：{{stateLabels[openingState]||'状态待核对'}}</text><text class="hint">收款资格与审核状态分别核验，不能以上传成功作为开通证明。</text><button bindtap="submitWechatReview" disabled="{{pending||!ready||!application}}">提交微信资料内部审核</button><button wx:if="{{signUrl}}" bindtap="copySigning">复制微信官方认证/签约链接</button><text wx:else class="hint">尚未取得微信官方认证/签约指引，等待原申请服务端核验。</text><button bindtap="submit" disabled="{{pending||!canEditPlatform||!application}}">提交平台审核</button><button bindtap="refreshApplication" disabled="{{pending||!ready||!application}}">刷新原申请进度</button><button bindtap="workbench">日常商家工作台</button></view>
</view>
<button wx:if="{{step<3}}" class="primary save-next" bindtap="next" disabled="{{pending}}" loading="{{pending}}">{{ready?'保存草稿并继续下一项':'查看下一项资料要求'}}</button>
<button wx:if="{{ready&&step<3}}" class="text-link" bindtap="save" disabled="{{pending||(!canEditPlatform&&!canEditWechat)}}">保存同一份申请草稿，暂不离开</button><button wx:if="{{step>0}}" class="text-link" bindtap="back" disabled="{{pending}}">‹ 上一阶段</button>
<text class="hint">资料未齐可先保存草稿，以原接口校验为准；失败保留输入、不前进。门头、店内环境、收银台照片不做OCR。</text><text class="hint">本页不自动提交微信，不发起支付；识别不是证件真实性或审核通过的证明。</text>
</view>