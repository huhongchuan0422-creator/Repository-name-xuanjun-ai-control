<view class="page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="xj-nav" style="position:fixed;left:0;right:0;bottom:0;z-index:999;display:flex;gap:8rpx;padding:12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;border-top:1rpx solid #e5e7eb;box-shadow:0 -4rpx 18rpx rgba(15,23,42,.08);"><button style="{{activeSection==='home'?'flex:1;font-size:24rpx;line-height:1.5;background:#172554;color:#fff;border-radius:12rpx;':'flex:1;font-size:24rpx;line-height:1.5;background:#f3f4f6;color:#1f2937;border-radius:12rpx;'}}" data-section="home" bindtap="navigateSection">首页</button><button style="{{activeSection==='recommendations'?'flex:1;font-size:24rpx;line-height:1.5;background:#172554;color:#fff;border-radius:12rpx;':'flex:1;font-size:24rpx;line-height:1.5;background:#f3f4f6;color:#1f2937;border-radius:12rpx;'}}" data-section="recommendations" bindtap="navigateSection">推荐</button><button style="{{activeSection==='orders'?'flex:1;font-size:24rpx;line-height:1.5;background:#172554;color:#fff;border-radius:12rpx;':'flex:1;font-size:24rpx;line-height:1.5;background:#f3f4f6;color:#1f2937;border-radius:12rpx;'}}" data-section="orders" bindtap="navigateSection">订单</button><button style="{{activeSection==='profile'?'flex:1;font-size:24rpx;line-height:1.5;background:#172554;color:#fff;border-radius:12rpx;':'flex:1;font-size:24rpx;line-height:1.5;background:#f3f4f6;color:#1f2937;border-radius:12rpx;'}}" data-section="profile" bindtap="navigateSection">我的</button></view>
  <view class="hero"><text class="eyebrow">MY ACCOUNT</text><text class="title">个人资料</text><text class="subtitle">管理你的昵称与联系方式</text></view>
  <view class="card"><text class="description">{{status}}</text><button bindtap="openJoin">商家入驻与进度</button><button bindtap="openMerchant">商家工作台</button><button bindtap="openOrders">门店与订单</button>
  <button class="primary" wx:if="{{!authenticated}}" bindtap="retryLogin" loading="{{pending}}" disabled="{{pending}}">重新登录</button></view>
  <view class="card" wx:if="{{authenticated&&loaded}}">
    <text>客户编号：{{customerId}}</text>
    <text class="hint">昵称</text><input value="{{nickname}}" placeholder="填写昵称" data-field="nickname" bindinput="input"/>
    <text class="hint">联系方式</text><input value="{{contact}}" placeholder="填写联系方式" data-field="contact" bindinput="input"/>
    <button class="primary" bindtap="save" loading="{{pending}}" disabled="{{pending}}">保存资料</button>
    <button bindtap="logout" disabled="{{pending}}">退出登录</button>
  </view>
  <view class="card" wx:if="{{authenticated&&loaded}}">
    <view class="row"><text class="title">本人通知</text><button size="mini" bindtap="loadNotices" loading="{{noticePending}}" disabled="{{noticePending}}">刷新</button></view>
    <text class="description">{{noticeStatus}}</text>
    <text wx:if="{{!noticesLoaded&&!noticePending}}">尚未读取本人通知。</text>
    <view wx:for="{{notices}}" wx:key="id" class="notice-row"><text>{{item.read?'已读':'未读'}} · {{item.message}}</text><button wx:if="{{!item.read}}" size="mini" data-id="{{item.id}}" bindtap="markNoticeRead" disabled="{{noticePending}}">标记已读</button></view>
    <text wx:if="{{noticesLoaded&&!notices.length}}">暂无本人通知。</text>
    <button wx:if="{{noticesMore}}" bindtap="loadNotices" data-more="true" disabled="{{noticePending}}">加载更多通知</button>
  </view>
</view>
