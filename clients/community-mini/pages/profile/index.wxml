<view class="page consumer-page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="xj-nav"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view>
<view wx:if="{{pageMode==='profile'}}">
<view class="profile-hero"><view class="profile-avatar">我</view><view><text class="title">个人中心</text><text class="subtitle">您的资料、服务与商家身份</text></view></view>
<view class="card entry-group"><button class="service-link" bindtap="showProfile"><text class="entry-icon">○</text><view><text class="entry-title">个人资料</text><text class="entry-hint">昵称与联系方式</text></view><text class="entry-chevron">›</text></button><button class="service-link" bindtap="openOrders"><text class="entry-icon">▤</text><view><text class="entry-title">我的订单</text><text class="entry-hint">查看原订单与服务记录</text></view><text class="entry-chevron">›</text></button><button class="service-link" bindtap="showNotices"><text class="entry-icon">◉</text><view><text class="entry-title">我的通知</text><text class="entry-hint">消息详情与已读状态</text></view><text class="entry-chevron">›</text></button></view>
<view class="card merchant-entry-card"><button class="service-link highlighted-link" bindtap="openMerchantEntry" loading="{{merchantEntryPending}}" disabled="{{merchantEntryPending}}"><text class="entry-icon">⌂</text><view><text class="entry-title">{{merchantEntryLabel}}</text><text class="entry-hint">{{merchantEntryHint}}</text></view><text class="entry-chevron">›</text></button></view>
<view class="card entry-group"><button class="service-link" data-section="services" bindtap="navigateSection"><text class="entry-icon">◇</text><view><text class="entry-title">社区与更多服务</text><text class="entry-hint">归属、推荐、退款与支付恢复</text></view><text class="entry-chevron">›</text></button><button class="service-link" bindtap="openPrivacy"><text class="entry-icon">□</text><view><text class="entry-title">隐私保护指引</text><text class="entry-hint">正式小程序隐私保护说明</text></view><text class="entry-chevron">›</text></button></view>
<button class="text-link" bindtap="showAccount">登录与账户状态</button><text class="hint">{{privacyStatus}}</text><text class="hint">客服：当前项目未发现可使用现有入口，暂不可用。</text>
</view>
<view wx:else class="page-heading"><button class="text-link" bindtap="backProfile">‹ 返回个人中心</button><text class="title">{{pageMode==='profile-edit'?'个人资料':pageMode==='notices'?'我的通知':'登录与账户状态'}}</text><text class="subtitle">{{pageMode==='profile-edit'?'昵称与联系方式':pageMode==='notices'?'每一条消息，都有清楚的来处与下一步。':'账户状态以微信身份核验为准'}}</text></view>
<view class="card" id="account-details" wx:if="{{pageMode==='account'||pageMode==='profile-edit'}}"><text class="description" aria-live="polite">{{status}}</text><button class="primary" wx:if="{{!authenticated}}" bindtap="retryLogin" loading="{{pending}}" disabled="{{pending}}">微信登录 / 注册</button><text wx:if="{{needsScene}}" class="hint">尚未选择门店；个人资料和订单仅按选定门店下的本人权限读取。商家入驻无需预先拥有门店。</text><button wx:if="{{needsScene}}" class="text-link" bindtap="scanStore">扫码进入门店</button><button wx:if="{{authenticated&&!loaded}}" class="text-link" bindtap="logout" disabled="{{pending}}">退出登录</button></view>
<view class="card" wx:if="{{pageMode==='profile-edit'&&authenticated&&loaded}}">
    <text>客户编号：{{customerId}}</text>
    <text class="hint">昵称</text><input value="{{nickname}}" placeholder="填写昵称" data-field="nickname" bindinput="input"/>
    <text class="hint">联系方式</text><input value="{{contact}}" placeholder="填写联系方式" data-field="contact" bindinput="input"/>
    <button class="primary" bindtap="save" loading="{{pending}}" disabled="{{pending}}">保存资料</button>
    <button bindtap="logout" disabled="{{pending}}">退出登录</button>
  </view>
  <view class="card" id="account-notices" wx:if="{{pageMode==='notices'&&authenticated&&loaded}}">
    <view class="row"><text class="title">本人通知</text><button size="mini" bindtap="loadNotices" loading="{{noticePending}}" disabled="{{noticePending||noticeDetailOpen}}">刷新</button></view>
    <text class="description">{{noticeStatus}}</text>
    <view wx:if="{{!noticeDetailOpen}}">
      <text wx:if="{{!noticesLoaded&&!noticePending}}">尚未读取本人通知。</text>
      <view wx:for="{{notices}}" wx:key="id" class="notice-row"><text>{{item.read?'已读':'未读'}} · {{item.message}}</text><button size="mini" data-id="{{item.id}}" bindtap="openNotice" disabled="{{noticePending}}">查看详情</button></view>
      <text wx:if="{{noticesLoaded&&!notices.length}}">暂无本人通知。</text>
      <button wx:if="{{noticesMore}}" bindtap="loadNotices" data-more="true" disabled="{{noticePending}}">加载更多通知</button>
    </view>
    <view wx:if="{{noticeDetailOpen&&selectedNotice}}">
      <button size="mini" bindtap="backNoticeList" disabled="{{noticePending}}">返回通知列表</button>
      <text>通知详情 · {{selectedNotice.read?'已读':'未读'}}</text><text>{{selectedNotice.message}}</text>
      <button wx:if="{{!selectedNotice.read}}" data-id="{{selectedNotice.id}}" bindtap="markNoticeRead" loading="{{noticePending}}" disabled="{{noticePending}}">标记已读</button>
    </view>
  </view>
<view class="card" wx:if="{{pageMode==='account'&&authenticated}}">
  <text class="title">确认网页登录 · 已获授权审核员</text>
  <text class="hint">仅登录本人正在使用的原后台浏览器，不授予审核角色。不要确认他人发来的请求。</text>
  <input value="{{reviewerScene}}" placeholder="原门店场景编号" data-field="reviewerScene" bindinput="reviewerInput" maxlength="32"/>
  <input value="{{reviewerChallenge}}" placeholder="粘贴本人浏览器显示的登录请求" data-field="reviewerChallenge" bindinput="reviewerInput" maxlength="128"/>
  <button bindtap="reviewerDescribe" loading="{{reviewerPending}}" disabled="{{reviewerPending}}">核对网页登录请求</button>
  <view wx:if="{{reviewerDescription}}"><text>网址：{{reviewerDescription.origin}}</text><text>项目：{{reviewerDescription.project}}</text><text selectable="true">浏览器校验码：{{reviewerDescription.verification}}</text><button bindtap="reviewerConfirm" disabled="{{reviewerPending}}">校验码一致，确认本人浏览器</button></view>
  <button bindtap="reviewerCancel">关闭本次确认</button><text>{{reviewerStatus}}</text>
</view>
</view>
