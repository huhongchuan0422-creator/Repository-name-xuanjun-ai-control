<view class="page consumer-page" style="padding-bottom:180rpx;box-sizing:border-box;">
  <view class="xj-nav">
    <button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button>
    <button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button>
    <button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button>
    <button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button>
  </view>
  <view wx:if="{{pageMode==='profile'}}">
    <view class="profile-hero"><view class="profile-avatar">我</view><view><text class="title">我的</text><text class="subtitle">个人资料、订单与常用服务</text></view></view>
    <view class="card entry-group">
      <button class="service-link" bindtap="showProfile"><text class="entry-icon">○</text><view><text class="entry-title">个人资料</text><text class="entry-hint">查看和修改昵称、联系方式</text></view><text class="entry-chevron">›</text></button>
      <button class="service-link" bindtap="openOrders"><text class="entry-icon">▤</text><view><text class="entry-title">我的订单</text><text class="entry-hint">查看订单进度与售后</text></view><text class="entry-chevron">›</text></button>
      <button class="service-link" bindtap="showNotices"><text class="entry-icon">◉</text><view><text class="entry-title">我的通知</text><text class="entry-hint">查看最新消息</text></view><text class="entry-chevron">›</text></button>
    </view>
    <view class="card merchant-entry-card"><button class="service-link highlighted-link" bindtap="openMerchantEntry"><text class="entry-icon">⌂</text><view><text class="entry-title">{{merchantEntryLabel}}</text><text class="entry-hint">{{merchantEntryHint}}</text></view><text class="entry-chevron">›</text></button></view>
    <view class="card entry-group"><button class="service-link" data-section="services" bindtap="navigateSection"><text class="entry-icon">◇</text><view><text class="entry-title">我的服务</text><text class="entry-hint">社区归属、推荐关系与售后服务</text></view><text class="entry-chevron">›</text></button></view>
  </view>
  <view wx:else>
    <view class="page-heading"><button class="text-link" bindtap="backProfile">‹ 返回我的</button><text class="title">{{pageMode==='profile-edit'?'个人资料':'我的通知'}}</text><text class="subtitle">{{pageMode==='profile-edit'?'查看和修改昵称、联系方式':'查看与您有关的消息'}}</text></view>
    <view class="card" wx:if="{{pageMode==='profile-edit'}}">
      <view wx:if="{{pending&&!authenticated}}" class="empty-state"><text>正在打开个人资料…</text></view>
      <view wx:elif="{{authenticated&&loaded}}"><text class="hint">昵称</text><input value="{{nickname}}" placeholder="填写昵称" data-field="nickname" bindinput="input"/><text class="hint">联系方式</text><input value="{{contact}}" placeholder="填写联系方式" data-field="contact" bindinput="input"/><button class="primary" bindtap="save" loading="{{pending}}" disabled="{{pending}}">保存资料</button></view>
      <view wx:else class="empty-state"><text>暂时没有可显示的个人资料</text><button bindtap="retryLogin" loading="{{pending}}" disabled="{{pending}}">重新加载</button></view>
    </view>
    <view class="card" wx:if="{{pageMode==='notices'}}">
      <view class="row"><text class="title">消息列表</text><button size="mini" bindtap="loadNotices" loading="{{noticePending}}" disabled="{{noticePending||noticeDetailOpen||!loaded}}">刷新</button></view>
      <view wx:if="{{!loaded}}" class="empty-state"><text>暂时没有可显示的消息</text></view>
      <view wx:elif="{{!noticeDetailOpen}}"><view wx:for="{{notices}}" wx:key="id" class="notice-row"><text>{{item.read?'已读':'未读'}} · {{item.message}}</text><button size="mini" data-id="{{item.id}}" bindtap="openNotice" disabled="{{noticePending}}">查看</button></view><text wx:if="{{noticesLoaded&&!notices.length}}">暂无新消息</text><button wx:if="{{noticesMore}}" bindtap="loadNotices" data-more="true" disabled="{{noticePending}}">查看更多</button></view>
      <view wx:if="{{noticeDetailOpen&&selectedNotice}}"><button size="mini" bindtap="backNoticeList" disabled="{{noticePending}}">返回消息列表</button><text>{{selectedNotice.message}}</text><button wx:if="{{!selectedNotice.read}}" data-id="{{selectedNotice.id}}" bindtap="markNoticeRead" loading="{{noticePending}}" disabled="{{noticePending}}">标记已读</button></view>
    </view>
  </view>
</view>
