<view class="page consumer-page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="xj-nav"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view>
<view class="service-top">社区服务</view><view class="profile-hero"><view class="profile-avatar">我</view><view><text class="title">个人中心</text><text class="subtitle">账户资料与商家服务</text></view></view>
<view class="card"><text class="section-title">账户资料</text><button class="service-link" bindtap="showProfile">个人资料 ›</button><button class="service-link" bindtap="openOrders">我的订单 ›</button></view>
<view class="card"><text class="section-title">商家中心</text><button class="service-link highlighted-link" bindtap="openJoin">商家入驻与进度 ›</button><button class="service-link" bindtap="openMerchant">商家工作台（按原权限） ›</button><text class="hint">联系客服：当前项目未发现可使用现有入口，暂不可用。</text></view>
<view class="card"><text class="section-title">其他原有服务</text><button class="service-link" data-section="services" bindtap="navigateSection">社区与归属 / 推荐关系 ›</button><button class="service-link" bindtap="showNotices">我的通知 ›</button><button class="service-link" data-section="services" bindtap="navigateSection">退款申请 / 支付与订单恢复 ›</button></view>
<view class="card" id="account-details"><text class="description" aria-live="polite">{{status}}</text><button class="primary" wx:if="{{!authenticated}}" bindtap="retryLogin" loading="{{pending}}" disabled="{{pending}}">微信登录 / 注册</button><text wx:if="{{needsScene}}" class="hint">尚未选择门店；个人资料和订单仅按选定门店下的本人权限读取。商家入驻无需预先拥有门店。</text><button wx:if="{{needsScene}}" class="text-link" bindtap="scanStore">扫码进入门店</button><button wx:if="{{authenticated&&!loaded}}" class="text-link" bindtap="logout" disabled="{{pending}}">退出登录</button></view>
<view class="card" wx:if="{{authenticated&&loaded}}">
    <text>客户编号：{{customerId}}</text>
    <text class="hint">昵称</text><input value="{{nickname}}" placeholder="填写昵称" data-field="nickname" bindinput="input"/>
    <text class="hint">联系方式</text><input value="{{contact}}" placeholder="填写联系方式" data-field="contact" bindinput="input"/>
    <button class="primary" bindtap="save" loading="{{pending}}" disabled="{{pending}}">保存资料</button>
    <button bindtap="logout" disabled="{{pending}}">退出登录</button>
  </view>
  <view class="card" id="account-notices" wx:if="{{authenticated&&loaded}}">
    <view class="row"><text class="title">本人通知</text><button size="mini" bindtap="loadNotices" loading="{{noticePending}}" disabled="{{noticePending||noticeDetailOpen}}">刷新</button></view>
    <text class="description">{{noticeStatus}}</text>
    <view wx:if="{{!noticeDetailOpen}}">
      <text wx:if="{{!noticesLoaded&&!noticePending}}">尚未读取本人通知。</text>
      <view wx:for="{{notices}}" wx:key="id" class="notice-row"><text>{{item.read?'已读':'未读'}} · {{item.message}}</text><button size="mini" data-id="{{item.id}}" bindtap="openNotice" disabled="{{noticePending}}">查看详情</button></view>
      <text wx:if="{{noticesLoaded&&!notices.length}}">暂无本人通知。</text>
      <button wx:if="{{noticesMore}}" bindtap="loadNotices" data-more="true" disabled="{{noticePending}}">加载更多通知</button>
    </view>
    <view wx:if="{{noticeDetailOpen&&selectedNotice}}">
      <button size="mini" bindtap="backNoticeList" disabled="{{noticePending}}">返回通知列表</button>
      <text>通知详情 · {{selectedNotice.read?'已读':'未读'}}</text><text>{{selectedNotice.message}}</text>
      <button wx:if="{{!selectedNotice.read}}" data-id="{{selectedNotice.id}}" bindtap="markNoticeRead" loading="{{noticePending}}" disabled="{{noticePending}}">标记已读</button>
    </view>
  </view>
</view>
