/* Confirmed 60f1 profile tokens, native components; no remote fonts/assets. */
page{background:#f5f8f7;color:#192e30}.consumer-page{padding:36rpx}.profile-hero{display:flex;align-items:center;gap:26rpx;padding:32rpx 4rpx 38rpx}.profile-avatar{width:100rpx;height:100rpx;border-radius:50%;background:#e3f0e9;color:#287a53;display:flex;align-items:center;justify-content:center;font-size:36rpx}.profile-hero .title{font-size:40rpx;font-weight:650;display:block}.profile-hero .subtitle{font-size:24rpx;color:#7b9088;display:block;margin-top:10rpx}.card{background:white;border:1rpx solid #e5ece8;border-radius:28rpx;margin:24rpx 0;padding:22rpx 28rpx}.service-link{text-align:left;background:white;color:#263f35;font-size:28rpx;padding:20rpx 0;line-height:1.6;border-radius:0}.service-link:after{border:0}.merchant-entry-card{border-color:#d5e7dd;background:#f4faf6}.merchant-entry-card button{display:flex;align-items:center;justify-content:space-between;background:transparent;color:#157a60}.entry-title{display:block;font-weight:600;font-size:29rpx}.entry-hint{display:block;font-size:22rpx;font-weight:400;color:#789184;margin-top:7rpx;white-space:normal}.entry-chevron{font-size:36rpx}.section-title{color:#506a5d}.hint{line-height:1.7}

.entry-group .service-link{display:flex;align-items:center;gap:20rpx;border-bottom:1rpx solid #edf2ee}.entry-group .service-link:last-child{border-bottom:0}.entry-group .service-link>view{flex:1}.entry-icon{color:#6f9182;font-size:32rpx;width:38rpx;flex-shrink:0}.merchant-entry-card .service-link>view{flex:1;margin-left:20rpx}.page-heading{padding:14rpx 6rpx 20rpx}.page-heading .title{display:block;font-size:40rpx;font-weight:650;margin:22rpx 0 12rpx}.page-heading .subtitle{display:block;font-size:24rpx;color:#7b9088;line-height:1.7}.text-link{background:transparent;color:#287a53;font-size:25rpx}.text-link:after{border:0}.entry-group .entry-title{font-size:28rpx;font-weight:550}.entry-group .entry-hint{font-size:22rpx}.entry-group.card{padding-top:0;padding-bottom:0}
