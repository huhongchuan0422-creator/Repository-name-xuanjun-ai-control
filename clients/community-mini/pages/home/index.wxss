/* Frozen 60f1 native page tokens; original business handlers retained. */
page{background:#fff5f6;color:#34292d}.consumer-page,.page{padding:36rpx}.welcome{padding:30rpx 6rpx 38rpx}.kicker{font-size:19rpx;letter-spacing:2rpx;color:#b83b48}.welcome-title{display:block;font-size:49rpx;font-weight:650;line-height:1.35;margin:18rpx 0}.welcome-description{display:block;color:#756068;font-size:25rpx;line-height:1.8}.feature-visual{padding:38rpx 34rpx;border-radius:30rpx;background:#ffe4e8;color:#34292d;min-height:310rpx;box-sizing:border-box}.featured-label{font-size:22rpx;color:#b83b48}.feature-title{display:block;white-space:pre-line;font-size:46rpx;font-weight:650;line-height:1.4;margin:28rpx 0 18rpx}.feature-description{display:block;font-size:24rpx;color:#756068}.feature-action{background:transparent;text-align:left;padding:24rpx 0 0;color:#b83b48;font-size:25rpx;font-weight:600}.feature-action:after{border:0}.section-heading{display:flex;align-items:center;justify-content:space-between;margin:34rpx 0 14rpx}.section-title{font-size:30rpx;font-weight:600}.section-heading .text-link{margin:0;padding:8rpx 0}.card{background:#fff;border:1rpx solid #f1d5da;border-radius:26rpx;padding:28rpx;margin:22rpx 0}.empty-state{padding:38rpx 28rpx}.empty-title{display:block;font-size:29rpx;font-weight:550;margin-bottom:16rpx}.hint{display:block;font-size:23rpx;color:#756068;line-height:1.8}.text-link{background:transparent;color:#b83b48;font-size:25rpx}.text-link:after{border:0}.service-link{background:transparent;text-align:left;color:#34292d;font-size:26rpx}.service-link:after{border:0}

/* Keep the section heading and its action as two compact, non-shrinking items. */
.section-heading{gap:20rpx;}
.section-heading>.section-title{flex:0 0 auto;white-space:nowrap;}
.section-heading>.text-link{flex:0 0 auto;width:auto;min-width:0;white-space:nowrap;}
page{background:linear-gradient(180deg,#ffcdd8 0,#fcd7de 400rpx,#fff5f6 700rpx)}
.page.consumer-page{padding-top:32rpx;padding-right:28rpx;padding-left:28rpx}
.welcome{position:relative;min-height:246rpx;padding:36rpx 12rpx 40rpx}
.kicker{display:block;font-size:20rpx;font-weight:650;letter-spacing:1.1rpx;color:#912640}
.welcome-title{color:#551a2e;font-size:49rpx;line-height:1.22;font-weight:750;margin:16rpx 0}
.welcome-description{color:#6e3547;font-size:25rpx;line-height:1.5}
.feature-visual{position:relative;padding:28rpx 28rpx 18rpx;border:1rpx solid #f7d7dd;background:#fdf9fa;color:#492133;min-height:0;box-shadow:0 12rpx 32rpx rgba(126,34,58,.09)}
.featured-label{display:inline-block;padding:5rpx 14rpx;border-radius:999rpx;color:#8b2442;background:#fde6eb;font-weight:650}
.feature-title{font-size:39rpx;white-space:normal;line-height:1.25;margin:14rpx 0 10rpx;color:#651e36;font-weight:750}
.feature-description{color:#756068;line-height:1.5;overflow-wrap:anywhere}
.feature-action{background:#fce5e9;color:#98233f;min-height:74rpx;font-weight:750;border-radius:20rpx;padding:14rpx 20rpx;margin:22rpx 0 0;width:100%;text-align:left}
.section-heading{margin-top:34rpx;min-height:64rpx}
.section-heading .section-title{border-left:8rpx solid #dc5d74;padding-left:14rpx;margin:0;color:#5e2134;font-size:33rpx;font-weight:750}
.section-heading .text-link{color:#b83b48}
.store-row,.empty-state,.status-card{background:#fff;border-color:#f3dce0;box-shadow:0 7rpx 22rpx rgba(105,39,59,.05)}

page{background:linear-gradient(180deg,#ffe4e8 0,#fff5f6 460rpx)}
