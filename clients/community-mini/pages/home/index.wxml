<view class="page consumer-page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="xj-nav"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view>
<view class="welcome"><text class="kicker">NEIGHBORHOOD / 每日相伴</text><text class="welcome-title">好生活，就在身边。</text><text class="welcome-description">发现门店，连接社区，让服务更近一点。</text></view>
<view class="feature-visual"><text class="featured-label">从一家熟悉的店开始</text><text class="feature-title">扫一下，
认识您的邻里好店。</text><text class="feature-description">通过原门店入口查看商家介绍</text><button wx:if="{{needsScene}}" class="feature-action" bindtap="scanStore">扫码查看门店 ›</button><button wx:else class="feature-action" bindtap="openStorefront">查看当前门店介绍 ›</button></view>
<view class="section-heading"><text class="section-title">身边的服务</text><button class="text-link" bindtap="openRecommendations">查看推荐 ›</button></view>
<view class="card store-row" wx:if="{{!needsScene}}"><view class="store-avatar">店</view><view class="store-copy"><text class="section-title">当前选择的门店</text><text class="hint">门店资料和资质以实际记录为准</text><button class="text-link" bindtap="openStorefront">查看商家介绍 ›</button></view></view><view class="card empty-state" wx:else><text class="empty-title">还没有选择门店</text><text class="hint">附近商家目录尚未接通，不展示虚构门店、定位或排名。</text><button class="text-link" bindtap="scanStore">选择门店</button><button class="text-link" bindtap="openRecommendations">浏览推荐与门店入口 ›</button></view>
<view class="card"><text class="section-title">我的服务</text><button class="service-link" bindtap="openProfile">个人资料 ›</button><button class="service-link" bindtap="openCheckout">门店与订单 ›</button><button class="service-link" data-section="services" bindtap="navigateSection">社区与推荐 · 更多服务 ›</button></view>
<view class="card status-card"><text class="description" aria-live="polite">{{status}}</text><button wx:if="{{!authenticated}}" class="primary" bindtap="retryLogin" loading="{{pending}}" disabled="{{pending}}">{{pending?'正在登录':'微信登录 / 注册'}}</button><button wx:else class="text-link" bindtap="logout" disabled="{{pending}}">退出登录</button></view>
<button class="text-link" bindtap="openPrivacy">隐私保护指引</button><text class="hint" aria-live="polite">{{privacyStatus}}</text><text class="hint">商家入驻、微信认证与支付资格分别核验。支付尚未开放。</text></view>