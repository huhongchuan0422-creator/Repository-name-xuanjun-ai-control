<view class="page consumer-page {{workspace&&view==='home'?'wa-frame':''}}" style="box-sizing:border-box;"><view class="xj-nav" wx:if="{{!workspace||view!=='home'}}"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view><button class="text-link" wx:if="{{view==='home'&&!workspace}}" bindtap="goProfile">‹ 返回个人中心</button><button class="text-link" wx:elif="{{view!=='home'}}" bindtap="back">‹ 返回工作台</button>
<view wx:if="{{!workspace}}" class="page-heading"><text class="title">商家工作台</text><text class="subtitle">{{pending?'正在读取门店经营数据…':'暂时无法读取当前工作台，可重试。'}}</text></view>
<view wx:elif="{{view!=='home'}}" class="page-heading"><text class="title">{{view==='orders'?'日常订单':view==='summary'?'收款统计':view==='settings'?'门店资料':view==='profile-edit'?'编辑门店':view==='detail'?'订单详情':'商家收款码'}}</text><text class="subtitle">{{view==='summary'?'查看当前门店的经营数据。':view==='collection'?'本店二维码可保存打印；付款能力仍须单独核实。':'当前授权门店范围'}}</text></view>
<text wx:if="{{status && status!=='请选择日常服务'}}" class="description status" aria-live="polite">{{status}}</text>
<view wx:if="{{!workspace&&!pending}}" class="card empty-state"><text class="section-title">暂时进不去工作台</text><text class="hint">{{needsScene?'可选择已授权门店，或回到个人中心重新打开工作台。':'请重试读取当前门店，不需要重新申请。'}}</text><button class="primary" wx:if="{{needsScene}}" bindtap="scanStore">选择已授权门店</button><button class="primary" wx:else bindtap="connect">重新读取工作台</button><button class="text-link" bindtap="goProfile">返回个人中心</button></view>
<view wx:if="{{workspace&&view==='home'}}" class="wb-home wa-home">
  <view class="wa-head">
    <view class="wa-head-text">
      <text class="wa-kicker">商家工作台</text>
      <text class="wa-store-name">{{workspaceDisplayName || '当前门店'}}</text>
    </view>
    <button class="wa-gear" aria-label="门店设置" data-view="settings" bindtap="open" disabled="{{pending}}"><text aria-hidden="true">⚙</text></button>
  </view>
  <picker wx:if="{{workspaces.length > 1 && workspaceDisplayNames.length === workspaces.length}}" range="{{workspaceDisplayNames}}" bindchange="chooseWorkspace" disabled="{{pending}}" class="wa-picker"><view>切换门店 <text aria-hidden="true">›</text></view></picker>
  <view class="wa-card wa-analysis" aria-label="经营概览">
    <view class="wa-section-head"><text class="wa-section-title">经营概览</text><button class="wa-inline-action" data-view="summary" bindtap="open" disabled="{{pending}}">明细 <text aria-hidden="true">›</text></button></view>
    <block wx:if="{{homeAnalysis}}">
      <view class="wa-kpis">
        <view class="wa-kpi"><text class="wa-kpi-label">营业额</text><text class="wa-kpi-value">{{homeAnalysis.turnover || '暂未取得'}}</text><text class="wa-kpi-caption">按订单金额统计</text></view>
        <view class="wa-kpi"><text class="wa-kpi-label">捐赠金额</text><text class="wa-kpi-value">{{homeAnalysis.donation || '暂未取得'}}</text></view>
        <view class="wa-kpi"><text class="wa-kpi-label">积分抵扣金额</text><text class="wa-kpi-value">{{homeAnalysis.pointsOffset || '暂未取得'}}</text></view>
        <view class="wa-kpi"><text class="wa-kpi-label">商家积分余额</text><text class="wa-kpi-value">{{homeAnalysis.pointsBalance || '暂未取得'}}</text></view>
      </view>
      <view class="wa-order-counts" wx:if="{{homeOrderCount > 0}}" aria-label="按状态统计的订单笔数">
        <view class="wa-order-count" wx:for="{{homeAnalysis.states}}" wx:key="key">
          <text class="wa-order-count-value">{{item.count}} 笔</text><text class="wa-order-count-label">{{item.label}}</text>
        </view>
      </view>
    </block>
    <view wx:elif="{{homeOrderState==='loading'}}" class="wa-empty" aria-live="polite">正在读取经营数据…</view>
    <view wx:else class="wa-empty">经营数据暂未取得</view>
  </view>
  <view class="wa-card wa-orders" aria-label="订单记录">
    <view class="wa-section-head"><text class="wa-section-title">订单记录</text><button class="wa-inline-action" data-view="orders" bindtap="open" disabled="{{pending}}">{{homeOrderCount || homeOrderCount === 0 ? '全部 ' + homeOrderCount + ' 笔' : '全部订单'}} <text aria-hidden="true">›</text></button></view>
    <view wx:if="{{homeOrderState==='ready' && homeOrders.length}}">
      <button wx:for="{{homeOrders}}" wx:key="reference" class="wb-row wb-order-row wa-order-row" data-reference="{{item.reference}}" bindtap="detail" disabled="{{pending}}">
        <view class="wb-flex-main"><text class="wb-order-ref">{{item.reference}}</text><text class="wb-muted">{{item.displayState}}</text></view>
        <text class="wb-amount">{{item.displayAmount}}</text><text class="wb-arrow" aria-hidden="true">›</text>
      </button>
    </view>
    <view wx:elif="{{homeOrderState==='ready'}}" class="wa-empty">暂无订单记录</view>
    <view wx:elif="{{homeOrderState==='loading'}}" class="wa-empty" aria-live="polite">正在读取订单…</view>
    <view wx:else class="wa-empty">订单记录暂未取得</view>
  </view>
  <view class="wa-tools">
    <button class="wa-inline-action" bindtap="join" disabled="{{pending}}">入驻与补件进度</button>
    <button class="wa-inline-action" bindtap="scanStore" disabled="{{pending}}">扫码选择门店</button>
    <button class="wa-inline-action" bindtap="goProfile">返回个人中心</button>
  </view>
  <view class="wa-card wa-collection" aria-label="商家收款码">
    <view class="wa-section-head"><text class="wa-section-title">商家收款码</text></view>
    <block wx:if="{{collectionCodeAllowed && codeReady && codePath}}">
      <image src="{{codePath}}" mode="aspectFit" class="wb-qr" aria-label="本店入口二维码"/>
      <button class="wa-download" bindtap="saveCollectionCode" disabled="{{pending || codeRequestPending}}">下载到相册</button>
    </block>
    <view wx:elif="{{codeRequestPending}}" class="wa-empty" aria-live="polite">正在读取本店二维码…</view>
    <view wx:else class="wa-empty">{{collectionCodeAllowed ? '暂未取得收款码，可重试' : '当前门店暂未提供收款码'}}</view>
    <button wx:if="{{collectionCodeAllowed === true && !codeReady}}" class="wa-inline-action" bindtap="collectionCode" disabled="{{pending || codeRequestPending}}">读取本店二维码</button>
  </view>
</view>
<view wx:if="{{workspace&&view==='orders'}}"><view wx:for="{{orders}}" wx:key="reference" class="card order-card"><text class="badge">{{item.displayState}}</text><text class="record-reference">{{item.reference}}</text><text class="amount">{{item.displayAmount}}</text><button class="primary" data-reference="{{item.reference}}" bindtap="detail" disabled="{{pending}}">订单详情</button></view><view class="card empty-state" wx:if="{{!orders.length}}"><text class="section-title">暂无记录</text><text class="hint">尚未查询到当前授权门店订单</text></view><button data-view="orders" bindtap="open" disabled="{{pending}}">刷新订单</button></view>
<view wx:if="{{workspace&&view==='summary'&&summary}}"><view class="metrics"><view class="metric"><text>营业额</text><text class="amount">{{summaryDisplay.turnover || '暂未取得'}}</text><text class="hint">按订单金额统计，不等于到账收入</text></view><view class="metric"><text>捐赠金额</text><text class="amount">{{summaryDisplay.donation || '暂未取得'}}</text></view><view class="metric"><text>积分抵扣金额</text><text class="amount">{{summaryDisplay.pointsOffset || '暂未取得'}}</text></view><view class="metric"><text>商家积分余额</text><text class="amount">{{summaryDisplay.pointsBalance || '暂未取得'}}</text></view><view class="metric"><text>已核实退款金额</text><text class="amount">{{summaryDisplay.refunded || '暂未取得'}}</text></view></view><button data-view="summary" bindtap="open" disabled="{{pending}}">刷新统计</button></view>
<view wx:if="{{workspace&&view==='settings'&&settings}}"><view class="card record-card"><view class="field"><text class="field-label">门店名称</text><text>{{settings.profile.name}}</text></view><view class="field"><text class="field-label">门店简介</text><text>{{settings.profile.description}}</text></view><view class="field"><text class="field-label">联系方式</text><text>{{settings.profile.contact}}</text></view></view><button class="primary" wx:if="{{permissions[workspace].profile_edit}}" bindtap="editProfile">编辑门店资料</button><text class="section-title">原商品记录</text><view class="card" wx:for="{{settings.items}}" wx:key="id"><text>{{item.name}}</text></view><text wx:if="{{!settings.items.length}}" class="hint">暂无可见商品记录</text></view>
<view wx:if="{{workspace&&view==='profile-edit'&&editor}}" class="card form-card"><label>门店名称<input value="{{editor.name}}" data-key="name" bindinput="editInput" maxlength="120"/></label><label>简介<textarea value="{{editor.description}}" data-key="description" bindinput="editInput" maxlength="2048"/></label><label>联系方式<input value="{{editor.contact}}" data-key="contact" bindinput="editInput" maxlength="120"/></label><button class="primary" bindtap="saveProfile" disabled="{{pending}}">保存门店资料</button><button class="text-link" bindtap="backSettings" disabled="{{pending}}">取消 / 返回门店资料</button></view>
<view wx:if="{{workspace&&view==='detail'&&detail}}" class="card record-card"><text class="badge">{{detailDisplay.state}}</text><text class="record-reference">{{detail.reference}}</text><text class="amount">{{detailDisplay.amount}}</text><text>{{detail.provider_payment_verified?'微信支付已核实':'尚无微信支付成功证据'}}</text><text class="hint">退款与分账实际执行结果仍以原服务端查询及对账为准。</text><button data-view="orders" bindtap="open" disabled="{{pending}}">返回日常订单</button></view>
<view wx:if="{{workspace&&view==='collection'}}"><view class="wb-code-unavailable" wx:if="{{!(collectionCodeAllowed&&codeReady&&codePath)}}"><text>暂未提供本店二维码</text></view><image wx:else src="{{codePath}}" mode="widthFix" class="collection-code"/><button class="primary" bindtap="collectionCode" wx:if="{{collectionCodeAllowed}}" disabled="{{pending || codeRequestPending}}">取得本店二维码</button><button wx:if="{{collectionCodeAllowed&&codeReady&&codePath}}" bindtap="saveCollectionCode" disabled="{{pending}}">保存到手机相册 / 打印</button><text class="hint">保存原图可用于打印；二维码可显示不代表已具备付款权限。</text></view>
</view>
