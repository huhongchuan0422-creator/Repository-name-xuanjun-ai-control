<view class="page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="xj-nav" style="position:fixed;left:0;right:0;bottom:0;z-index:999;display:flex;gap:8rpx;padding:12rpx 12rpx calc(12rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff;border-top:1rpx solid #e5e7eb;box-shadow:0 -4rpx 18rpx rgba(15,23,42,.08);"><button style="{{activeSection==='home'?'flex:1;font-size:24rpx;line-height:1.5;background:#172554;color:#fff;border-radius:12rpx;':'flex:1;font-size:24rpx;line-height:1.5;background:#f3f4f6;color:#1f2937;border-radius:12rpx;'}}" data-section="home" bindtap="navigateSection">首页</button><button style="{{activeSection==='recommendations'?'flex:1;font-size:24rpx;line-height:1.5;background:#172554;color:#fff;border-radius:12rpx;':'flex:1;font-size:24rpx;line-height:1.5;background:#f3f4f6;color:#1f2937;border-radius:12rpx;'}}" data-section="recommendations" bindtap="navigateSection">推荐</button><button style="{{activeSection==='orders'?'flex:1;font-size:24rpx;line-height:1.5;background:#172554;color:#fff;border-radius:12rpx;':'flex:1;font-size:24rpx;line-height:1.5;background:#f3f4f6;color:#1f2937;border-radius:12rpx;'}}" data-section="orders" bindtap="navigateSection">订单</button><button style="{{activeSection==='profile'?'flex:1;font-size:24rpx;line-height:1.5;background:#172554;color:#fff;border-radius:12rpx;':'flex:1;font-size:24rpx;line-height:1.5;background:#f3f4f6;color:#1f2937;border-radius:12rpx;'}}" data-section="profile" bindtap="navigateSection">我的</button></view><text class="title">商家工作台</text><text class="description">{{status}}</text>
<button bindtap="join">入驻申请与进度</button><picker wx:if="{{workspaces.length}}" range="{{workspaces}}" bindchange="chooseWorkspace" disabled="{{pending}}"><view class="card">当前门店：{{workspace}} ›</view></picker>
<view wx:if="{{workspace && view==='home'}}" class="card"><button data-view="orders" bindtap="open" disabled="{{pending}}">日常订单与收款记录</button><button data-view="summary" bindtap="open" disabled="{{pending}}">收款统计</button><button data-view="settings" bindtap="open" disabled="{{pending}}">门店与商品资料</button><button bindtap="collectionCode" disabled="{{pending}}">取得正式商家收款码</button><image wx:if="{{codeReady}}" src="{{codePath}}" mode="widthFix" style="width:100%"/><button wx:if="{{codeReady}}" bindtap="saveCollectionCode">保存到手机相册 / 打印</button><text class="hint">退款、商品维护及结算分账等原有后台功能保留；本页先提供已接通查询。</text></view>
<view wx:if="{{view==='orders'}}"><text class="section-title">本页订单</text><view wx:for="{{orders}}" wx:key="reference" class="card"><text>{{item.reference}}</text><text>金额 {{item.displayAmount}}（原值 {{item.amount_minor}} 分） · {{item.displayState}}</text><button data-reference="{{item.reference}}" bindtap="detail" disabled="{{pending}}">订单详情</button></view><text wx:if="{{!orders.length}}">暂无记录</text></view>
<view wx:if="{{view==='summary' && summary}}" class="card"><text class="section-title">原订单统计</text><text>订单总额 {{summaryDisplay.order}}（{{summary.order_total_minor}} 分）</text><text>微信核实收款 {{summaryDisplay.paid}}（{{summary.provider_paid_observations_minor}} 分）</text><text>微信核实退款 {{summaryDisplay.refunded}}（{{summary.provider_refund_observations_minor}} 分）</text><text>结算收入：尚未完成对账确认</text></view>
<view wx:if="{{view==='settings' && settings}}" class="card"><text>{{settings.profile.name}}</text><text>{{settings.profile.description}}</text><button wx:if="{{permissions[workspace].profile_edit}}" bindtap="editProfile">编辑门店资料</button><view wx:for="{{settings.items}}" wx:key="id"><text>{{item.name}}</text></view></view>
<view wx:if="{{view==='profile-edit' && editor}}" class="card"><label>门店名称<input value="{{editor.name}}" data-key="name" bindinput="editInput" maxlength="120"/></label><label>简介<textarea value="{{editor.description}}" data-key="description" bindinput="editInput" maxlength="2048"/></label><label>联系方式<input value="{{editor.contact}}" data-key="contact" bindinput="editInput" maxlength="120"/></label><button bindtap="saveProfile" disabled="{{pending}}">保存门店资料</button></view>
<view wx:if="{{view==='detail' && detail}}" class="card"><text>{{detail.reference}}</text><text>订单状态 {{detailDisplay.state}}</text><text>订单金额 {{detailDisplay.amount}}（{{detail.order.amount_minor}} 分）</text><text>{{detail.provider_payment_verified?'微信支付已核实':'尚无微信支付成功证据'}}</text><text>退款与分账实际执行结果仍以原服务端查询及对账为准。</text></view><button wx:if="{{view!=='home'}}" bindtap="back">返回工作台</button>
</view>
