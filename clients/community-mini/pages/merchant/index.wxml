<view class="page consumer-page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="xj-nav"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view><button class="text-link" wx:if="{{view==='home'}}" bindtap="goProfile">‹ 返回个人中心</button><button class="text-link" wx:else bindtap="back">‹ 返回工作台</button>
<view wx:if="{{workspace&&view==='home'}}" class="merchant-hero"><text class="eyebrow">商家服务</text><text class="title">把日常经营，
打理得更从容。</text><text class="subtitle">订单、门店与入驻进度，各有清楚的位置。</text></view>
<view wx:elif="{{!workspace}}" class="page-heading"><text class="title">先完成入驻</text><text class="subtitle">商家工作台仅对已有对应授权的商家开放。</text></view>
<view wx:else class="page-heading"><text class="title">{{view==='orders'?'日常订单':view==='summary'?'收款统计':view==='settings'?'门店资料':view==='profile-edit'?'编辑门店':view==='detail'?'订单详情':'商家收款码'}}</text><text class="subtitle">{{view==='summary'?'订单金额、核实收款和退款观察不可混为到账收入。':view==='collection'?'正式收款码须通过原资格核验。':'当前授权门店范围'}}</text></view>
<text class="description status" aria-live="polite">{{status}}</text>
<view wx:if="{{!workspace}}" class="card empty-state"><text class="section-title">暂不能进入商家工作台</text><text class="hint">{{needsScene?'扫码选择已授权门店；首次申请请从个人中心办理入驻。':'尚未取得可用商家授权，请查看本人入驻进度。'}}</text><button class="primary" bindtap="scanStore">扫码选择已授权门店</button><button class="text-link" bindtap="goProfile">返回个人中心</button><button class="text-link" bindtap="connect" disabled="{{pending||needsScene}}">重新读取商家资格</button></view>
<picker wx:if="{{workspaces.length&&view==='home'}}" range="{{workspaces}}" bindchange="chooseWorkspace" disabled="{{pending}}"><view class="workspace-choice"><text>当前门店范围</text><text>{{workspace}} ›</text></view></picker>
<view wx:if="{{workspace&&view==='home'}}">
<view class="card entry-group"><button class="service-link" data-view="orders" bindtap="open" disabled="{{pending}}"><text class="entry-icon">▤</text><view><text class="entry-title">日常订单</text><text class="entry-hint">原订单与收款记录</text></view><text>›</text></button><button class="service-link" data-view="summary" bindtap="open" disabled="{{pending}}"><text class="entry-icon">◫</text><view><text class="entry-title">收款统计</text><text class="entry-hint">核实收款、退款与结算分开</text></view><text>›</text></button><button class="service-link" data-view="settings" bindtap="open" disabled="{{pending}}"><text class="entry-icon">⌂</text><view><text class="entry-title">门店与商品资料</text><text class="entry-hint">展示信息与原商品记录</text></view><text>›</text></button><button class="service-link" bindtap="showCollection" disabled="{{pending}}"><text class="entry-icon">□</text><view><text class="entry-title">商家收款码</text><text class="entry-hint">资格核验后才可使用</text></view><text>›</text></button></view>
<button class="text-link" bindtap="scanStore">扫码选择已授权门店</button><button class="text-link" bindtap="join">查看原入驻 / 补件进度</button><text class="hint">退款、商品维护及结算分账等原有后台功能保留。</text></view>
<view wx:if="{{workspace&&view==='orders'}}"><view wx:for="{{orders}}" wx:key="reference" class="card order-card"><text class="badge">{{item.displayState}}</text><text class="record-reference">{{item.reference}}</text><text class="amount">{{item.displayAmount}}</text><text class="hint">原值 {{item.amount_minor}} 分</text><button class="primary" data-reference="{{item.reference}}" bindtap="detail" disabled="{{pending}}">订单详情</button></view><view class="card empty-state" wx:if="{{!orders.length}}"><text class="section-title">暂无记录</text><text class="hint">尚未查询到当前授权门店订单</text></view><button data-view="orders" bindtap="open" disabled="{{pending}}">刷新订单</button></view>
<view wx:if="{{workspace&&view==='summary'&&summary}}"><view class="metrics"><view class="metric"><text>订单总额</text><text class="amount">{{summaryDisplay.order}}</text><text class="hint">{{summary.order_total_minor}} 分</text></view><view class="metric"><text>微信核实收款</text><text class="amount">{{summaryDisplay.paid}}</text><text class="hint">{{summary.provider_paid_observations_minor}} 分</text></view><view class="metric"><text>微信核实退款</text><text class="amount">{{summaryDisplay.refunded}}</text><text class="hint">{{summary.provider_refund_observations_minor}} 分</text></view><view class="metric"><text>结算收入</text><text class="amount">—</text><text class="hint">尚未完成对账确认</text></view></view><button data-view="summary" bindtap="open" disabled="{{pending}}">刷新统计</button></view>
<view wx:if="{{workspace&&view==='settings'&&settings}}"><view class="card record-card"><view class="field"><text class="field-label">门店名称</text><text>{{settings.profile.name}}</text></view><view class="field"><text class="field-label">门店简介</text><text>{{settings.profile.description}}</text></view><view class="field"><text class="field-label">联系方式</text><text>{{settings.profile.contact}}</text></view></view><button class="primary" wx:if="{{permissions[workspace].profile_edit}}" bindtap="editProfile">编辑门店资料</button><text class="section-title">原商品记录</text><view class="card" wx:for="{{settings.items}}" wx:key="id"><text>{{item.name}}</text></view><text wx:if="{{!settings.items.length}}" class="hint">暂无可见商品记录</text></view>
<view wx:if="{{workspace&&view==='profile-edit'&&editor}}" class="card form-card"><label>门店名称<input value="{{editor.name}}" data-key="name" bindinput="editInput" maxlength="120"/></label><label>简介<textarea value="{{editor.description}}" data-key="description" bindinput="editInput" maxlength="2048"/></label><label>联系方式<input value="{{editor.contact}}" data-key="contact" bindinput="editInput" maxlength="120"/></label><button class="primary" bindtap="saveProfile" disabled="{{pending}}">保存门店资料</button><button class="text-link" bindtap="backSettings" disabled="{{pending}}">取消 / 返回门店资料</button></view>
<view wx:if="{{workspace&&view==='detail'&&detail}}" class="card record-card"><text class="badge">{{detailDisplay.state}}</text><text class="record-reference">{{detail.reference}}</text><text class="amount">{{detailDisplay.amount}}</text><text class="hint">原订单金额 {{detail.order.amount_minor}} 分</text><text>{{detail.provider_payment_verified?'微信支付已核实':'尚无微信支付成功证据'}}</text><text class="hint">退款与分账实际执行结果仍以原服务端查询及对账为准。</text><button data-view="orders" bindtap="open" disabled="{{pending}}">返回日常订单</button></view>
<view wx:if="{{workspace&&view==='collection'}}"><view class="code-empty" wx:if="{{!codeReady}}"><text>未取得正式收款码</text><text class="hint">不是可扫描二维码</text></view><image wx:else src="{{codePath}}" mode="widthFix" class="collection-code"/><button class="primary" bindtap="collectionCode" disabled="{{pending}}">取得正式商家收款码</button><button wx:if="{{codeReady}}" bindtap="saveCollectionCode" disabled="{{pending}}">保存到手机相册 / 打印</button><text class="hint">仅真实收款码取得后可保存；付款仍以微信核验为准。</text></view>
</view>
