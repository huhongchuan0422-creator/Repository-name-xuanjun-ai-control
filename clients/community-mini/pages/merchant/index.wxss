 .merchant-hero{padding:32rpx;background:linear-gradient(115deg,#ffcdd8,#f8e6ec);border:1rpx solid #f1d0d8}
.merchant-hero .title,.page-heading .title{color:#532032;font-weight:750}
.metric{background:#fff7f8;border-color:#f3dce4;border-radius:22rpx}
.code-empty{background:#f8e6ec;border-color:#f3dce4}
.collection-code{background:#fff}
button.primary[disabled]{background:#eee9ec;color:#75666e}

/* Home only: keep original child view/navigation styles untouched. */
.wb-home{color:#2f1822;font-size:28rpx;min-width:0;margin-top:8rpx}
.wb-home .wb-store,.wb-home .wb-heading,.wb-home .wb-row,.wb-home .wb-picker-label{display:flex;align-items:center}
.wb-home .wb-store,.wb-home .wb-heading{justify-content:space-between;gap:20rpx}
.wb-home .wb-store{margin:6rpx 0 24rpx;padding:24rpx 28rpx;border:1rpx solid #f0ccd8;border-radius:26rpx;background:#fdebf1}
.wb-home .wb-store-title,.wb-home .wb-flex-main{flex:1;min-width:0}
.wb-home .wb-kicker,.wb-home .wb-store-name,.wb-home .wb-title,.wb-home .wb-row-title,.wb-home .wb-muted,.wb-home .wb-note,.wb-home .wb-order-ref{display:block}
.wb-home .wb-kicker,.wb-home .wb-link,.wb-home .wb-picker-label,.wb-home .wb-arrow{color:#98274d}
.wb-home .wb-kicker,.wb-home .wb-muted{font-size:24rpx;line-height:1.55}
.wb-home .wb-store-name{font-size:39rpx;line-height:1.3;font-weight:700;margin-top:6rpx;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.wb-home .wb-picker,.wb-home .wb-picker-label,.wb-home .wb-arrow,.wb-home .wb-amount{flex:none}
.wb-home .wb-picker-label{font-size:24rpx;line-height:1.35;gap:10rpx;white-space:nowrap;min-height:70rpx}
.wb-home .wb-card{background:#fff;border:1rpx solid #f0dce3;border-radius:26rpx;margin:0 0 22rpx;padding:22rpx 26rpx;box-sizing:border-box}
.wb-home .wb-heading{min-height:58rpx}
.wb-home .wb-title{font-size:31rpx;font-weight:700;line-height:1.4}
.wb-home .wb-muted,.wb-home .wb-note{color:#6d505a;font-size:24rpx;line-height:1.45}
.wb-home .wb-note{padding:12rpx 0}
.wb-home .wb-link,.wb-home .wb-row{box-sizing:border-box;background:transparent;border:0;border-radius:0;text-align:left;margin:0;padding:0}
.wb-home .wb-link{flex:none;font-size:25rpx;font-weight:600;line-height:1.35;white-space:nowrap}
.wb-home .wb-link:after,.wb-home .wb-row:after{border:0}
.wb-home .wb-row{gap:18rpx;width:100%;min-height:44px;padding:14rpx 0;border-top:1rpx solid #f5e7ec;color:#2f1822}
.wb-home .wb-row-title,.wb-home .wb-order-ref{font-weight:600;font-size:27rpx;line-height:1.45}
.wb-home .wb-order-ref{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wb-home .wb-icon{flex:0 0 48rpx;text-align:center;line-height:48rpx;height:48rpx;border-radius:14rpx;background:#fcecf1;color:#98274d;font-size:27rpx}
.wb-home .wb-arrow{font-size:32rpx;line-height:1;min-width:14rpx;text-align:right}
.wb-home .wb-amount{font-size:28rpx;line-height:1.4;font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}
.wb-home .wb-latest-label{margin:8rpx 0 10rpx}
.wb-home .wb-qr{display:block;width:260rpx;height:260rpx;max-width:100%;margin:18rpx auto}
.wb-home .wb-collection-action{margin-top:10rpx;min-height:70rpx}

.wb-code-unavailable{padding:28rpx 0;color:#6d505a;font-size:25rpx}

.consumer-page:not(.wa-frame){padding-bottom:180rpx}
/* Merchant home only. Keep operational children and house palette. */
.wa-frame{padding-bottom:34rpx;padding-bottom:calc(34rpx + env(safe-area-inset-bottom))}
.wa-home{margin-top:0;color:#34292d}
.wa-home .wa-head,.wa-home .wa-section-head,.wa-home .wa-chart-head,.wa-home .wa-finance,.wa-home .wa-tools{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.wa-home .wa-head{min-height:98rpx;margin:0 0 14rpx;padding:4rpx 0}
.wa-home .wa-head-text{flex:1;min-width:0}
.wa-home .wa-kicker,.wa-home .wa-store-name,.wa-home .wa-kpi-label,.wa-home .wa-kpi-value,.wa-home .wa-finance-note,.wa-home .wa-empty-title{display:block}
.wa-home .wa-kicker,.wa-home .wa-scope,.wa-home .wa-kpi-label,.wa-home .wa-chart-head,.wa-home .wa-finance-note{font-size:23rpx;line-height:1.45;color:#75555f}
.wa-home .wa-kicker{color:#b83b48}
.wa-home .wa-store-name{margin-top:6rpx;font-size:40rpx;font-weight:750;line-height:1.28;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.wa-home .wa-gear,.wa-home .wa-inline-action,.wa-home .wa-download{margin:0;padding:0;border:0;box-sizing:border-box;color:#b83b48;background:transparent;line-height:1.3;font-size:25rpx;font-weight:600}
.wa-home .wa-gear:after,.wa-home .wa-inline-action:after,.wa-home .wa-download:after{border:0}
.wa-home .wa-gear{flex:none;width:44px;height:44px;display:flex;align-items:center;justify-content:center;border:1rpx solid #edcbd5;border-radius:18rpx;background:#fff3f6;font-size:37rpx}
.wa-home .wa-picker{color:#b83b48;font-size:25rpx;margin-bottom:12rpx;padding:6rpx 0}
.wa-home .wa-card{box-sizing:border-box;border-radius:25rpx;padding:20rpx 23rpx;margin:0 0 19rpx;background:#fff;border:1rpx solid #efdde3}
.wa-home .wa-analysis{background:linear-gradient(160deg,#fff6f8 0%,#fff 56%);border-color:#ecd2db}
.wa-home .wa-section-head{min-height:46rpx;margin-bottom:10rpx}
.wa-home .wa-section-title{font-size:31rpx;font-weight:750;line-height:1.35;min-width:0}
.wa-home .wa-scope{flex:none;text-align:right;font-size:21rpx}
.wa-home .wa-kpis{display:flex;flex-wrap:wrap;gap:10rpx;margin:10rpx 0 15rpx}
.wa-home .wa-kpi{flex:1 1 28%;min-width:0;background:#fff;border:1rpx solid #f2e1e6;border-radius:15rpx;padding:12rpx 10rpx}
.wa-home .wa-kpi-label{font-size:22rpx}
.wa-home .wa-kpi-value{margin-top:6rpx;color:#542235;font-size:31rpx;font-weight:750;line-height:1.2;overflow-wrap:anywhere;word-break:break-word;font-variant-numeric:tabular-nums}
.wa-home .wa-empty{font-size:24rpx;line-height:1.6;color:#75555f;padding:14rpx 0 8rpx}
.wa-home .wa-empty-title{font-weight:650;color:#532032}
.wa-home .wa-inline-action{flex:none;text-align:right;min-height:44px;line-height:1.4;white-space:nowrap}
.wa-home .wa-order-row{min-height:44px}
.wa-home .wa-finance{min-height:52rpx;border-top:1rpx solid #f6eaee;color:#604653;font-size:25rpx}
.wa-home .wa-finance-value{font-variant-numeric:tabular-nums;color:#532032;font-weight:650;overflow-wrap:anywhere;text-align:right;max-width:58%}
.wa-home .wa-finance-note{margin-top:10rpx}
.wa-home .wa-tools{flex-wrap:wrap;justify-content:flex-start;gap:0 18rpx;padding:0 0 7rpx}
.wa-home .wa-tools .wa-inline-action{font-size:22rpx;color:#6f4b5a}
.wa-home .wa-collection .wa-section-head{margin-bottom:3rpx}
.wa-home .wa-download{display:block;margin:0 auto;padding:10rpx 26rpx;min-height:44px;background:#b83b48;color:#fff;border-radius:14rpx}

.wa-home .wa-kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}
.wa-home .wa-kpi{min-width:0;text-align:left;align-items:flex-start;padding:18rpx}
.wa-home .wa-kpi-value{overflow-wrap:anywhere}
.wa-home .wa-kpi-caption{font-size:20rpx;color:#75555f}
.wa-home .wa-order-counts{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8rpx;margin-top:14rpx;border-top:1rpx solid #f3e5e9;padding-top:12rpx}
.wa-home .wa-order-count{display:flex;min-width:0;flex-direction:column;align-items:center;border-radius:12rpx;background:#fbf6f8;padding:8rpx 4rpx}
.wa-home .wa-order-count-value{font-size:24rpx;font-weight:650;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.wa-home .wa-order-count-label{font-size:20rpx;color:#75555f;text-align:center}

page{background:linear-gradient(180deg,#ffe4e8 0,#fff5f6 460rpx)}
