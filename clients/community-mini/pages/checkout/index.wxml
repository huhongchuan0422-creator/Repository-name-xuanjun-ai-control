<view><text>{{merchant}}</text><view wx:if="{{beforeAd}}">广告：{{beforeAd}}</view><view wx:if="{{commerceEnabled}}"><view><text>所属社区</text><input value="{{communityId}}" placeholder="社区编号" data-field="communityId" bindinput="inputCommunity"/><button bindtap="communityAction" data-operation="community_mine" disabled="{{pending}}">我的社区关系</button><button bindtap="communityAction" data-operation="community_leave" disabled="{{pending}}">退出当前社区</button><button bindtap="communityAction" data-operation="communities" disabled="{{pending}}">浏览已审核社区</button><view wx:for="{{communities}}" wx:key="id"><text>{{item.name}} · {{item.description}}</text><button bindtap="communityAction" data-operation="community_join" data-id="{{item.id}}" disabled="{{pending}}">确认加入此社区</button></view><button wx:if="{{communitiesMore}}" bindtap="communityAction" data-operation="communities" data-more="true" disabled="{{pending}}">下一页社区</button><input value="{{promotionCode}}" placeholder="社区推广码" data-field="promotionCode" bindinput="inputCommunity"/><button bindtap="communityAction" data-operation="promotion_redeem" disabled="{{pending}}">确认通过推广码加入社区</button><text>更换社区需先退出；已下单的社区归属保持不变。</text></view><text>个人中心 · {{userId}} · 客户编号 {{projectCustomerId}}</text><button bindtap="profileAction" data-operation="profile_read" disabled="{{pending}}">我的资料</button><input placeholder="昵称" value="{{nickname}}" data-field="nickname" bindinput="inputProfile"/><input placeholder="联系方式" value="{{profileContact}}" data-field="profileContact" bindinput="inputProfile"/><button bindtap="profileAction" data-operation="profile_update" disabled="{{pending}}">保存资料</button><input placeholder="推荐码" value="{{referralCode}}" data-field="referralCode" bindinput="inputProfile"/><button bindtap="profileAction" data-operation="referral_code" disabled="{{pending}}">我的推荐码</button><button bindtap="profileAction" data-operation="referral_bind" disabled="{{pending}}">确认绑定推荐人</button><button bindtap="profileAction" data-operation="notices" disabled="{{pending}}">我的通知</button><view wx:for="{{notices}}" wx:key="id"><text>{{item.message}}</text></view><button bindtap="reloadProducts" disabled="{{pending}}">刷新商品与库存</button><button bindtap="loadOrders" disabled="{{pending}}">我的订单与消费记录</button><view wx:for="{{orders}}" wx:key="reference"><text>{{item.reference}} · {{item.order.amount_minor}}分 · {{item.order.state}}</text><button bindtap="selectOrder" data-reference="{{item.reference}}" disabled="{{pending}}">打开此订单</button></view><button wx:if="{{ordersMore}}" bindtap="loadOrders" data-more="true" disabled="{{pending}}">下一页订单</button><view wx:for="{{products}}" wx:key="item_id"><text>{{item.name}} · {{item.unit_minor}}分</text><input type="number" value="{{item.quantity}}" data-id="{{item.item_id}}" bindinput="quantity" disabled="{{!item.available||pending}}"/></view></view><input wx:if="{{!commerceEnabled}}" placeholder="金额（整数分）" type="number" value="{{amount}}" bindinput="inputAmount"/><input placeholder="订单编号" value="{{reference}}" bindinput="inputReference"/><button bindtap="checkout" disabled="{{pending}}">{{commerceEnabled?'提交商品订单':paymentsEnabled?'创建订单':'创建模拟订单'}}</button><view wx:if="{{paymentsEnabled}}"><button bindtap="pay" disabled="{{pending}}">微信支付</button><button bindtap="recoverPayment" disabled="{{pending}}">恢复原支付单</button><button bindtap="queryPayment" disabled="{{pending}}">查询微信支付结果</button></view><button wx:if="{{!paymentsEnabled}}" bindtap="refresh">查询服务端状态</button><view>{{status}}</view><view wx:if="{{afterAd}}">{{afterAdVerified?'微信支付已核验成功页广告':'模拟成功页广告'}}：{{afterAd}}</view><view wx:if="{{commerceEnabled}}"><button bindtap="cancelOrder" disabled="{{pending}}">取消未付款订单 / 恢复原关单</button><text>退款申请</text><input placeholder="退款申请编号（首次自动生成）" value="{{refundApplication}}" data-field="refundApplication" bindinput="inputRefund"/><input type="number" placeholder="申请退款金额（分）" value="{{refundAmount}}" data-field="refundAmount" bindinput="inputRefund"/><input placeholder="退款原因" value="{{refundReason}}" data-field="refundReason" bindinput="inputRefund"/><button bindtap="requestRefund" disabled="{{pending}}">提交退款申请</button><button bindtap="refundStatus" disabled="{{pending}}">查询原退款申请</button></view><text>真实支付须由服务端明确开通并绑定商户和原订单；模拟订单、微信查单与财务核销分别显示。</text></view>
