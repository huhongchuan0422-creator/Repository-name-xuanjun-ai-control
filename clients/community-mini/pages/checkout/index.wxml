<view><text>{{merchant}}</text><view wx:if="{{beforeAd}}">广告：{{beforeAd}}</view><input placeholder="金额（整数分）" type="number" value="{{amount}}" bindinput="inputAmount"/><input placeholder="订单编号" value="{{reference}}" bindinput="inputReference"/><button bindtap="checkout" disabled="{{pending}}">{{paymentsEnabled?'创建订单':'创建模拟订单'}}</button><view wx:if="{{paymentsEnabled}}"><button bindtap="pay" disabled="{{pending}}">微信支付</button><button bindtap="recoverPayment" disabled="{{pending}}">恢复原支付单</button><button bindtap="queryPayment" disabled="{{pending}}">查询微信支付结果</button></view><button wx:if="{{!paymentsEnabled}}" bindtap="refresh">查询服务端状态</button><view>{{status}}</view><view wx:if="{{afterAd}}">模拟成功页广告：{{afterAd}}</view><text>真实支付须由服务端明确开通并绑定商户和原订单；模拟订单、微信查单与财务核销分别显示。</text></view>
