<view><text>{{merchant}}</text><view wx:if="{{beforeAd}}">广告：{{beforeAd}}</view><view wx:if="{{commerceEnabled}}"><view><text>所属社区</text><input value="{{communityId}}" placeholder="社区编号" data-field="communityId" bindinput="inputCommunity"/><button bindtap="communityAction" data-operation="community_mine" disabled="{{pending}}">我的社区关系</button><button bindtap="communityAction" data-operation="community_leave" disabled="{{pending}}">退出当前社区</button><button bindtap="communityAction" data-operation="communities" disabled="{{pending}}">浏览已审核社区</button><view wx:for="{{communities}}" wx:key="id"><text>{{item.name}} · {{item.description}}</text><button bindtap="communityAction" data-operation="community_join" data-id="{{item.id}}" disabled="{{pending}}">确认加入此社区</button></view><button wx:if="{{communitiesMore}}" bindtap="communityAction" data-operation="communities" data-more="true" disabled="{{pending}}">下一页社区</button><input value="{{promotionCode}}" placeholder="社区推广码" data-field="promotionCode" bindinput="inputCommunity"/><button bindtap="communityAction" data-operation="promotion_redeem" disabled="{{pending}}">确认通过推广码加入社区</button><text>更换社区需先退出；已下单的社区归属保持不变。</text></view><view wx:if="{{commerceEnabled}}"><text>原客户项目中心：{{projectTitle}} · 客户编号 {{projectCustomerId}} · {{projectRole}} · {{projectState}}</text><button bindtap="projectAction" data-operation="project_summary" disabled="{{pending}}">读取我的项目</button><button bindtap="projectAction" data-operation="project_checklist" disabled="{{pending}}">资料准备与验收清单</button><view wx:for="{{projectChecklist}}" wx:key="id"><text>{{item.title||item.id}} · {{item.state}} · {{item.required?'必填':'选填'}} · {{item.submission_type}}</text><text>{{item.instructions}}</text><button wx:if="{{item.submission_type!='PRIVATE_DOCUMENT'}}" bindtap="selectProjectRequirement" data-item="{{item.id}}" data-revision="{{item.revision}}" disabled="{{pending}}">选择需求提交引用</button><button wx:if="{{item.submission_type=='PRIVATE_DOCUMENT'}}" bindtap="uploadProjectDocument" data-item="{{item.id}}" data-revision="{{item.revision}}" disabled="{{pending}}">选择并上传私有文件（PDF/PNG/JPEG，最多5MB）</button><button wx:if="{{item.state=='PARTIAL'||item.state=='NEEDS_CORRECTION'}}" bindtap="submitProjectItem" data-item="{{item.id}}" data-revision="{{item.revision}}" disabled="{{pending}}">提交当前材料版本审核</button></view><view wx:if="{{projectReferenceKind!='PRIVATE_DOCUMENT'}}"><text>材料引用：{{projectReferenceItem}} · 版本 {{projectReferenceRevision}}</text><text>原项目要求的引用类型：{{projectReferenceKind}}（不可手动更改）</text><input value="{{projectReference}}" placeholder="仅输入已签发引用编号，不输入密码或私钥" bindinput="inputProjectReference" disabled="{{pending}}"/><button bindtap="saveProjectReference" disabled="{{pending||!projectReferenceItem}}">保存受信任材料引用</button></view><textarea maxlength="4000" value="{{projectFeedback}}" placeholder="项目反馈或整改意见" bindinput="inputProject" disabled="{{pending}}"/><button bindtap="projectAction" data-operation="project_feedback" disabled="{{pending}}">提交项目反馈（归档，非即时答复）</button><button bindtap="projectAction" data-operation="project_messages" disabled="{{pending}}">读取原项目反馈历史</button><view wx:for="{{projectMessages}}" wx:key="id"><text>{{item.created}} · {{item.channel}} · {{item.status}}：{{item.body}}</text></view></view><text>个人中心 · {{userId}} · 客户编号 {{projectCustomerId}}</text><button bindtap="profileAction" data-operation="profile_read" disabled="{{pending}}">我的资料</button><input placeholder="昵称" value="{{nickname}}" data-field="nickname" bindinput="inputProfile"/><input placeholder="联系方式" value="{{profileContact}}" data-field="profileContact" bindinput="inputProfile"/><button bindtap="profileAction" data-operation="profile_update" disabled="{{pending}}">保存资料</button><input placeholder="推荐码" value="{{referralCode}}" data-field="referralCode" bindinput="inputProfile"/><button bindtap="profileAction" data-operation="referral_code" disabled="{{pending}}">我的推荐码</button><button bindtap="profileAction" data-operation="referral_bind" disabled="{{pending}}">确认绑定推荐人</button><button bindtap="profileAction" data-operation="notices" disabled="{{pending||noticePending}}">我的通知</button><text wx:if="{{noticeStatus}}">{{noticeStatus}}</text><view wx:for="{{notices}}" wx:key="id"><text>{{item.read?'已读':'未读'}} · {{item.message}}</text><button wx:if="{{!item.read}}" bindtap="markNoticeRead" data-id="{{item.id}}" disabled="{{pending||noticePending}}">标为已读</button></view><button wx:if="{{noticesMore}}" bindtap="loadNotices" data-more="true" disabled="{{pending||noticePending}}">加载更多通知</button><text wx:if="{{noticesLoaded&&!noticesMore}}">{{notices.length?'通知已全部加载':'暂无通知'}}</text><button bindtap="reloadProducts" disabled="{{pending}}">刷新商品与库存</button><button bindtap="loadOrders" disabled="{{pending}}">我的订单与消费记录</button><view wx:for="{{orders}}" wx:key="reference"><text>{{item.reference}} · {{item.order.amount_minor}}分 · {{item.order.state}}</text><button bindtap="selectOrder" data-reference="{{item.reference}}" disabled="{{pending}}">打开此订单</button></view><button bindtap="loadOrderDetails" disabled="{{pending||orderDetailsPending||!reference}}">读取当前订单商品明细</button><text wx:if="{{orderDetailsStatus}}">{{orderDetailsStatus}}</text><view wx:if="{{orderDetails}}"><text>原订单商品快照 · {{orderDetails.reference}}</text><view wx:for="{{orderDetails.lines}}" wx:key="item_id"><text>{{item.name}} · 商品版本{{item.revision}} · 数量{{item.quantity}} · 单价{{item.unit_minor}}分 · 小计{{item.subtotal_minor}}分</text></view><text>原订单总额{{orderDetails.amount_minor}}分（{{orderDetails.currency}}）</text><text>原订单状态：{{orderDetails.order_state}}；不作为支付核验或财务核销凭证</text><text>原履约记录：{{orderDetails.fulfillment_state||'暂无履约完成记录'}}{{orderDetails.fulfillment_revision!==null?' · 版本'+orderDetails.fulfillment_revision:''}}</text><text wx:if="{{orderDetails.completion_note}}">{{orderDetails.completion_note}}</text></view><button wx:if="{{ordersMore}}" bindtap="loadOrders" data-more="true" disabled="{{pending}}">下一页订单</button><view wx:for="{{products}}" wx:key="item_id"><text>{{item.name}} · {{item.unit_minor}}分</text><input type="number" value="{{item.quantity}}" data-id="{{item.item_id}}" bindinput="quantity" disabled="{{!item.available||pending}}"/></view></view><input wx:if="{{!commerceEnabled}}" placeholder="金额（整数分）" type="number" value="{{amount}}" bindinput="inputAmount"/><input placeholder="订单编号" value="{{reference}}" bindinput="inputReference"/><button bindtap="checkout" disabled="{{pending}}">{{commerceEnabled?'提交商品订单':paymentsEnabled?'创建订单':'创建模拟订单'}}</button><view wx:if="{{paymentsEnabled}}"><button bindtap="pay" disabled="{{pending}}">微信支付</button><button bindtap="recoverPayment" disabled="{{pending}}">恢复原支付单</button><button bindtap="queryPayment" disabled="{{pending}}">查询微信支付结果</button></view><button wx:if="{{!paymentsEnabled}}" bindtap="refresh">查询服务端状态</button><view>{{status}}</view><view wx:if="{{afterAd}}">{{afterAdVerified?'微信支付已核验成功页广告':'模拟成功页广告'}}：{{afterAd}}</view><view wx:if="{{commerceEnabled}}"><button bindtap="cancelOrder" disabled="{{pending}}">取消未付款订单 / 恢复原关单</button><text>退款申请</text><button bindtap="recoverRefundApplication" disabled="{{pending||refundRecoveryPending||!reference}}">读取当前订单原售后申请</button><text wx:if="{{refundRecoveryStatus}}">{{refundRecoveryStatus}}</text><text wx:if="{{refundRecoveryLoaded&&!refundCurrent}}">当前订单没有原售后申请</text><view wx:if="{{refundCurrent}}"><text>原申请{{refundCurrent.application_id}} · 版本{{refundCurrent.revision}} · 原状态{{refundCurrent.status}}</text><text>申请金额{{refundCurrent.amount_minor}}分 · 原因{{refundCurrent.reason}}</text><text>{{refundCurrent.opinion}}</text><text>读取原申请不会执行退款，申请状态不作为退款到账凭证。</text></view><input placeholder="退款申请编号（首次自动生成）" value="{{refundApplication}}" data-field="refundApplication" bindinput="inputRefund"/><input type="number" placeholder="申请退款金额（分）" value="{{refundAmount}}" data-field="refundAmount" bindinput="inputRefund"/><input placeholder="退款原因" value="{{refundReason}}" data-field="refundReason" bindinput="inputRefund"/><button bindtap="requestRefund" disabled="{{pending}}">提交退款申请</button><button bindtap="refundStatus" disabled="{{pending}}">查询原退款申请</button></view><text>真实支付须由服务端明确开通并绑定商户和原订单；模拟订单、微信查单与财务核销分别显示。</text></view>
