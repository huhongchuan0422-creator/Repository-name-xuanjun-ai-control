<view class="xj-nav"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view>
<view wx:if="{{viewMode==='recommendations'}}" class="page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="hero"><view class="service-top">社区服务 · 消费者</view><text class="title">平台推荐店铺</text><text class="subtitle">读取原范围门店记录，不虚构推荐或排名</text></view><view class="card"><text class="section-title">记录列表 · 当前范围</text><text>{{needsScene?'尚未选择门店':'当前门店服务'}}</text><text class="hint">推荐目录尚未开放，不展示虚构门店、资质或排名。</text><button bindtap="scanStore">扫码进入门店</button><button wx:if="{{!needsScene}}" bindtap="openRecommendation">查看当前门店介绍</button></view><view class="card"><text class="section-title">我是商家</text><text>无需已有门店，即可开始本人入驻申请。</text><button class="primary" bindtap="openMerchantJoin">商家入驻与进度</button></view></view>
<view wx:elif="{{viewMode==='store-detail'}}" class="page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="hero"><text class="title">{{selectedRecommendation.name||'门店资料'}}</text><text class="subtitle">门店介绍</text></view><view class="card"><text>{{selectedRecommendation.description||'门店资料尚未加载，请返回后重试。'}}</text><text class="hint">商家资质未核验；无正式资格不提供收款码，不代表商品可购买。</text><button bindtap="backRecommendations">返回推荐店铺</button></view></view>
<view wx:elif="{{viewMode==='orders'}}" class="page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="hero"><text class="title">我的订单</text><text class="subtitle">仅显示当前登录用户在当前授权场景可读取的订单；示例数据不会伪装为真实订单。</text></view><view class="card"><text wx:if="{{needsScene}}" class="section-title">选择门店后查看本人订单</text><text wx:if="{{!needsScene&&!commerceEnabled}}">订单服务未接通或尚未开通，当前不能读取真实订单。</text><button wx:if="{{needsScene}}" bindtap="scanStore">扫码进入门店</button><button wx:if="{{needsScene}}" bindtap="openMerchantJoin">商家入驻与进度</button><text wx:if="{{status}}">{{status}}</text><view wx:if="{{!orderDetails||detailsCollapsed}}"><button bindtap="loadOrders" disabled="{{pending||!sessionReady}}">读取本人订单</button><view wx:for="{{orders}}" wx:key="reference" class="order-row"><text>{{item.reference}} · {{item.order.amount_minor}}分 · {{item.order.state}}</text><button bindtap="selectOrder" data-reference="{{item.reference}}" disabled="{{pending||orderDetailsPending}}">查看详情</button></view><button wx:if="{{ordersMore}}" bindtap="loadOrders" data-more="true" disabled="{{pending||!sessionReady}}">下一页订单</button><text wx:if="{{commerceEnabled&&!orders.length}}">暂无本人可见订单或尚未查询。</text></view><view wx:if="{{orderDetails&&!detailsCollapsed}}" class="order-detail"><button bindtap="backToOrderList" disabled="{{pending||orderDetailsPending}}">返回本人订单列表</button><text>订单编号：{{orderDetails.reference}}</text><text>状态：{{orderDetails.order_state}}</text><text>金额：{{orderDetails.amount_minor}}分（{{orderDetails.currency}}）</text><text>支付证据：{{orderDetails.provider_payment_verified?'已核实':'未核实'}}</text><view wx:for="{{orderDetails.lines}}" wx:for-item="line" wx:key="item_id" class="order-line"><text>{{line.name}} · 数量 {{line.quantity}}</text><text>单价 {{line.unit_minor}}分 · 小计 {{line.subtotal_minor}}分</text></view><text wx:if="{{orderDetails.completion_note}}">履约备注：{{orderDetails.completion_note}}</text><text wx:if="{{orderDetailsStatus}}">{{orderDetailsStatus}}</text><text>本人订单原快照只读展示；不执行付款、退款或分账。</text></view><text wx:if="{{orderDetailsStatus&&!orderDetails}}">{{orderDetailsStatus}}</text></view></view>
<view wx:elif="{{viewMode==='services' && !needsScene && sessionReady}}" class="page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="hero"><text class="title">更多门店服务</text><text class="subtitle">沿用当前门店与本人权限；支付尚未开放</text></view><view class="card"><button bindtap="openMerchantJoin">商家入驻</button><button bindtap="openMerchant">商家工作台</button></view><button bindtap="openCustomerHome">客户首页</button><text>{{merchant}}</text><view wx:if="{{beforeAd}}">广告：{{beforeAd}}</view><view wx:if="{{commerceEnabled}}"><view><text>所属社区</text><input value="{{communityId}}" placeholder="社区编号" data-field="communityId" bindinput="inputCommunity"/><button bindtap="communityAction" data-operation="community_mine" disabled="{{pending}}">我的社区关系</button><button bindtap="communityAction" data-operation="community_leave" disabled="{{pending}}">退出当前社区</button><button bindtap="communityAction" data-operation="communities" disabled="{{pending}}">浏览已审核社区</button><view wx:for="{{communities}}" wx:key="id"><text>{{item.name}} · {{item.description}}</text><button bindtap="communityAction" data-operation="community_join" data-id="{{item.id}}" disabled="{{pending}}">确认加入此社区</button></view><button wx:if="{{communitiesMore}}" bindtap="communityAction" data-operation="communities" data-more="true" disabled="{{pending}}">下一页社区</button><input value="{{promotionCode}}" placeholder="社区推广码" data-field="promotionCode" bindinput="inputCommunity"/><button bindtap="communityAction" data-operation="promotion_redeem" disabled="{{pending}}">确认通过推广码加入社区</button><text>更换社区需先退出；已下单的社区归属保持不变。</text></view><text>个人中心 · {{userId}} · 客户编号 {{projectCustomerId}}</text><button bindtap="profileAction" data-operation="profile_read" disabled="{{pending}}">我的资料</button><input placeholder="昵称" value="{{nickname}}" data-field="nickname" bindinput="inputProfile"/><input placeholder="联系方式" value="{{profileContact}}" data-field="profileContact" bindinput="inputProfile"/><button bindtap="profileAction" data-operation="profile_update" disabled="{{pending}}">保存资料</button><input placeholder="推荐码" value="{{referralCode}}" data-field="referralCode" bindinput="inputProfile"/><button bindtap="profileAction" data-operation="referral_code" disabled="{{pending}}">我的推荐码</button><button bindtap="profileAction" data-operation="referral_bind" disabled="{{pending}}">确认绑定推荐人</button><button bindtap="profileAction" data-operation="notices" disabled="{{pending||noticePending}}">我的通知</button><text wx:if="{{noticeStatus}}">{{noticeStatus}}</text><view wx:for="{{notices}}" wx:key="id"><text>{{item.read?'已读':'未读'}} · {{item.message}}</text><button wx:if="{{!item.read}}" bindtap="markNoticeRead" data-id="{{item.id}}" disabled="{{pending||noticePending}}">标为已读</button></view><button wx:if="{{noticesMore}}" bindtap="loadNotices" data-more="true" disabled="{{pending||noticePending}}">加载更多通知</button><text wx:if="{{noticesLoaded&&!noticesMore}}">{{notices.length?'通知已全部加载':'暂无通知'}}</text><button bindtap="reloadProducts" disabled="{{pending||productsPending}}">刷新商品与库存</button><text wx:if="{{productsStatus}}">{{productsStatus}}</text><button bindtap="loadOrders" disabled="{{pending}}">我的订单与消费记录</button><view wx:for="{{orders}}" wx:key="reference"><text>{{item.reference}} · {{item.order.amount_minor}}分 · {{item.order.state}}</text><button bindtap="selectOrder" data-reference="{{item.reference}}" disabled="{{pending}}">打开此订单</button></view><button bindtap="loadOrderDetails" disabled="{{pending||orderDetailsPending||!reference}}">读取当前订单商品明细</button><text wx:if="{{orderDetailsStatus}}">{{orderDetailsStatus}}</text><view wx:if="{{orderDetails}}"><text>原订单商品快照 · {{orderDetails.reference}}</text><view wx:for="{{orderDetails.lines}}" wx:key="item_id"><text>{{item.name}} · 商品版本{{item.revision}} · 数量{{item.quantity}} · 单价{{item.unit_minor}}分 · 小计{{item.subtotal_minor}}分</text></view><text>原订单总额{{orderDetails.amount_minor}}分（{{orderDetails.currency}}）</text><text>原订单状态：{{orderDetails.order_state}}；不作为支付核验或财务核销凭证</text><text>原履约记录：{{orderDetails.fulfillment_state||'暂无履约完成记录'}}{{orderDetails.fulfillment_revision!==null?' · 版本'+orderDetails.fulfillment_revision:''}}</text><text wx:if="{{orderDetails.completion_note}}">{{orderDetails.completion_note}}</text></view><button wx:if="{{ordersMore}}" bindtap="loadOrders" data-more="true" disabled="{{pending}}">下一页订单</button><view wx:for="{{products}}" wx:key="item_id"><text>{{item.name}} · {{item.unit_minor}}分</text><input type="number" value="{{item.quantity}}" data-id="{{item.item_id}}" bindinput="quantity" disabled="{{!item.available||pending||productsPending}}"/></view></view><input wx:if="{{!commerceEnabled}}" placeholder="金额（整数分）" type="number" value="{{amount}}" bindinput="inputAmount"/><input placeholder="订单编号" value="{{reference}}" bindinput="inputReference"/><button wx:if="{{commerceEnabled&&productsMore}}" bindtap="reloadProducts" data-more="true" disabled="{{pending||productsPending}}">加载更多商品</button><button bindtap="checkout" disabled="{{pending||productsPending}}">{{commerceEnabled?'提交商品订单':paymentsEnabled?'创建订单':'创建模拟订单'}}</button><button wx:if="{{commerceEnabled}}" bindtap="recoverPurchase" disabled="{{pending||!reference}}">恢复原商品订单（不重新占库存）</button><text wx:if="{{commerceEnabled}}">下单结果未知或重开后，先从我的订单选择原编号，再恢复原商品订单；商品价格及库存变更不会重新计算原订单。</text><view wx:if="{{paymentsEnabled}}"><button bindtap="pay" disabled="{{pending}}">微信支付</button><button bindtap="recoverPayment" disabled="{{pending}}">恢复原支付单</button><button bindtap="queryPayment" disabled="{{pending}}">查询微信支付结果</button></view><button wx:if="{{!paymentsEnabled}}" bindtap="refresh">查询服务端状态</button><view>{{status}}</view><view wx:if="{{afterAd}}">{{afterAdVerified?'微信支付已核验成功页广告':'模拟成功页广告'}}：{{afterAd}}</view><view wx:if="{{commerceEnabled}}"><button bindtap="cancelOrder" disabled="{{pending}}">取消未付款订单 / 恢复原关单</button><text>退款申请</text><button bindtap="recoverRefundApplication" disabled="{{pending||refundRecoveryPending||!reference}}">读取当前订单原售后申请</button><text wx:if="{{refundRecoveryStatus}}">{{refundRecoveryStatus}}</text><text wx:if="{{refundRecoveryLoaded&&!refundCurrent}}">当前订单没有原售后申请</text><view wx:if="{{refundCurrent}}"><text>原申请{{refundCurrent.application_id}} · 版本{{refundCurrent.revision}} · 原状态{{refundCurrent.status}}</text><text>申请金额{{refundCurrent.amount_minor}}分 · 原因{{refundCurrent.reason}}</text><text>{{refundCurrent.opinion}}</text><text>读取原申请不会执行退款，申请状态不作为退款到账凭证。</text></view><input placeholder="退款申请编号（首次自动生成）" value="{{refundApplication}}" data-field="refundApplication" bindinput="inputRefund"/><input type="number" placeholder="申请退款金额（分）" value="{{refundAmount}}" data-field="refundAmount" bindinput="inputRefund"/><input placeholder="退款原因" value="{{refundReason}}" data-field="refundReason" bindinput="inputRefund"/><button bindtap="requestRefund" disabled="{{pending}}">提交退款申请</button><button bindtap="refundStatus" disabled="{{pending}}">查询原退款申请</button></view><text>支付功能尚未开放；订单状态以服务端记录为准，不代表已付款。</text></view>

<view wx:elif="{{viewMode==='services'}}" class="page" style="padding-bottom:180rpx;"><view class="hero"><text class="title">更多门店服务</text><text class="subtitle">社区归属与推荐关系</text></view><view class="card"><text class="section-title">选择门店后继续</text><text class="description">{{status}}</text><button bindtap="scanStore">扫码选择门店</button><button class="primary" bindtap="openMerchantJoin">商家入驻与进度</button><button bindtap="openCustomerHome">返回首页</button></view></view>
