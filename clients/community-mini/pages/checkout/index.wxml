<view class="xj-nav"><button class="nav-item {{activeSection==='home'?'is-active':''}}" data-section="home" bindtap="navigateSection"><view class="nav-icon icon-home"></view><text>首页</text></button><button class="nav-item {{activeSection==='recommendations'?'is-active':''}}" data-section="recommendations" bindtap="navigateSection"><view class="nav-icon icon-recommendations"></view><text>推荐</text></button><button class="nav-item {{activeSection==='orders'?'is-active':''}}" data-section="orders" bindtap="navigateSection"><view class="nav-icon icon-orders"></view><text>订单</text></button><button class="nav-item {{activeSection==='profile'?'is-active':''}}" data-section="profile" bindtap="navigateSection"><view class="nav-icon icon-profile"></view><text>我的</text></button></view>
<view wx:if="{{viewMode==='recommendations'}}" class="page recommendations-page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="hero"><text class="title">发现邻里好店</text><text class="subtitle">看看身边的店，发现社区里的日常美好</text></view><view wx:if="{{!sessionReady}}" class="card"><text>{{status}}</text><button bindtap="openCustomerHome">返回首页登录</button></view><scroll-view scroll-x class="industry-tabs"><button data-id="" bindtap="chooseCategory" class="{{!categoryId?'selected':''}}">全部</button><button wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseCategory" class="{{categoryId===item.id?'selected':''}}">{{item.name}}</button></scroll-view><view wx:if="{{directoryState==='LOADING'}}" class="card">正在查找店铺…</view><view wx:if="{{directoryState==='NOT_QUERIED'}}" class="card"><text>店铺列表尚未读取</text><button bindtap="loadDirectory">查看店铺</button></view><view wx:if="{{directoryState==='FAILED'}}" class="card"><text>店铺暂时未能加载，请重试</text><text class="hint">{{directoryError}}</text><button bindtap="loadDirectory">重新加载</button></view><view wx:if="{{directoryState==='READY'&&!directory.length&&!directoryMore}}" class="card empty-state"><text class="section-title">{{categoryId?'这个分类暂无店铺':'暂无已发布店铺'}}</text><text class="hint">这里只展示当前访问范围内已审核并公开的店铺。</text></view><view wx:if="{{demoStore&&demoState==='VISIBLE'&&!categoryId}}" class="card shop-card demo-card" data-id="{{demoStore.id}}" bindtap="openRecommendation"><text class="demo-badge">虚拟商家·展示用</text><image wx:if="{{!demoPhotoFailed}}" class="shop-photo-placeholder" src="{{demoImagePath}}" mode="aspectFill" binderror="demoImageError"/><view wx:else class="shop-photo-placeholder">展示图片暂不可用</view><view class="shop-copy"><text class="section-title">{{demoStore.name}}</text><text class="shop-category">{{demoStore.category_name}}</text><text class="description">{{demoStore.description}}</text><text class="hint">仅展示 · 不提供下单或支付</text><text class="text-link">查看展示详情 ›</text></view></view><view wx:for="{{directory}}" wx:key="id" class="card shop-card" data-id="{{item.id}}" bindtap="openRecommendation"><view class="shop-photo-placeholder"><text>门店图片待提供</text></view><view class="shop-copy"><text class="section-title">{{item.name}}</text><text class="shop-category">{{item.category_name||'未分类'}}</text><text class="description">{{item.description||'商家暂未填写介绍'}}</text><text class="text-link">看看这家店 ›</text></view></view><text wx:if="{{directoryState==='READY'&&!directory.length&&directoryMore}}" class="hint">当前页暂无店铺，还有记录待查询</text><button wx:if="{{directoryMore}}" bindtap="loadDirectory" data-more="true" disabled="{{directoryState==='LOADING'}}">更多店铺</button></view>
<view wx:elif="{{viewMode==='store-detail'}}" class="page" style="padding-bottom:180rpx;box-sizing:border-box;"><button class="text-link" bindtap="backRecommendations">‹ 返回店铺列表</button><view wx:if="{{detailState==='LOADING'}}" class="card">正在加载店铺资料…</view><view wx:elif="{{detailState==='READY'&&selectedRecommendation}}"><view wx:if="{{selectedRecommendation.is_demo}}" class="demo-detail"><text class="demo-badge">虚拟商家·展示用</text><image wx:if="{{!demoPhotoFailed}}" class="detail-photo" src="{{demoImagePath}}" mode="aspectFill" binderror="demoImageError"/><view wx:else class="shop-photo-placeholder detail-photo">展示图片暂不可用</view><text class="hint">虚拟展示，不代表真实已入驻商家，不提供下单或支付。</text></view><view wx:else class="shop-photo-placeholder detail-photo">门店图片待提供</view><view class="hero"><text class="title">{{selectedRecommendation.name}}</text><text class="subtitle">{{selectedRecommendation.category_name||'未分类'}}</text></view><view class="card"><text class="section-title">关于这家店</text><text class="description">{{selectedRecommendation.description||'商家暂未填写介绍'}}</text><text class="hint">当前仅展示门店介绍，商品与支付尚未开放。</text></view></view><view wx:else class="card"><text>店铺资料暂不可用，请返回列表刷新。</text><text class="hint">{{directoryError}}</text></view></view>
<view wx:elif="{{viewMode==='orders'}}" class="page" style="padding-bottom:180rpx;box-sizing:border-box;"><view class="hero"><text class="title">我的订单</text><text class="subtitle">查看您在本系统内的订单与售后</text></view><view class="card"><text wx:if="{{ordersState==='NOT_QUERIED'}}">尚未查询订单</text><text wx:if="{{ordersState==='LOADING'}}">正在读取您的订单…</text><view wx:if="{{ordersState==='FAILED'}}"><text>订单读取失败，请重试</text><text class="hint">{{ordersError}}</text></view><view wx:if="{{!orderDetails||detailsCollapsed}}"><view class="filter-pills"><button data-filter="all" class="{{orderFilter==='all'?'active':''}}" bindtap="chooseOrderFilter">全部</button><button data-filter="pending" class="{{orderFilter==='pending'?'active':''}}" bindtap="chooseOrderFilter">待处理</button><button data-filter="completed" class="{{orderFilter==='completed'?'active':''}}" bindtap="chooseOrderFilter">已完成</button></view><text class="hint">筛选仅作用当前已读取页；未知状态保留在全部列表。</text><button bindtap="loadOrders" disabled="{{pending||!sessionReady}}">读取本人订单</button><block wx:for="{{orders}}" wx:key="key"><view wx:if="{{orderFilter==='all'||orderFilter==='completed'&&item.order.state==='COMPLETED'||orderFilter==='pending'&&(item.order.state==='CREATED'||item.order.state==='PENDING')}}" class="order-row"><text>{{item.reference}} · {{item.order.amount_minor}}分 · {{item.order.state}}</text><button bindtap="selectOrder" data-reference="{{item.reference}}" data-scene="{{item.scene}}" disabled="{{pending||orderDetailsPending}}">查看详情</button></view></block><button wx:if="{{ordersMore}}" bindtap="loadOrders" data-more="true" disabled="{{pending||!sessionReady}}">下一页订单</button><text wx:if="{{ordersState==='READY'&&!orders.length}}" class="empty-state">暂无订单</text><text wx:if="{{ordersState==='PARTIAL'&&!orders.length}}" class="hint">当前页暂无订单，仍有记录待查询</text><text wx:if="{{orders.length&&!visibleOrderCount}}" class="hint">本页没有符合当前筛选的订单。</text></view><view wx:if="{{orderDetails&&!detailsCollapsed}}" class="order-detail"><button bindtap="backToOrderList" disabled="{{pending||orderDetailsPending}}">返回本人订单列表</button><text>订单编号：{{orderDetails.reference}}</text><text>状态：{{orderDetails.order_state}}</text><text>金额：{{orderDetails.amount_minor}}分（{{orderDetails.currency}}）</text><text>支付证据：{{orderDetails.provider_payment_verified?'已核实':'未核实'}}</text><view wx:for="{{orderDetails.lines}}" wx:for-item="line" wx:key="item_id" class="order-line"><text>{{line.name}} · 数量 {{line.quantity}}</text><text>单价 {{line.unit_minor}}分 · 小计 {{line.subtotal_minor}}分</text></view><text wx:if="{{orderDetails.completion_note}}">履约备注：{{orderDetails.completion_note}}</text><text wx:if="{{orderDetailsStatus}}">{{orderDetailsStatus}}</text><text>本人订单原快照只读展示；不执行付款、退款或分账。</text><button class="text-link" data-view="payment" bindtap="openService" disabled="{{pending}}">支付与原订单恢复</button><button class="text-link" data-view="refund" bindtap="openService" disabled="{{pending}}">退款申请与查询</button><button bindtap="cancelOrder" disabled="{{pending||!reference}}">取消未付款订单 / 恢复原关单</button></view><text wx:if="{{orderDetailsStatus&&!orderDetails}}">{{orderDetailsStatus}}</text></view></view>
<view wx:elif="{{viewMode==='services' && !needsScene && sessionReady}}" class="page services-page" style="padding-bottom:180rpx;box-sizing:border-box;">
<button wx:if="{{serviceView!=='home'}}" class="text-link" bindtap="backServices" disabled="{{pending}}">‹ 返回更多服务</button><view class="hero"><text class="title">{{serviceTitles[serviceView]}}</text><text class="subtitle">当前门店与本人权限范围</text></view>
<view wx:if="{{serviceView==='home'}}"><view class="card entry-group"><button class="service-link" data-view="community" bindtap="openService"><text class="entry-title">社区与归属</text><text class="hint">查看、加入、退出与推广码 ›</text></button><button class="service-link" data-view="referral" bindtap="openService"><text class="entry-title">推荐关系</text><text class="hint">我的推荐码 / 绑定推荐人 ›</text></button><button class="service-link" bindtap="openOrders"><text class="entry-title">订单与售后</text><text class="hint">原订单、退款申请与进度 ›</text></button><button class="service-link" data-view="payment" bindtap="openService"><text class="entry-title">支付与订单恢复</text><text class="hint">按原编号查询，不重复下单 ›</text></button></view><button class="text-link" data-view="products" bindtap="openService">门店商品与服务</button><button class="text-link" data-view="legacy-profile" bindtap="openService">当前门店个人资料</button><button class="text-link" data-view="legacy-notices" bindtap="openService">当前门店通知</button><button class="text-link" bindtap="scanStore">切换门店范围</button><button class="text-link" bindtap="openCustomerHome">客户首页</button></view>
<view wx:if="{{!commerceEnabled&&serviceView!=='home'&&serviceView!=='checkout'&&serviceView!=='payment'}}" class="card"><text>此门店尚未接通对应业务，不能读取或提交记录。</text></view>
<view wx:if="{{commerceEnabled}}">
<view wx:if="{{serviceView==='community'}}"><view class="card record-card"><text class="section-title">本人社区关系</text><text>{{communityRelation?(communityRelation.active?communityRelation.community_id:'当前未加入社区'):'尚未读取真实归属'}}</text><button bindtap="communityAction" data-operation="community_mine" disabled="{{pending}}">读取我的社区关系</button></view><view class="card entry-group"><button class="service-link" data-view="community-list" bindtap="openService">浏览已审核社区 ›</button><button class="service-link" data-view="community-code" bindtap="openService">通过推广码加入 ›</button></view><label>当前社区编号<input value="{{communityId}}" placeholder="先读取本人社区关系" data-field="communityId" bindinput="inputCommunity"/></label><button bindtap="communityAction" data-operation="community_leave" disabled="{{pending||!communityId}}">退出当前社区</button><text class="hint">更换社区需先退出；已下单的社区归属保持不变。</text></view>
<view wx:if="{{serviceView==='community-list'}}"><button class="secondary" bindtap="communityAction" data-operation="communities" disabled="{{pending}}">读取已审核社区</button><view wx:for="{{communities}}" wx:key="id" class="card"><text class="section-title">{{item.name}}</text><text class="hint">{{item.description}}</text><button class="text-link" data-id="{{item.id}}" bindtap="openCommunityDetails" disabled="{{pending}}">查看社区详情 ›</button></view><text class="hint" wx:if="{{!communities.length}}">尚未查询到可显示的社区</text><button wx:if="{{communitiesMore}}" bindtap="communityAction" data-operation="communities" data-more="true" disabled="{{pending}}">下一页社区</button></view>
<view wx:if="{{serviceView==='community-detail'&&selectedCommunity}}"><view class="card record-card"><text class="section-title">{{selectedCommunity.name}}</text><text class="field-label">社区介绍</text><text>{{selectedCommunity.description}}</text><text class="field-label">您的归属</text><text>{{communityRelation?(communityRelation.active?communityRelation.community_id:'当前未加入社区'):'尚未读取'}}</text></view><button class="primary" bindtap="communityAction" data-operation="community_join" data-id="{{selectedCommunity.id}}" disabled="{{pending}}">确认加入此社区</button><button class="text-link" data-view="community-list" bindtap="openService">返回社区列表</button></view>
<view wx:if="{{serviceView==='community-detail'&&!selectedCommunity}}" class="card"><text>社区记录已失效或尚未读取，请返回列表重新查询。</text><button class="text-link" data-view="community-list" bindtap="openService">返回社区列表</button></view>
<view wx:if="{{serviceView==='community-code'}}"><view class="card form-card"><label>社区推广码<input value="{{promotionCode}}" placeholder="请输入社区推广码" data-field="promotionCode" bindinput="inputCommunity"/></label></view><button class="primary" bindtap="communityAction" data-operation="promotion_redeem" disabled="{{pending}}">核对并加入</button></view>
<view wx:if="{{serviceView==='referral'}}"><view class="card record-card"><text class="section-title">我的推荐码</text><text>{{ownReferralCode||'尚未读取本人推荐码'}}</text><button bindtap="profileAction" data-operation="referral_code" disabled="{{pending}}">读取我的推荐码</button><text class="hint">读取结果与绑定操作分别核实；不凭本地输入认定已绑定。</text></view><view class="card form-card"><label>推荐码<input placeholder="请输入推荐人的代码" value="{{referralCode}}" data-field="referralCode" bindinput="inputProfile"/></label></view><button class="primary" bindtap="profileAction" data-operation="referral_bind" disabled="{{pending}}">确认绑定推荐人</button><text class="hint">沿原防自绑定、重复绑定与循环规则核验。</text></view>
<view wx:if="{{serviceView==='products'}}"><view wx:for="{{products}}" wx:key="item_id" class="card product-card"><text class="section-title">{{item.name}}</text><text>{{item.unit_minor}} 分</text><label>数量<input type="number" value="{{item.quantity}}" data-id="{{item.item_id}}" bindinput="quantity" disabled="{{!item.available||pending||productsPending}}"/></label></view><button bindtap="reloadProducts" disabled="{{pending||productsPending}}">刷新商品与库存</button><text class="hint">{{productsStatus}}</text><button wx:if="{{productsMore}}" bindtap="reloadProducts" data-more="true" disabled="{{pending||productsPending}}">加载更多商品</button><button class="primary" data-view="checkout" bindtap="openService" disabled="{{pending||productsPending}}">核对订单</button><text class="hint">商品价格、库存与版本以原服务端为准。</text></view>
<view wx:if="{{serviceView==='refund'||serviceView==='refund-detail'}}"><text class="hint">当前订单：{{reference||'尚未选择订单'}}</text><button bindtap="recoverRefundApplication" disabled="{{pending||refundRecoveryPending||!reference}}">读取当前订单原售后申请</button><text class="hint">{{refundRecoveryStatus}}</text><view class="card" wx:if="{{refundRecoveryLoaded&&!refundCurrent}}"><text>当前订单没有原售后申请</text></view><view class="card record-card" wx:if="{{refundCurrent}}"><text class="field-label">原申请编号</text><text>{{refundCurrent.application_id}}</text><text class="field-label">版本与原状态</text><text>{{refundCurrent.revision}} · {{refundCurrent.status}}</text><text class="field-label">申请金额与原因</text><text>{{refundCurrent.amount_minor}} 分 · {{refundCurrent.reason}}</text><text class="field-label">处理意见</text><text>{{refundCurrent.opinion}}</text></view><view wx:if="{{serviceView==='refund'}}" class="card form-card"><label>退款申请编号<input placeholder="首次自动生成" value="{{refundApplication}}" data-field="refundApplication" bindinput="inputRefund"/></label><label>申请退款金额（分）<input type="number" value="{{refundAmount}}" data-field="refundAmount" bindinput="inputRefund"/></label><label>退款原因<input value="{{refundReason}}" data-field="refundReason" bindinput="inputRefund"/></label><button class="primary" bindtap="requestRefund" disabled="{{pending||!reference}}">提交退款申请</button></view><button bindtap="refundStatus" disabled="{{pending||!reference}}">查询原退款申请</button><button wx:if="{{serviceView==='refund'}}" class="text-link" data-view="refund-detail" bindtap="openService">查看售后进度</button><button wx:else class="text-link" data-view="refund" bindtap="openService">返回售后申请</button><text class="hint">读取原申请不会执行退款。申请、审核与实际退款分别确认；申请状态不等于退款到账。</text></view>
<view wx:if="{{serviceView==='legacy-profile'}}" class="card form-card"><text>个人中心 · {{userId}} · 客户编号 {{projectCustomerId}}</text><button bindtap="profileAction" data-operation="profile_read" disabled="{{pending}}">我的资料</button><label>昵称<input value="{{nickname}}" data-field="nickname" bindinput="inputProfile"/></label><label>联系方式<input value="{{profileContact}}" data-field="profileContact" bindinput="inputProfile"/></label><button bindtap="profileAction" data-operation="profile_update" disabled="{{pending}}">保存资料</button></view>
<view wx:if="{{serviceView==='legacy-notices'}}"><button bindtap="profileAction" data-operation="notices" disabled="{{pending||noticePending}}">我的通知</button><text class="hint">{{noticeStatus}}</text><view wx:for="{{notices}}" wx:key="id" class="card"><text>{{item.read?'已读':'未读'}} · {{item.message}}</text><button wx:if="{{!item.read}}" bindtap="markNoticeRead" data-id="{{item.id}}" disabled="{{pending||noticePending}}">标为已读</button></view><button wx:if="{{noticesMore}}" bindtap="loadNotices" data-more="true" disabled="{{pending||noticePending}}">加载更多通知</button><text wx:if="{{noticesLoaded&&!noticesMore}}">{{notices.length?'通知已全部加载':'暂无通知'}}</text></view>
</view>
<view wx:if="{{serviceView==='checkout'}}"><view class="card record-card"><text class="section-title">{{merchant||'当前门店'}}</text><block wx:for="{{products}}" wx:key="item_id"><view wx:if="{{item.quantity}}"><text>{{item.name}} · {{item.quantity}} 件 · 单价 {{item.unit_minor}} 分</text></view></block><text class="hint">最终金额与库存由服务端核验，不以本地合计作为支付依据。</text></view><view class="card form-card"><label>订单编号<input value="{{reference}}" bindinput="inputReference" placeholder="填写原订单编号或新订单编号"/></label><label wx:if="{{!commerceEnabled}}">金额（整数分）<input type="number" value="{{amount}}" bindinput="inputAmount"/></label></view><button class="primary" bindtap="checkout" disabled="{{pending||productsPending}}">{{commerceEnabled?'提交商品订单':paymentsEnabled?'创建订单':'创建模拟订单'}}</button><button class="text-link" data-view="payment" bindtap="openService">已有订单，恢复原单</button></view>
<view wx:if="{{serviceView==='payment'}}"><view class="card form-card"><label>原订单编号<input value="{{reference}}" bindinput="inputReference" placeholder="请输入原订单编号"/></label></view><view wx:if="{{beforeAd}}" class="hint">广告：{{beforeAd}}</view><button wx:if="{{commerceEnabled}}" bindtap="recoverPurchase" disabled="{{pending||!reference}}">恢复原商品订单（不重新占库存）</button><button wx:if="{{commerceEnabled}}" bindtap="loadOrderDetails" disabled="{{pending||orderDetailsPending||!reference}}">读取当前订单商品明细</button><view class="card record-card" wx:if="{{orderDetails}}"><text>原订单商品快照 · {{orderDetails.reference}}</text><view wx:for="{{orderDetails.lines}}" wx:key="item_id"><text>{{item.name}} · 商品版本{{item.revision}} · 数量{{item.quantity}} · 单价{{item.unit_minor}}分 · 小计{{item.subtotal_minor}}分</text></view><text>原订单总额{{orderDetails.amount_minor}}分（{{orderDetails.currency}}）</text><text>原订单状态：{{orderDetails.order_state}}；不作为支付核验或财务核销凭证</text><text>履约记录：{{orderDetails.fulfillment_state||'暂无履约完成记录'}}{{orderDetails.fulfillment_revision!==null?' · 版本'+orderDetails.fulfillment_revision:''}}</text><text>{{orderDetails.completion_note}}</text></view><text class="hint">{{orderDetailsStatus}}</text><view wx:if="{{paymentsEnabled}}"><button class="primary" bindtap="pay" disabled="{{pending}}">微信支付</button><button bindtap="recoverPayment" disabled="{{pending}}">恢复原支付单</button><button bindtap="queryPayment" disabled="{{pending}}">查询微信支付结果</button></view><button wx:if="{{!paymentsEnabled}}" bindtap="refresh">查询服务端状态</button><button wx:if="{{commerceEnabled}}" bindtap="cancelOrder" disabled="{{pending||!reference}}">取消未付款订单 / 恢复原关单</button><button wx:if="{{commerceEnabled}}" class="text-link" data-view="refund" bindtap="openService">退款申请与查询</button><text class="hint">结果未知先恢复原单，不重新占库存，不重算原价格。</text><text wx:if="{{!paymentsEnabled}}" class="hint">支付功能尚未开放；订单状态不代表已付款。</text><view wx:if="{{afterAd}}" class="hint">{{afterAdVerified?'微信支付已核验成功页广告':'模拟成功页广告'}}：{{afterAd}}</view></view>
<text class="status" aria-live="polite">{{status}}</text>
</view>
<view wx:elif="{{viewMode==='services'}}" class="page" style="padding-bottom:180rpx;"><view class="hero"><text class="title">更多社区服务</text><text class="subtitle">选择已授权的服务范围，查看社区与门店服务</text></view><view wx:if="{{contextsState==='LOADING'}}" class="card">正在读取服务范围…</view><view wx:if="{{contextsState==='FAILED'}}" class="card"><text>服务范围读取失败</text><text class="hint">{{contextsError}}</text><button bindtap="loadContexts">重新加载</button></view><view wx:if="{{contextsState==='NOT_QUERIED'}}" class="card"><button bindtap="loadContexts">查看可用服务</button></view><view wx:if="{{contextsState==='READY'&&!contexts.length}}" class="card"><text>暂无已授权的社区服务</text><text class="hint">加入社区或获得门店授权后，相应服务将在这里显示。</text></view><view wx:for="{{contexts}}" wx:key="scene" class="card"><text class="section-title">{{item.merchant.name||'已授权服务范围'}}</text><text class="description">{{item.merchant.description}}</text><button data-scene="{{item.scene}}" bindtap="selectContext">进入社区与门店服务</button></view><button class="text-link" bindtap="openOrders">我的订单</button><button class="text-link" bindtap="openCustomerHome">返回首页</button></view>
