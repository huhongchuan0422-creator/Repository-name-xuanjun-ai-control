<view><text>{{merchant}}</text><view wx:if="{{beforeAd}}">广告：{{beforeAd}}</view><view wx:if="{{commerceEnabled}}"><button bindtap="reloadProducts" disabled="{{pending}}">刷新商品与库存</button><button bindtap="loadOrders" disabled="{{pending}}">我的订单与消费记录</button><view wx:for="{{orders}}" wx:key="reference"><text>{{item.reference}} · {{item.order.amount_minor}}分 · {{item.order.state}}</text><button bindtap="selectOrder" data-reference="{{item.reference}}" disabled="{{pending}}">打开此订单</button></view><button wx:if="{{ordersMore}}" bindtap="loadOrders" data-more="true" disabled="{{pending}}">下一页订单</button><view wx:for="{{products}}" wx:key="item_id"><text>{{item.name}} · {{item.unit_minor}}分</text><input type="number" value="{{item.quantity}}" data-id="{{item.item_id}}" bindinput="quantity" disabled="{{!item.available||pending}}"/></view></view><input wx:if="{{!commerceEnabled}}" placeholder="金额（整数分）" type="number" value="{{amount}}" bindinput="inputAmount"/><input placeholder="订单编号" value="{{reference}}" bindinput="inputReference"/><button bindtap="checkout" disabled="{{pending}}">{{commerceEnabled?'提交商品订单':paymentsEnabled?'创建订单':'创建模拟订单'}}</button><view wx:if="{{paymentsEnabled}}"><button bindtap="pay" disabled="{{pending}}">微信支付</button><button bindtap="recoverPayment" disabled="{{pending}}">恢复原支付单</button><button bindtap="queryPayment" disabled="{{pending}}">查询微信支付结果</button></view><button wx:if="{{!paymentsEnabled}}" bindtap="refresh">查询服务端状态</button><view>{{status}}</view><view wx:if="{{afterAd}}">模拟成功页广告：{{afterAd}}</view><view wx:if="{{commerceEnabled}}"><button bindtap="cancelOrder" disabled="{{pending}}">取消未付款订单 / 恢复原关单</button><text>退款申请</text><input placeholder="退款申请编号（首次自动生成）" value="{{refundApplication}}" data-field="refundApplication" bindinput="inputRefund"/><input type="number" placeholder="申请退款金额（分）" value="{{refundAmount}}" data-field="refundAmount" bindinput="inputRefund"/><input placeholder="退款原因" value="{{refundReason}}" data-field="refundReason" bindinput="inputRefund"/><button bindtap="requestRefund" disabled="{{pending}}">提交退款申请</button><button bindtap="refundStatus" disabled="{{pending}}">查询原退款申请</button></view><text>真实支付须由服务端明确开通并绑定商户和原订单；模拟订单、微信查单与财务核销分别显示。</text></view>
