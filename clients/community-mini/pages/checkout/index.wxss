page{background:#f5f8f7;color:#192e30}.page{padding:36rpx}.hero{padding:24rpx 6rpx 30rpx;background:transparent}.hero .title{display:block;font-size:40rpx;font-weight:650;line-height:1.4}.hero .subtitle{display:block;font-size:24rpx;line-height:1.8;color:#7b9088;margin-top:14rpx}.card,.order-detail{background:#fff;border:1rpx solid #e5ece8;border-radius:26rpx;padding:28rpx;margin:24rpx 0}.section-title{display:block;font-size:29rpx;font-weight:600}.hint{display:block;font-size:23rpx;color:#83958b;line-height:1.8;margin:18rpx 0}.empty-state{padding:38rpx 28rpx}.empty-state .primary{background:#287a53;color:white;border-radius:18rpx;font-size:27rpx;margin-top:28rpx}.text-link{background:transparent;color:#287a53;font-size:25rpx}.text-link:after{border:0}.order-row{border-bottom:1rpx solid #e7eeea;padding:24rpx 0}.order-detail text{display:block;line-height:1.8;font-size:25rpx}.order-line{padding:20rpx 0;border-top:1rpx solid #edf2ee}

.entry-group{padding-top:0;padding-bottom:0}.service-link{display:block;text-align:left;border-bottom:1rpx solid #edf2ee;background:white;padding:24rpx 0;font-size:28rpx;border-radius:0}.service-link:after{border:0}.service-link:last-child{border-bottom:0}.entry-title{display:block;font-weight:550}.service-link .hint{margin:8rpx 0 0}.form-card label{display:block;font-size:25rpx;color:#506a5d;margin:18rpx 0}.form-card input{box-sizing:border-box;width:100%;padding:20rpx;border:1rpx solid #dce7e0;background:#fbfdfb;border-radius:14rpx;font-size:25rpx;margin-top:12rpx}.record-card>text{display:block;font-size:26rpx;line-height:1.8;overflow-wrap:anywhere}.field-label{font-size:22rpx!important;color:#83958b;margin-top:20rpx}.services-page .primary{background:#287a53;color:white;border-radius:18rpx;font-size:27rpx;margin-top:24rpx}.services-page .status{display:block;font-size:24rpx;line-height:1.8;color:#638072;margin:20rpx 0}.product-card label{display:block;font-size:24rpx;margin:20rpx 0}.product-card input{border:1rpx solid #dce7e0;border-radius:14rpx;padding:16rpx}.services-page .text-link{white-space:normal}
.order-filter-strip{display:block;box-sizing:border-box;width:100%;max-width:100%;overflow-x:auto;white-space:nowrap;margin:20rpx 0 24rpx}
.filter-pills-row{display:inline-flex;gap:12rpx;min-width:100%;padding:2rpx 0;box-sizing:border-box}
.filter-pills-row button{display:inline-flex;flex:0 0 auto;width:auto;min-width:112rpx;min-height:64rpx;align-items:center;justify-content:center;margin:0;padding:0 22rpx;border:1rpx solid #dfe8e3;border-radius:32rpx;background:#fff;color:#61786c;font-size:23rpx;line-height:1.2}
.filter-pills-row button.active{background:#287a53;color:#fff;border-color:#287a53}
.filter-pills-row button:after{border:0}
.order-list{display:grid;gap:0}
.order-list-item{padding:22rpx 0;border-bottom:1rpx solid #e7eeea}
.order-list-item:last-child{border-bottom:0}
.order-list-main,.order-list-footer{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
.order-number{min-width:0;overflow-wrap:anywhere;color:#263a32;font-size:25rpx;font-weight:600}
.order-state{flex:0 0 auto;padding:5rpx 12rpx;border-radius:999rpx;background:#eef6f1;color:#287a53;font-size:21rpx}
.order-list-footer{margin-top:16rpx}
.order-amount{font-size:30rpx;font-weight:700;color:#203a2d}
.order-detail-action{width:auto!important;min-height:58rpx;margin:0!important;padding:0 20rpx!important;border-radius:29rpx!important;background:#edf6f1!important;color:#287a53!important;font-size:23rpx!important}

/* Real directory: neutral placeholder until purpose-public photo pipeline exists. */
.industry-tabs{display:block;box-sizing:border-box;overflow-x:auto;white-space:nowrap;margin:16rpx 0 28rpx;width:100%;max-width:100%;}.industry-tabs button{display:inline-block;width:auto;margin-right:16rpx;padding:0 28rpx;background:#fff;color:#536273;border-radius:36rpx;font-size:26rpx;}.industry-tabs .selected{background:#164f42;color:#fff;}.shop-card{display:flex;gap:24rpx;align-items:center;}.shop-photo-placeholder{flex-shrink:0;width:176rpx;height:176rpx;border-radius:20rpx;background:#edf1ec;color:#6c7c72;display:flex;align-items:center;justify-content:center;font-size:22rpx;}.shop-copy{flex:1;min-width:0;}.shop-copy text{display:block;overflow-wrap:anywhere;}.shop-category{font-size:22rpx;color:#4c7568;margin:10rpx 0;}.detail-photo{width:100%;height:320rpx;}.description{display:block;line-height:1.7;overflow-wrap:anywhere;}

.demo-card,.demo-detail{position:relative;}.demo-card{padding-top:64rpx;}.demo-badge{position:absolute;right:16rpx;top:14rpx;background:#fff0c6;color:#70551d;border:1rpx solid #e0c77c;border-radius:8rpx;padding:5rpx 12rpx;font-size:22rpx;font-weight:600;z-index:2;}.demo-detail .detail-photo{display:block;border-radius:20rpx;}

/* Reserved owned-ad surfaces. Rendering never changes payment state. */
.payment-ad-slot{box-sizing:border-box;min-height:150rpx;margin:24rpx 0;padding:24rpx 28rpx;border:1rpx solid #dce8f4;border-radius:22rpx;background:linear-gradient(135deg,#f8fbff,#edf7ff);display:flex;flex-direction:column;justify-content:center}.payment-ad-success{border-color:#d9eadf;background:linear-gradient(135deg,#f7fcf8,#edf8f1)}.payment-ad-label{font-size:20rpx;color:#8b98a8;letter-spacing:2rpx}.payment-ad-title{display:block;margin-top:12rpx;color:#26384c;font-size:28rpx;font-weight:600;line-height:1.55;overflow-wrap:anywhere}

/* Product artwork is square; owned advertisement artwork is a 3:1 banner. */
.product-card{display:flex;gap:24rpx;align-items:flex-start}.product-image{width:176rpx;height:176rpx;flex:0 0 176rpx;border-radius:20rpx}.product-copy{flex:1;min-width:0}.product-price{display:block;margin-top:12rpx;color:#cf3f2f;font-size:32rpx;font-weight:650}.payment-ad-slot{padding:0 0 22rpx;overflow:hidden}.payment-ad-image{display:block;width:100%;height:200rpx;margin-bottom:20rpx}.payment-ad-label,.payment-ad-title{margin-left:28rpx;margin-right:28rpx}
