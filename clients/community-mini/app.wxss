/* Native projection of the original community UI palette, cards and line navigation. */
page { max-width:100%; overflow-x:hidden; background:#fff5f6; color:#34292d; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:28rpx; line-height:1.6; }
view,button,input,picker { box-sizing:border-box; }
.page { padding:32rpx 28rpx calc(150rpx + env(safe-area-inset-bottom)); max-width:960rpx; margin:0 auto; }
.brand { display:flex; justify-content:space-between; align-items:center; color:#c54450; font-size:27rpx; font-weight:700; }
.badge,.pill { font-size:21rpx; font-weight:400; color:#756068; background:#ffe4e8; padding:5rpx 14rpx; border-radius:24rpx; }
.hero { padding:38rpx 4rpx 30rpx; }
.eyebrow,.title,.subtitle,.description,.section-title,.hint,.footer { display:block; }
.eyebrow { color:#756068; font-size:20rpx; letter-spacing:2rpx; margin-bottom:10rpx; }
.title { font-size:44rpx; font-weight:700; line-height:1.35; }
.subtitle { color:#756068; font-size:25rpx; margin-top:12rpx; }
.card { background:#fff; padding:28rpx; margin-bottom:22rpx; border:1rpx solid #f1d5da; border-radius:30rpx; box-shadow:0 5rpx 20rpx rgba(105,39,59,.035); }
.hero-card { background:linear-gradient(120deg,#ffe4e8,#fff5f6); padding:34rpx; }
.section-title { font-size:30rpx; font-weight:700; margin-bottom:12rpx; }
.description { color:#756068; font-size:25rpx; margin:14rpx 0 22rpx; overflow-wrap:break-word; }
.status-heading { display:flex; align-items:center; gap:14rpx; font-size:28rpx; font-weight:600; }
.status-dot { width:13rpx; height:13rpx; border-radius:50%; background:#bd9a58; }
.status-dot.is-ready { background:#287453; }
button { margin:18rpx 0; padding:20rpx 22rpx; min-height:84rpx; font-size:27rpx; line-height:1.55; border-radius:16rpx; background:#ffe4e8; color:#b83b48; font-weight:500; }
button::after { border:none; }
button.primary { background:#c54450; color:#fff; font-weight:600; }
button.secondary { background:#ffe4e8; color:#b83b48; }
button[disabled] { background:#eee9ec; color:#75666e; }
button.service-link { display:block; width:100%; text-align:left; padding:22rpx 0; border-bottom:1rpx solid #f1d5da; border-radius:0; background:#fff; margin:0; }
.service-link text { display:block; }
.muted,.hint { font-size:23rpx; color:#756068; }
.hint { margin-top:16rpx; }
.footer { text-align:center; color:#756068; font-size:22rpx; margin-top:30rpx; }
input { background:#fff; border:1rpx solid #f1d5da; min-height:84rpx; padding:18rpx 20rpx; border-radius:12rpx; margin:12rpx 0 22rpx; width:100%; }
label { display:block; margin:20rpx 0; }
picker { background:#fff5f6; border:1rpx solid #f1d5da; padding:20rpx; border-radius:14rpx; margin:14rpx 0; }
.scene-photo-card,.material-slot { margin-top:20rpx; padding:22rpx; border:1rpx dashed #f1d5da; border-radius:16rpx; background:#fff5f6; }
.row { display:flex; justify-content:space-between; align-items:center; gap:14rpx; }
.xj-nav { position:fixed; left:0; right:0; bottom:0; z-index:999; display:flex; padding:12rpx 8rpx calc(12rpx + env(safe-area-inset-bottom)); background:#fff; border-top:1rpx solid #f1d5da; box-shadow:0 -3rpx 18rpx rgba(105,39,59,.04); }
.xj-nav .nav-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; margin:0; padding:6rpx 0; min-height:88rpx; font-size:22rpx; line-height:1.5; background:transparent; color:#756068; border-radius:0; }
.xj-nav .is-active { color:#c54450; font-weight:700; }
.nav-icon { position:relative; width:28rpx; height:28rpx; margin-bottom:8rpx; box-sizing:border-box; }
.icon-home { border:3rpx solid currentColor; border-top:0; border-radius:2rpx; width:24rpx; height:20rpx; margin-top:8rpx; }
.icon-home::before { content:''; position:absolute; width:18rpx; height:18rpx; border-left:3rpx solid currentColor; border-top:3rpx solid currentColor; transform:rotate(45deg); top:-12rpx; left:0; }
.icon-recommendations { border:3rpx solid currentColor; border-radius:50%; }
.icon-recommendations::after { content:''; position:absolute; width:7rpx; height:13rpx; top:4rpx; left:8rpx; border:2rpx solid currentColor; transform:rotate(35deg); }
.icon-orders { border:3rpx solid currentColor; border-radius:3rpx; }
.icon-orders::after { content:''; position:absolute; left:5rpx; right:5rpx; top:7rpx; height:7rpx; border-top:2rpx solid currentColor; border-bottom:2rpx solid currentColor; }
.icon-profile::before { content:''; position:absolute; width:13rpx; height:13rpx; border:3rpx solid currentColor; border-radius:50%; left:7rpx; top:0; }
.icon-profile::after { content:''; position:absolute; width:27rpx; height:13rpx; border:3rpx solid currentColor; border-bottom:0; border-radius:20rpx 20rpx 0 0; top:20rpx; left:0; }

/* Owner final UI ZIP 76567f89: consumer discovery/profile and original card hierarchy. */
.consumer-page{background:#fff;padding-top:0}.service-top{display:flex;justify-content:flex-end;border-bottom:1rpx solid #f1d5da;padding:26rpx 0;color:#756068;font-size:24rpx;margin-bottom:28rpx}.consumer-page .hero{padding:8rpx 0 30rpx}.consumer-page .hero .eyebrow{font-size:25rpx;letter-spacing:0}.consumer-page .title{font-size:46rpx}.consumer-page .card{border-radius:34rpx;border-color:#f1d5da;padding:30rpx}.consumer-page .discovery-card .section-title{font-size:40rpx;margin-top:20rpx}.text-link{background:transparent;color:#b83b48;text-align:left;padding:8rpx 0;min-height:52rpx;margin:12rpx 0;font-weight:600}.highlighted-link{background:#ffe4e8!important;border:1rpx solid #f1d5da!important;border-radius:18rpx!important;padding:22rpx!important}.profile-hero{display:flex;gap:22rpx;align-items:center;background:#ffe4e8;border-radius:28rpx;padding:30rpx;margin:32rpx 0 26rpx}.profile-avatar,.store-avatar{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:88rpx;height:88rpx;background:#f1d5da;color:#c54450;font-size:34rpx;font-weight:700;border-radius:50%}.profile-hero .subtitle{font-size:24rpx;margin-top:0}.store-row{display:flex;gap:24rpx;align-items:center}.store-avatar{border-radius:22rpx;background:#ffe4e8}.store-copy{flex:1}.empty-state{color:#756068}.merchant-hero{padding:32rpx;background:linear-gradient(120deg,#ffe4e8,#fff5f6);border:1rpx solid #f1d5da;border-radius:32rpx;margin:24rpx 0 34rpx}.merchant-hero .eyebrow{color:#c54450;letter-spacing:0;font-weight:600}.merchant-hero .title{margin-bottom:18rpx}.workbench-links .service-link{padding:22rpx;border:1rpx solid #f1d5da;border-radius:26rpx;margin:18rpx 0}.workbench-links .service-link .hint{margin:4rpx 0 0}

/* Final Owner UI ui-all-pages/06-390-design.png: original consumer recommendation header. */
.consumer-section-header{background:#c54450;color:#fff;padding:26rpx 30rpx;font-size:34rpx;font-weight:700;min-height:100rpx;display:flex;align-items:center}
page{background:#fff5f6;color:#34292d}
.consumer-page{background:transparent}
.title,.section-title{color:#34292d;font-weight:700}
button.primary{background:linear-gradient(115deg,#c54450,#c54450);color:#fff;border-radius:22rpx}
button.primary[disabled],button[disabled]{background:#eee9ec;color:#75666e}
.card{box-shadow:0 8rpx 30rpx rgba(105,39,59,.06)}
.xj-nav{background:#fff5f6;border-color:#f1d5da;box-shadow:0 -8rpx 28rpx rgba(99,31,48,.07)}
.xj-nav .nav-item{color:#756068}
.xj-nav .nav-item.is-active{color:#c54450}
.xj-nav .is-active .nav-icon{filter:drop-shadow(0 4rpx 7rpx rgba(191,41,70,.22))}
.consumer-section-header{background:linear-gradient(110deg,#c54450,#c54450)}

.xj-nav .nav-item.is-active .nav-icon{color:#c54450}

/* Shared warm rose theme: no business or layout mutation. */
page{--community-bg:#fff5f6;--community-top:#ffe4e8;--community-accent:#c54450;--community-text:#34292d;--community-muted:#756068;--community-line:#f1d5da;--community-card:#ffffff;background:linear-gradient(180deg,#ffe4e8 0,#fff5f6 460rpx);color:var(--community-text)}
