page { background: #f3f6f7; color: #172f39; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; line-height: 1.6; }
view, button, input { box-sizing: border-box; }
.page { padding: 40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); max-width: 960rpx; margin: 0 auto; }
.brand { display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; font-weight: 600; }
.badge { font-size: 22rpx; font-weight: 400; color: #556d76; background: #e7edef; padding: 6rpx 18rpx; border-radius: 24rpx; }
.hero { padding: 52rpx 0 36rpx; }
.eyebrow, .title, .subtitle, .description, .section-title, .hint, .footer { display: block; }
.eyebrow { color: #42796b; font-size: 20rpx; letter-spacing: 3rpx; margin-bottom: 14rpx; }
.title { font-size: 44rpx; font-weight: 600; line-height: 1.35; }
.subtitle { color: #657983; font-size: 26rpx; margin-top: 16rpx; }
.card { background: #fff; padding: 32rpx; margin-bottom: 24rpx; border: 1rpx solid #e4eaed; border-radius: 24rpx; }
.status-heading { display: flex; align-items: center; gap: 16rpx; font-weight: 600; font-size: 30rpx; }
.status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #b18745; flex-shrink: 0; }
.status-dot.is-ready { background: #27856c; }
.description { color: #657983; font-size: 26rpx; margin: 18rpx 0 28rpx; overflow-wrap: break-word; }
button { margin: 20rpx 0; padding: 20rpx 24rpx; min-height: 88rpx; font-size: 28rpx; line-height: 1.5; border-radius: 16rpx; background: #fff; color: #172f39; }
button::after { border: none; }
button.primary { background: #176953; color: #fff; font-weight: 600; }
button[disabled] { background: #edf1f2; color: #7a8b92; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 12rpx; }
button.service-link { text-align: left; padding: 24rpx 0; border-bottom: 1rpx solid #edf1f2; border-radius: 0; background: #fff; margin: 0; }
.service-link text { display: block; }
.muted, .hint { font-size: 24rpx; color: #71848d; }
.hint { margin-top: 24rpx; }
.footer { text-align: center; color: #7a8b92; font-size: 22rpx; margin-top: 36rpx; }
input { background: #f4f7f8; min-height: 88rpx; padding: 20rpx 24rpx; border-radius: 12rpx; margin: 16rpx 0 24rpx; }
