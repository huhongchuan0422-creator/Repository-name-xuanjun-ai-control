{
  "mcpServers": {
    "xuanjun-task-center": {
      "command": "python3",
      "args": [
        "/ABSOLUTE/PATH/scripts/task_center_mcp.py",
        "--base-url",
        "http://127.0.0.1:8765",
        "--admin-token-file",
        "/ABSOLUTE/PRIVATE/admin.token",
        "--actor-token-file",
        "/ABSOLUTE/PRIVATE/actor.token",
        "--trusted-principal",
        "BOUND_PRINCIPAL_FROM_ACTOR_TOKEN"
      ]
    }
  }
}
