+          'actions':[dict(x) for x in self.db.execute('''SELECT * FROM
+          execution_action_requests WHERE tenant_id=? ORDER BY created_at,
+          request_id''',(self.tenant_id,))],
+          'mode':'TEST_ONLY','external_execution':'NOT_IMPLEMENTED'}
