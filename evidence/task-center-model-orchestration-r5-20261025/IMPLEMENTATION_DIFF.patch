+            if actual!=expected:raise ValueError('IDEMPOTENCY_CONFLICT')
+            return {'request_id':prior['request_id'],'state':prior['state'],
+                    'duplicate':True}
+        self.db.execute('''INSERT INTO execution_action_requests VALUES
