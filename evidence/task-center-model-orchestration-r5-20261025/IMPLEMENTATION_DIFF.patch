+cards('modules',state.modules,function(x){return '<article class="card"><h3>'+esc(x.module_id)+'</h3><p>'+esc(x.version)+' · '+(x.enabled?'ENABLED':'DISABLED')+'</p></article>';},'暂无模块设置');cards('usage',state.usage,function(u){return '<article class="card"><h3>'+esc(u.provider_id)+' / '+esc(u.model_id)+'</h3><p>请求 '+u.request_count+' · 输入 '+u.input_tokens+' · 输出 '+u.output_tokens+'</p><p>成本 '+esc(u.cost_state)+' / '+esc(u.known_cost)+'</p></article>';},'暂无用量事实');
