+  function project(data,route){var projectId=route.task||'',tasks=data.tasks.filter(function(t){return t.board_id===route.board&&t.project_id===projectId;}),blocked=tasks.filter(function(t){return t.blocker;});return '<section><div class="crumb"><button data-go="#overview">总览</button> / <button data-go="'+href('board',route.board,null,route.query)+'">'+esc(boardNames[route.board])+'</button> / '+esc(projectId)+'</div><h1>'+esc(projectId)+'</h1><p class="meta">'+tasks.length+' 个任务 · '+blocked.length+' 个卡点；项目详情来自同一 SQLite 投影。</p><div class="grid">'+tasks.map(function(t){return taskCard(t,route.query);}).join('')+'</div></section>';}
   function task(data,route){var t=data.tasks.find(function(x){return x.task_id===route.task&&x.board_id===route.board;});if(!t)return '<div class="notice">任务不存在或不属于当前板块。</div>';var a=data.anomalies.find(function(x){return x.task_id===t.task_id;});return '<section><div class="crumb"><button data-go="#overview">总览</button> / <button data-go="'+href('board',t.board_id,null,route.query)+'">'+esc(boardNames[t.board_id])+'</button> / '+esc(t.task_id)+'</div><h1>'+esc(t.task_id)+'</h1><div class="grid"><article class="card"><h2>任务事实</h2><p>项目：'+esc(t.project_id)+'</p><p>节点：'+esc(t.node_id)+'</p><p>权威状态：'+esc(t.state)+'</p><p>运行投影：'+esc(t.runtime_status||t.state)+'</p><p>负责人：'+esc(t.task_responsible_party)+'</p><p>下一动作：'+esc(t.next_action)+'</p></article><article class="card"><h2>执行角色与进程事实</h2><p>Writer：'+esc(t.writer_identity)+'</p><p>run / session：'+esc(t.run_id)+' / '+esc(t.session_id)+'</p><p>attempt / epoch：'+esc(t.attempt_id)+' / '+esc(t.epoch)+'</p><p>会话：'+esc(t.session_state)+'</p><p>进程：'+esc(t.process_state)+'</p><p>最后真实进展：'+esc(t.last_real_progress_at)+'</p></article><article class="card"><h2>权限与断点</h2><p>权限：'+esc(t.authority_state)+'</p><p>有效期：'+esc(t.authority_valid_until)+'</p><p>checkpoint：'+esc(t.checkpoint_sha256)+'</p><p>副作用对账：'+esc(t.effects_reconciled)+'</p><p>Writer停止：'+esc(t.writer_stopped)+'</p></article></div>'+(a?'<article class="card anomaly"><h2>异常证据</h2><p>缺失：'+esc(a.missing)+'</p><p>影响：'+esc(a.impact)+'</p><p>依赖：'+esc(a.depends_on.join(', ')||'无明确依赖')+'</p><p>任务负责人：'+esc(a.task_responsible_party)+'</p><p>解除责任方：'+esc(a.resolution_responsible_party)+'</p><p>下一动作：'+esc(a.next_action)+'</p><p class="evidence">证据：'+esc(a.evidence_ref.join(', '))+'</p></article>':'')+'</section>';}
