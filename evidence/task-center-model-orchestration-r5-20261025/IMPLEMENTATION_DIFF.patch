   function board(data,route){var tasks=filterTasks(data,route),projects={};tasks.forEach(function(t){(projects[t.project_id]||(projects[t.project_id]=[])).push(t);});return '<section><div class="crumb"><button data-go="#overview">总览</button> / '+esc(boardNames[route.board])+'</div><h1>'+esc(boardNames[route.board])+'工作台</h1><div class="toolbar"><input id="projectFilter" aria-label="项目筛选" placeholder="项目ID" value="'+esc(route.query.project||'')+'"><select id="stateFilter" aria-label="状态筛选"><option value="">全部状态</option>'+['READY','RECEIVED','STARTED','RUNNING','SUCCESS','HOLD','FAILURE','CANCELLED','CAPABILITY_UNAVAILABLE'].map(function(x){return '<option'+(route.query.state===x?' selected':'')+'>'+x+'</option>';}).join('')+'</select><input id="ownerFilter" aria-label="负责人筛选" placeholder="负责人" value="'+esc(route.query.owner||'')+'"><button id="applyFilter">应用筛选</button></div>'+(Object.keys(projects).length?Object.keys(projects).sort().map(function(p){return '<article class="project-group"><div class="project-head"><div><h2>'+esc(p)+'</h2><span>'+projects[p].length+' 个任务</span></div><button data-go="'+href('project',route.board,p,route.query)+'">项目详情</button></div><div class="grid">'+projects[p].map(function(t){return taskCard(t,route.query);}).join('')+'</div></article>';}).join(''):'<div class="card empty">该筛选暂无任务</div>')+'</section>';}
