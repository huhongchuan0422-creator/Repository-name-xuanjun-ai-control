+              audit_id TEXT PRIMARY KEY,tenant_id TEXT NOT NULL,
+              principal_id TEXT NOT NULL,action TEXT NOT NULL,target_id TEXT NOT NULL,
+              detail_json TEXT NOT NULL,observed_at REAL NOT NULL)''')
