+    def _schema(self):
+        self.db.execute('BEGIN IMMEDIATE')
+        try:
+            self.db.execute('''CREATE TABLE IF NOT EXISTS service_connections(
+              tenant_id TEXT NOT NULL,connection_id TEXT NOT NULL,
