+import importlib.util
+import os
+import unittest
+
+SPEC = importlib.util.spec_from_file_location('workbench_config', os.path.join(os.path.dirname(__file__), '..', 'scripts', 'uk-owner-workbench-config.py'))
+module = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(module)
+
+
+class WorkbenchConfigTests(unittest.TestCase):
+    def test_https_routes_are_exact_and_loopback_only(self):
+        value = module.render('owner.example.com', '/etc/xj/fullchain.pem', '/etc/xj/key.pem')
+        self.assertIn('listen 443 ssl http2;', value)
+        self.assertIn('proxy_pass http://127.0.0.1:18556/api/state;', value)
+        self.assertIn('proxy_pass http://127.0.0.1:18557/owner-callback;', value)
+        self.assertIn('limit_except POST { deny all; }', value)
+        self.assertIn('proxy_set_header Authorization $http_authorization;', value)
+        self.assertIn('proxy_set_header X-Xuanjun-Signature $http_x_xuanjun_signature;', value)
+        self.assertIn('server_tokens off;', value)
+        self.assertIn('limit_req zone=owner_callback_rate burst=10 nodelay;', value)
+        self.assertIn('proxy_read_timeout 12s;', value)
+        self.assertNotIn('@@', value)
+
+    def test_service_is_dedicated_and_hardened(self):
+        path=os.path.join(os.path.dirname(__file__),'..','deploy','uk-owner-workbench',
+                          'xuanjun-uk-owner-callback.service')
+        with open(path) as stream: value=stream.read()
+        for required in ('User=xuanjun-callback','ProtectHome=true','ProtectSystem=strict',
+                         'CapabilityBoundingSet=','PrivateDevices=true','RestrictNamespaces=true',
+                         'ProtectKernelModules=true','LockPersonality=true'):
+            self.assertIn(required,value)
+        self.assertNotIn('User=xuanjun_dev',value)
+        self.assertNotIn('/home/xuanjun_dev',value)
+
+    def test_injection_and_relative_paths_rejected(self):
+        for host in ('localhost', 'owner.example.com;return 200', '../example.com'):
+            with self.assertRaises(ValueError):
+                module.render(host, '/a/cert', '/a/key')
+        with self.assertRaises(ValueError):
+            module.render('owner.example.com', 'relative', '/a/key')
+
+
+if __name__ == '__main__':
+    unittest.main()
