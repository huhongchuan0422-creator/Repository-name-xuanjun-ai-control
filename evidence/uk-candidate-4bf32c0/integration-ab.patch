+import hashlib
+import hmac
+import io
+import json
+import os
+import sqlite3
+import tempfile
+import threading
+import unittest
+from unittest.mock import patch
+
+from owner_callback_server import BoundedThreadingHTTPServer, handler, read_secret
+
+
+class CallbackServerTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.db = os.path.join(self.temp.name, 'state.sqlite')
+        with sqlite3.connect(self.db) as db:
+            db.executescript('CREATE TABLE tasks(id TEXT PRIMARY KEY,state TEXT,fence INTEGER,updated REAL);CREATE TABLE approvals(task_id TEXT PRIMARY KEY,decision TEXT,decided_at REAL);CREATE TABLE events(task_id TEXT,event TEXT,created REAL,details TEXT);CREATE TABLE owner_callback_requests(request_id TEXT PRIMARY KEY,task_id TEXT,fence INTEGER,owner_id TEXT,owner_chat TEXT,expires_at REAL,consumed INTEGER);CREATE TABLE owner_callback_replays(update_id INTEGER PRIMARY KEY,request_id TEXT UNIQUE);')
+            db.execute("INSERT INTO tasks VALUES('t','WAITING_HUMAN',7,0)")
+            db.execute("INSERT INTO approvals VALUES('t','PENDING',NULL)")
+            db.execute("INSERT INTO owner_callback_requests VALUES('r','t',7,'123','456',9999999999,0)")
+        self.config = {'db': self.db, 'token': 'a' * 32, 'hmac_key': b'k' * 32,
+                       'owner_id': '123', 'owner_chat_id': '456'}
+
+    def tearDown(self):
+        self.temp.cleanup()
+
+    def request(self, obj, auth=None, signature=None, path='/owner-callback', content_type='application/json'):
+        body = json.dumps(obj).encode('utf-8')
+        instance = object.__new__(handler(self.config))
+        instance.path = path
+        instance.headers = {'Content-Type': content_type, 'Content-Length': str(len(body)),
+                            'Authorization': auth or 'Bearer ' + self.config['token'],
+                            'X-Xuanjun-Signature': signature or hmac.new(self.config['hmac_key'], body, hashlib.sha256).hexdigest()}
+        instance.rfile = io.BytesIO(body)
+        result = {}
+        instance.respond = lambda status, data: result.update(status=status, data=data)
+        instance.do_POST()
+        return result
+
+    def test_approve_and_replay_rejected(self):
+        obj = {'request_id':'r','task_id':'t','fence':7,'owner_user_id':'123',
+               'owner_chat_id':'456','update_id':99,'decision':'APPROVE'}
+        self.assertEqual(self.request(obj), {'status': 200, 'data': {'accepted': True}})
+        self.assertEqual(self.request(obj)['status'], 403)
+
+    def test_wrong_chat_signature_path_and_type_fail_closed(self):
+        obj = {'request_id':'r','task_id':'t','fence':7,'owner_user_id':'123',
+               'owner_chat_id':'999','update_id':100,'decision':'REJECT'}
+        self.assertEqual(self.request(obj)['status'], 403)
+        self.assertEqual(self.request(obj, signature='bad')['status'], 403)
+        self.assertEqual(self.request(obj, path='/')['status'], 404)
+        self.assertEqual(self.request(obj, content_type='text/plain')['status'], 415)
+
+    def test_secret_file_mode_and_symlink(self):
+        path = os.path.join(self.temp.name, 'secret')
+        with open(path, 'w') as stream:
+            stream.write('z' * 32)
+        os.chmod(path, 0o600)
+        self.assertEqual(read_secret(path, r'[a-z]{32}'), 'z' * 32)
+        os.chmod(path, 0o644)
+        with self.assertRaises(ValueError):
+            read_secret(path, r'[a-z]{32}')
+
+    def test_server_header_hidden_and_worker_bound_validated(self):
+        instance = object.__new__(handler(self.config))
+        instance.request_version = 'HTTP/1.1'
+        instance.requestline = 'POST /owner-callback HTTP/1.1'
+        instance.command = 'POST'
+        instance.path = '/owner-callback'
+        instance.wfile = io.BytesIO()
+        instance.send_response(200)
+        self.assertNotIn(b'Server:', instance.wfile.getvalue())
+        with self.assertRaises(ValueError):
+            BoundedThreadingHTTPServer(('127.0.0.1', 0), handler(self.config), max_workers=0)
+
+    def test_concurrent_replay_only_one_is_accepted(self):
+        obj = {'request_id':'r','task_id':'t','fence':7,'owner_user_id':'123',
+               'owner_chat_id':'456','update_id':101,'decision':'APPROVE'}
+        barrier = threading.Barrier(2)
+        results = []
+        def invoke():
+            barrier.wait(timeout=2)
+            results.append(self.request(obj)['status'])
+        threads = [threading.Thread(target=invoke) for unused in range(2)]
+        for thread in threads: thread.start()
+        for thread in threads: thread.join(timeout=5)
+        self.assertEqual(sorted(results), [200, 403])
+
+
+if __name__ == '__main__':
+    unittest.main()
