@@ -0,0 +1,135 @@
+#!/usr/bin/python3
+"""Root-owned narrow broker for one allowlisted transient Codex app-server."""
+import os
+import pwd
+import re
+import signal
+import stat
+import subprocess
+import sys
+import time
+
+
+def fail(message):
+    raise SystemExit(message)
+
+
+def parse(argv):
+    if '--' not in argv: fail('MISSING_COMMAND_SEPARATOR')
+    split=argv.index('--'); options=argv[:split]; command=argv[split+1:]
+    if len(options)!=5: fail('INVALID_OPTIONS')
+    values={}
+    for option in options:
+        if '=' not in option or not option.startswith('--'): fail('INVALID_OPTION')
+        key,value=option[2:].split('=',1)
+        if key in values: fail('DUPLICATE_OPTION')
+        values[key]=value
+    if set(values)!=set(('unit','uid','workdir','home','codex-home')): fail('INVALID_OPTIONS')
+    return values,command
+
+
+def _safe_tree(path, owner_uid):
+    root_device=os.stat(path,follow_symlinks=False).st_dev
+    for directory,dirs,files,descriptor in os.fwalk(path,topdown=True,follow_symlinks=False):
+        for name in dirs+files:
+            info=os.stat(name,dir_fd=descriptor,follow_symlinks=False)
+            if (info.st_dev!=root_device or info.st_uid!=owner_uid
+                    or stat.S_ISLNK(info.st_mode)
+                    or (not stat.S_ISDIR(info.st_mode) and not stat.S_ISREG(info.st_mode))
+                    or (stat.S_ISREG(info.st_mode) and info.st_nlink!=1)
+                    or info.st_mode & 0o077):
+                fail('UNSAFE_WORKTREE_ENTRY')
+    return True
+
+
+def _handoff_tree(path, from_uid, to_uid, to_gid):
+    _safe_tree(path,from_uid)
+    for directory,dirs,files,descriptor in os.fwalk(path,topdown=False,follow_symlinks=False):
+        for name in files:
+            info=os.stat(name,dir_fd=descriptor,follow_symlinks=False)
+            mode=(stat.S_IMODE(info.st_mode)&0o700)|0o600
+            os.chmod(name,mode,dir_fd=descriptor,follow_symlinks=False)
+            os.chown(name,to_uid,to_gid,dir_fd=descriptor,follow_symlinks=False)
+        for name in dirs:
+            os.chmod(name,0o700,dir_fd=descriptor,follow_symlinks=False)
+            os.chown(name,to_uid,to_gid,dir_fd=descriptor,follow_symlinks=False)
+    os.chmod(path,0o700,follow_symlinks=False)
+    os.chown(path,to_uid,to_gid,follow_symlinks=False)
+
+
+def validate(values,command):
+    if os.geteuid()!=0: fail('ROOT_BROKER_REQUIRED')
+    if not re.fullmatch(r'xj-codex-[a-f0-9]{24}',values['unit']): fail('INVALID_UNIT')
+    if values['uid']!='xj_codex_worker': fail('INVALID_UID')
+    try: account=pwd.getpwnam(values['uid'])
+    except KeyError: fail('UNKNOWN_UID')
+    if account.pw_uid==0: fail('PRIVILEGED_UID_REJECTED')
+    try: dispatcher=pwd.getpwnam('xuanjun-dispatcher')
+    except KeyError: fail('UNKNOWN_DISPATCHER_UID')
+    if dispatcher.pw_uid==0 or dispatcher.pw_uid==account.pw_uid: fail('INVALID_DISPATCHER_UID')
+    expected={'home':'/var/lib/xuanjun-development/worker-home',
+              'codex-home':'/var/lib/xuanjun-development/codex-home'}
+    if values['home']!=expected['home'] or values['codex-home']!=expected['codex-home']:
+        fail('INVALID_FIXED_HOME')
+    workroot='/var/lib/xuanjun-development/worktrees'
+    path=values['workdir']
+    if (not re.fullmatch(r'/[A-Za-z0-9_./-]+',path) or os.path.realpath(path)!=path
+            or os.path.commonpath([workroot,path])!=workroot or path==workroot):
+        fail('INVALID_WORKDIR')
+    for key in ('home','codex-home'):
+        path=values[key]
+        if not os.path.isdir(path): fail('INVALID_ISOLATION_PATH')
+        info=os.stat(path,follow_symlinks=False)
+        if (not stat.S_ISDIR(info.st_mode) or info.st_uid!=account.pw_uid
+                or info.st_mode & 0o077): fail('UNSAFE_ISOLATION_DIRECTORY')
+    winfo=os.stat(values['workdir'],follow_symlinks=False)
+    if (not stat.S_ISDIR(winfo.st_mode) or winfo.st_uid!=dispatcher.pw_uid
+            or winfo.st_mode & 0o077): fail('UNSAFE_DISPATCHER_WORKTREE')
+    _safe_tree(values['workdir'],dispatcher.pw_uid)
+    if len(set(values[key] for key in ('workdir','home','codex-home')))!=3:
+        fail('ISOLATION_PATH_OVERLAP')
+    expected=['/usr/bin/codex','-c','model_provider="openai"','-c','approval_policy="never"',
+              '-c','features.multi_agent=false','app-server','--listen','stdio://']
+    if command!=expected: fail('COMMAND_NOT_ALLOWLISTED')
+    info=os.stat(command[0],follow_symlinks=False)
+    if info.st_uid!=0 or info.st_mode & 0o022: fail('UNTRUSTED_CODEX_BINARY')
+    return account,dispatcher
+
+
+def main(argv=None):
+    values,command=parse(list(sys.argv[1:] if argv is None else argv)); worker,dispatcher=validate(values,command)
+    unit=values['unit']
+    run=['/usr/bin/systemd-run','--quiet','--wait','--collect','--pipe','--unit='+unit,
+         '--uid='+values['uid'],'--property=WorkingDirectory='+values['workdir'],
+         '--setenv=HOME='+values['home'],'--setenv=CODEX_HOME='+values['codex-home'],
+         '--property=NoNewPrivileges=yes','--property=PrivateTmp=yes',
+         '--property=PrivateDevices=yes','--property=ProtectSystem=strict',
+         '--property=ProtectHome=yes','--property=RestrictSUIDSGID=yes',
+         '--property=CPUQuota=100%','--property=MemoryMax=2G','--property=TasksMax=256',
+         '--property=InaccessiblePaths=/root /etc/xuanjun-owner-callback /var/lib/xuanjun-development/ledger',
+         '--property=ReadWritePaths='+values['workdir']+' '+values['home']+' '+values['codex-home'],'--']+command
+    _handoff_tree(values['workdir'],dispatcher.pw_uid,worker.pw_uid,worker.pw_gid)
+    child=None
+    stopping=[False]
+    def stop(*unused):
+        if stopping[0]: return
+        stopping[0]=True
+        subprocess.call(['/usr/bin/systemctl','stop',unit],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+    signal.signal(signal.SIGTERM,stop); signal.signal(signal.SIGINT,stop)
+    try:
+        child=subprocess.Popen(run)
+        code=child.wait()
+        if stopping[0]:
+            deadline=time.monotonic()+10
+            while time.monotonic()<deadline:
+                state=subprocess.call(['/usr/bin/systemctl','is-active','--quiet',unit])
+                if state!=0: break
+                time.sleep(0.1)
+            else: fail('UNIT_STOP_UNCONFIRMED')
+        return code
+    finally:
+        if child is not None and child.poll() is None: stop(); child.wait()
+        _handoff_tree(values['workdir'],worker.pw_uid,dispatcher.pw_uid,dispatcher.pw_gid)
+
+
+if __name__=='__main__': sys.exit(main())
