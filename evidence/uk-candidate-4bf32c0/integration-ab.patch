+import os
+import sqlite3
+import tempfile
+import unittest
+
+from callback_schema_gate import prepare
+from uk_owner_callback_core import install_schema, validate_schema
+
+
+BASE = '''CREATE TABLE tasks(id TEXT PRIMARY KEY,kind TEXT,state TEXT,depends TEXT,lease_owner TEXT,lease_until REAL,fence INTEGER,checkpoint TEXT,updated REAL);
+CREATE TABLE approvals(task_id TEXT PRIMARY KEY,decision TEXT,requested_at REAL,decided_at REAL);
+CREATE TABLE events(id INTEGER PRIMARY KEY,task_id TEXT,event TEXT,created REAL,details TEXT);
+CREATE TABLE execution_specs(task_id TEXT PRIMARY KEY REFERENCES tasks(id),spec TEXT NOT NULL,revision INTEGER NOT NULL,hash TEXT NOT NULL);
+CREATE TABLE worker_heartbeats(worker_id TEXT NOT NULL,task_id TEXT PRIMARY KEY REFERENCES tasks(id),fence INTEGER NOT NULL,seen_at REAL NOT NULL,phase TEXT NOT NULL);'''
+
+
+class SchemaGateTests(unittest.TestCase):
+    def setUp(self):
+        self.temp=tempfile.TemporaryDirectory(); self.addCleanup(self.temp.cleanup)
+        self.live=os.path.join(self.temp.name,'live.sqlite')
+        with sqlite3.connect(self.live) as db: db.executescript(BASE)
+
+    def test_backup_first_staged_idempotent_migration_never_switches_live(self):
+        backup=os.path.join(self.temp.name,'backup.sqlite')
+        staged=os.path.join(self.temp.name,'staged.sqlite')
+        result=prepare(self.live,backup,staged)
+        self.assertFalse(result['live_switched'])
+        validate_schema(staged)
+        install_schema(staged); validate_schema(staged)
+        with sqlite3.connect(self.live) as db:
+            self.assertEqual(db.execute("SELECT count(*) FROM sqlite_master WHERE name LIKE 'owner_callback_%'").fetchone()[0],0)
+
+    def test_schema_mismatch_rolls_back(self):
+        broken=os.path.join(self.temp.name,'broken.sqlite')
+        with sqlite3.connect(broken) as db:
+            db.executescript(BASE + ';CREATE TABLE owner_callback_requests(request_id TEXT PRIMARY KEY);')
+        with self.assertRaises(ValueError): install_schema(broken)
+        with sqlite3.connect(broken) as db:
+            self.assertEqual([r[1] for r in db.execute('PRAGMA table_info(owner_callback_requests)')],['request_id'])
+
+
+if __name__ == '__main__': unittest.main()
