+[Unit]
+Description=Xuanjun UK fenced Owner approval callback
+After=network.target
+
+[Service]
+Type=simple
+User=xuanjun-callback
+Group=xuanjun-control-db
+WorkingDirectory=/opt/xuanjun-control-releases/@@ARTIFACT_SHA256@@/stage1
+ExecStart=/usr/bin/python3 /opt/xuanjun-control-releases/@@ARTIFACT_SHA256@@/stage1/owner_callback_server.py --db /var/lib/xuanjun-owner-callback/state/state.sqlite --auth-file /etc/xuanjun-owner-callback/owner-callback-auth --hmac-key-file /etc/xuanjun-owner-callback/owner-callback-hmac --owner-id-file /etc/xuanjun-owner-callback/owner-user-id --owner-chat-id-file /etc/xuanjun-owner-callback/owner-chat-id --port 18557 --socket-timeout 5 --max-workers 8
+Restart=on-failure
+RestartSec=5
+NoNewPrivileges=true
+PrivateTmp=true
+PrivateDevices=true
+ProtectSystem=strict
+ProtectHome=true
+ProtectKernelTunables=true
+ProtectKernelModules=true
+ProtectControlGroups=true
+RestrictNamespaces=true
+LockPersonality=true
+RestrictSUIDSGID=true
+CapabilityBoundingSet=
+AmbientCapabilities=
+ReadOnlyPaths=/opt/xuanjun-control-releases/@@ARTIFACT_SHA256@@ /etc/xuanjun-owner-callback
+ReadWritePaths=/var/lib/xuanjun-owner-callback/state
+RestrictAddressFamilies=AF_INET AF_UNIX
+SystemCallArchitectures=native
+MemoryMax=256M
+TasksMax=32
+UMask=0077
+
+[Install]
+WantedBy=multi-user.target
