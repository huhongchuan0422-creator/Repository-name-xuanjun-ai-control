+PATH=os.path.join(os.path.dirname(__file__),'..','scripts','xj-codex-isolation-helper')
+module=importlib.machinery.SourceFileLoader('isolation_helper',PATH).load_module()
+
+
+class IsolationHelperTests(unittest.TestCase):
+    def test_parser_and_command_allowlist_fail_closed(self):
+        values,command=module.parse([
+            '--unit=xj-codex-'+'a'*24,'--uid=xj_worker',
+            '--workdir=/var/lib/xuanjun-development/worktrees/task',
+            '--home=/var/lib/xuanjun-development/worker-home',
+            '--codex-home=/var/lib/xuanjun-development/codex-home','--','/bin/sh'])
+        account=type('Account',(),{'pw_uid':1001})()
+        with patch.object(module.os,'geteuid',return_value=0), \
+             patch.object(module.pwd,'getpwnam',return_value=account), \
+             patch.object(module.os.path,'isdir',return_value=True):
+            with self.assertRaises(SystemExit): module.validate(values,command)
+
+    def test_uid_zero_alias_rejected(self):
+        values={'unit':'xj-codex-'+'b'*24,'uid':'xj_alias',
+                'workdir':'/var/lib/xuanjun-development/worktrees/task',
+                'home':'/var/lib/xuanjun-development/worker-home',
+                'codex-home':'/var/lib/xuanjun-development/codex-home'}
+        account=type('Account',(),{'pw_uid':0})()
+        with patch.object(module.os,'geteuid',return_value=0), \
+             patch.object(module.pwd,'getpwnam',return_value=account):
+            with self.assertRaises(SystemExit): module.validate(values,[])
+
+    def test_ledger_or_control_workdir_is_rejected_before_launch(self):
+        command=['/usr/bin/codex','-c','model_provider="openai"','-c',
+                 'approval_policy="never"','-c','features.multi_agent=false',
+                 'app-server','--listen','stdio://']
+        account=type('Account',(),{'pw_uid':1001})()
+        for path in ('/var/lib/xuanjun-development/ledger/task-work',
+                     '/var/lib/xuanjun-development/control/task-work',
+                     '/var/lib/xuanjun-development/worktrees/../ledger/task-work'):
+            values={'unit':'xj-codex-'+'c'*24,'uid':'xj_codex_worker','workdir':path,
+                    'home':'/var/lib/xuanjun-development/worker-home',
+                    'codex-home':'/var/lib/xuanjun-development/codex-home'}
+            with patch.object(module.os,'geteuid',return_value=0), \
+                 patch.object(module.pwd,'getpwnam',return_value=account):
+                with self.assertRaises(SystemExit): module.validate(values,command)
+
+    def test_systemd239_uses_working_directory_property(self):
+        with open(PATH) as stream: source=stream.read()
+        self.assertIn("'--property=WorkingDirectory='+values['workdir']",source)
+        self.assertNotIn("'--working-directory='",source)
+
+    def test_real_git_worktree_passes_narrow_tree_validation_and_handoff(self):
+        with tempfile.TemporaryDirectory() as temp:
+            repo=os.path.join(temp,'repo'); work=os.path.join(temp,'worktree')
+            subprocess.check_call(['git','init','-q',repo])
+            subprocess.check_call(['git','-C',repo,'config','user.name','test'])
+            subprocess.check_call(['git','-C',repo,'config','user.email','test@localhost'])
+            with open(os.path.join(repo,'file.txt'),'w') as stream: stream.write('content')
+            subprocess.check_call(['git','-C',repo,'add','.'])
+            subprocess.check_call(['git','-C',repo,'commit','-qm','base'])
+            subprocess.check_call(['git','-C',repo,'worktree','add','-q',work,'-b','task'])
+            for directory,dirs,files in os.walk(work):
+                os.chmod(directory,0o700)
+                for name in files: os.chmod(os.path.join(directory,name),0o600)
+            uid,gid=os.geteuid(),os.getegid()
+            self.assertTrue(module._safe_tree(work,uid))
+            module._handoff_tree(work,uid,uid,gid)
+            self.assertTrue(module._safe_tree(work,uid))
+
+
+if __name__=='__main__': unittest.main()
