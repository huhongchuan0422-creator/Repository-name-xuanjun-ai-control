@@ -0,0 +1,155 @@
+import json
+import os
+import sqlite3
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from development_service import acquire_dispatcher_lock, isolation_prefix, load_config
+from codex_app_server_worker import CodexAppServerWorker
+from development_pipeline import CliBackend, UnknownEffect
+from execution_ledger import ExecutionLedger
+from ledger_backup import backup, stage_restore, verify
+
+
+SCHEMA = '''CREATE TABLE tasks(id TEXT PRIMARY KEY,kind TEXT,state TEXT,depends TEXT,lease_owner TEXT,lease_until REAL,fence INTEGER,checkpoint TEXT,updated REAL);
+CREATE TABLE approvals(task_id TEXT PRIMARY KEY,decision TEXT,requested_at REAL,decided_at REAL);
+CREATE TABLE events(id INTEGER PRIMARY KEY,task_id TEXT,event TEXT,created REAL,details TEXT);
+CREATE TABLE execution_specs(task_id TEXT PRIMARY KEY REFERENCES tasks(id),spec TEXT NOT NULL,revision INTEGER NOT NULL,hash TEXT NOT NULL);
+CREATE TABLE worker_heartbeats(worker_id TEXT NOT NULL,task_id TEXT PRIMARY KEY REFERENCES tasks(id),fence INTEGER NOT NULL,seen_at REAL NOT NULL,phase TEXT NOT NULL);'''
+
+
+class Result:
+    returncode = 0
+    def __init__(self, sha):
+        self.stdout = (sha + '\n').encode('ascii')
+
+
+class ServiceTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = os.path.realpath(self.temp.name)
+        for name in ('repo', 'work', 'service-home', 'worker-home', 'codex-home', 'run'):
+            os.mkdir(os.path.join(self.root, name))
+        os.chmod(os.path.join(self.root,'run'),0o700)
+        self.sha = '8' * 40
+        self.config = {
+            'config_version': 1, 'control_repository': 'owner/repo',
+            'source_commit': self.sha,
+            'repositories': {'owner/repo': os.path.join(self.root, 'repo')},
+            'db_path': os.path.join(self.root, 'state.sqlite'),
+            'dispatcher_lock': os.path.join(self.root, 'run', 'dispatcher.lock'),
+            'github_writer_lock': os.path.join(self.root, 'run', 'github.lock'),
+            'workspace_root': os.path.join(self.root, 'work'),
+            'service_home': os.path.join(self.root, 'service-home'),
+            'worker_home': os.path.join(self.root, 'worker-home'),
+            'codex_home': os.path.join(self.root, 'codex-home'),
+            'worker_user': 'xj_codex_worker', 'codex_bin': '/usr/libexec/platform-python3.6',
+            'gh_bin': '/usr/bin/git', 'path': '/usr/bin:/bin',
+            'required_checks': ['stage1-tests'], 'model': 'gpt-5.6-sol', 'max_workers': 2}
+        with sqlite3.connect(self.config['db_path']) as db:
+            db.executescript(SCHEMA)
+        self.path = os.path.join(self.root, 'config.json')
+        with open(self.path, 'w') as handle:
+            json.dump(self.config, handle)
+        os.chmod(self.path,0o600)
+
+    def test_config_binds_exact_control_head_and_rejects_extra_keys(self):
+        run = lambda *a, **k: Result(self.sha)
+        self.assertEqual(load_config(self.path, run=run)['source_commit'], self.sha)
+        with self.assertRaises(ValueError):
+            load_config(self.path, run=lambda *a, **k: Result('7' * 40))
+        value = dict(self.config, surprise=True)
+        with open(self.path, 'w') as handle:
+            json.dump(value, handle)
+        os.chmod(self.path,0o600)
+        with self.assertRaises(ValueError):
+            load_config(self.path, run=run)
+
+    def test_privileged_worker_identity_is_rejected(self):
+        run = lambda *a, **k: Result(self.sha)
+        value = dict(self.config, worker_user='root')
+        with open(self.path, 'w') as handle:
+            json.dump(value, handle)
+        os.chmod(self.path,0o600)
+        with self.assertRaises(ValueError):
+            load_config(self.path, run=run)
+        value['worker_user'] = 'xj_alias'
+        with open(self.path, 'w') as handle:
+            json.dump(value, handle)
+        os.chmod(self.path,0o600)
+        account = type('Account', (), {'pw_uid': 0})()
+        with patch('development_service.pwd.getpwnam', return_value=account):
+            with self.assertRaises(ValueError):
+                load_config(self.path, run=run)
+
+    def test_worker_wrapper_rejects_root_uid(self):
+        prefix = isolation_prefix(self.config, self.config['workspace_root'])
+        root_prefix = [('--uid=root' if value.startswith('--uid=') else value)
+                       for value in prefix]
+        with self.assertRaises(ValueError):
+            CodexAppServerWorker('/usr/bin/codex', self.config['workspace_root'],
+                self.config['worker_home'], self.config['codex_home'], '/usr/bin:/bin',
+                model='gpt-5.6-sol', isolation_prefix=root_prefix)
+
+    def test_exclusive_dispatcher_lock(self):
+        first = acquire_dispatcher_lock(self.config['dispatcher_lock'])
+        self.addCleanup(first.close)
+        with self.assertRaises(RuntimeError):
+            acquire_dispatcher_lock(self.config['dispatcher_lock'])
+
+    def test_isolation_prefix_is_task_specific_and_bounded(self):
+        prefix = isolation_prefix(self.config, self.config['workspace_root'])
+        self.assertIn('--uid=xj_codex_worker', prefix)
+        self.assertIn('/usr/local/libexec/xj-codex-isolation-helper', prefix)
+        self.assertIn('--workdir=' + self.config['workspace_root'], prefix)
+        self.assertEqual(prefix[-1], '--')
+        worker = CodexAppServerWorker('/usr/bin/codex', self.config['workspace_root'],
+            self.config['worker_home'], self.config['codex_home'], '/usr/bin:/bin',
+            model='gpt-5.6-sol', isolation_prefix=prefix)
+        self.assertEqual(worker.build_argv()[:len(prefix)], prefix)
+        with self.assertRaises(ValueError):
+            CodexAppServerWorker('/usr/bin/codex', self.config['workspace_root'],
+                self.config['worker_home'], self.config['codex_home'], '/usr/bin:/bin',
+                model='gpt-5.6-sol', isolation_prefix=prefix[:-1] + ['--property=MemoryMax=infinity', '--'])
+
+    def test_github_writer_lock_and_approved_source_are_exclusive(self):
+        kwargs = dict(repositories={'owner/repo': self.config['repositories']['owner/repo']},
+                      workspace_root=self.config['workspace_root'],
+                      home=self.config['service_home'], path='/usr/bin:/bin',
+                      required_checks=['stage1-tests'], runner=lambda *a, **k: Result(self.sha),
+                      github_lock_path=self.config['github_writer_lock'])
+        first, second = CliBackend(**kwargs), CliBackend(**kwargs)
+        with first._github_writer():
+            with self.assertRaises(UnknownEffect):
+                with second._github_writer():
+                    pass
+        ledger = ExecutionLedger(self.config['db_path'], ['owner/repo'],
+                                 approved_base_shas=[self.sha])
+        with sqlite3.connect(self.config['db_path']) as db:
+            db.execute('INSERT INTO tasks VALUES(?,?,?,?,?,?,?,?,?)',
+                       ('task', 'CODEX_EXEC', 'PENDING', '[]', None, None, 0, '{}', 0))
+        spec = {'repo': 'owner/repo', 'type': 'CODEX_EXEC', 'prompt': 'approved',
+                'heavy': True, 'timeout_seconds': 60, 'base_sha': '7' * 40}
+        with self.assertRaises(ValueError):
+            ledger.register_spec('task', spec, 'work', True)
+
+    def test_consistent_backup_verify_and_restore_stage(self):
+        with sqlite3.connect(self.config['db_path']) as db:
+            db.execute('PRAGMA user_version=17'); db.execute('PRAGMA application_id=4242')
+        backup_path = os.path.join(self.root, 'backup', 'ledger.sqlite')
+        manifest = backup(self.config['db_path'], backup_path)
+        self.assertEqual(verify(backup_path, manifest['sha256'])['quick_check'], 'ok')
+        staged = os.path.join(self.root, 'restore', 'ledger.sqlite')
+        restored = stage_restore(backup_path, staged, manifest['sha256'])
+        self.assertEqual(verify(staged, restored['sha256'])['counts'], manifest['counts'])
+        with sqlite3.connect(staged) as db:
+            self.assertEqual(db.execute('PRAGMA user_version').fetchone()[0],17)
+            self.assertEqual(db.execute('PRAGMA application_id').fetchone()[0],4242)
+        with self.assertRaises(ValueError):
+            verify(staged, '0' * 64)
+
+
+if __name__ == '__main__':
+    unittest.main()
