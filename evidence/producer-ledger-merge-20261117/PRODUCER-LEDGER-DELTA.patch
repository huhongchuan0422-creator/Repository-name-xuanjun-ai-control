+            'reported_new_backup':False if status=='CHECK_NO_CHANGE' else 'UNKNOWN',
+            'verified_last_success_at':'UNKNOWN','requested_interval_seconds':300,
+            'schedule_enabled':'UNKNOWN','backup_started':False}
