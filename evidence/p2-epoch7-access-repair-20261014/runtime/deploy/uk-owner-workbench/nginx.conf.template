# Render @@OWNER_HOST@@, @@TLS_CERT@@ and @@TLS_KEY@@ through the controlled
# release entry. Do not expose either Python service directly.
limit_req_zone $binary_remote_addr zone=owner_callback_rate:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=owner_callback_conn:10m;
server {
    listen 443 ssl http2;
    server_name @@OWNER_HOST@@;

    ssl_certificate @@TLS_CERT@@;
    ssl_certificate_key @@TLS_KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;

    client_max_body_size 16k;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;

    location = /owner-callback {
        limit_except POST { deny all; }
        limit_req zone=owner_callback_rate burst=10 nodelay;
        limit_conn owner_callback_conn 4;
        proxy_pass http://127.0.0.1:18557/owner-callback;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Xuanjun-Signature $http_x_xuanjun_signature;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 12s;
    }

    location = /owner/ {
        limit_conn owner_callback_conn 4;
        proxy_pass http://127.0.0.1:18556/;
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 12s;
    }
    location = /owner/api/state {
        limit_req zone=owner_callback_rate burst=10 nodelay;
        limit_conn owner_callback_conn 4;
        proxy_pass http://127.0.0.1:18556/api/state;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 12s;
    }
    location / { return 404; }
}
