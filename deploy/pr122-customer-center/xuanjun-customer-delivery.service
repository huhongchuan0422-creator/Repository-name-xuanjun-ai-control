[Unit]
Description=Xuanjun customer verified channel outbox delivery
After=xuanjun-customer-center.service
[Service]
Type=oneshot
User=xuanjun-customer
Group=xuanjun-customer
WorkingDirectory=/usr/local/lib/xuanjun-customer-center
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/xuanjun-customer-center/boot.py worker
LoadCredential=runtime.json:/etc/xuanjun-customer-center/runtime.json
UMask=0077
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy SSLKEYLOGFILE SSL_CERT_FILE SSL_CERT_DIR
NoNewPrivileges=yes
LimitCORE=0
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/xuanjun-customer-center
MemoryMax=256M
TasksMax=16
TimeoutStartSec=60
