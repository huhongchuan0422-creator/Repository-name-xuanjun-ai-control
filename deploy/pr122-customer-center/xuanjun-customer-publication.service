[Unit]
Description=Xuanjun signed preview delivery publisher
After=xuanjun-customer-center.service
[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/usr/local/lib/xuanjun-customer-center
ExecStart=/usr/local/lib/xuanjun-customer-runtime/venv/bin/python -I -B /usr/local/lib/xuanjun-customer-center/boot.py publisher
LoadCredential=publisher.json:/etc/xuanjun-customer-center/publisher.json
UMask=0077
NoNewPrivileges=yes
LimitCORE=0
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/xuanjun-customer-center
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy SSLKEYLOGFILE SSL_CERT_FILE SSL_CERT_DIR
MemoryMax=256M
TasksMax=12
TimeoutStartSec=45
