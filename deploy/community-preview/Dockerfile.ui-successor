FROM community-admin-ui:f99da75e-owner-requirements
ARG OWNER_UI_CONTRACT_SHA256
# First-party mapping plus explicit backward-compatible API schema successor; core/model bytes remain unchanged; encrypted store has additive recovery journal.
USER root
COPY services/ocr_engine/api.py services/ocr_engine/secure_store.py /app/services/ocr_engine/
COPY scripts/community_ocr_dependency.json /app/scripts/community_ocr_dependency.json
COPY scripts/community_license_layout.py scripts/community_identity_layout.py scripts/community_license_inference.py scripts/community_ocr_host.py scripts/community_ocr_bridge.py scripts/community_platform_host.py /app/scripts/
RUN python -B -c "from scripts.community_license_inference import run_license_layout_ocr; from scripts.community_license_layout import normalize_layout, extract_license_fields; import scripts.community_ocr_host; import scripts.community_platform_host"
COPY tests/test_community_license_layout.py tests/test_community_license_raw_replay.py tests/test_community_identity_layout.py tests/test_community_document_orientation.py tests/community_license_runtime_checks.py tests/community_identity_api_runtime_checks.py /tmp/community-layout-tests/
COPY tests/fixtures/community_license_label_noise_geometry.json /tmp/community-layout-tests/fixtures/community_license_label_noise_geometry.json
COPY tests/fixtures/community_document_failure_geometry.json /tmp/community-layout-tests/fixtures/community_document_failure_geometry.json
COPY tests/fixtures/community_license_columns90_image.json /tmp/community-layout-tests/fixtures/community_license_columns90_image.json
COPY tests/fixtures/community_license_layout_heldout.json /tmp/community-layout-tests/fixtures/community_license_layout_heldout.json
COPY tests/fixtures/community_license_layout/ /tmp/community-layout-tests/fixtures/community_license_layout/
RUN python -B -m unittest discover -s /tmp/community-layout-tests -v && PYTHONPATH=/app:/tmp/community-layout-tests python -B -m unittest community_license_runtime_checks community_identity_api_runtime_checks -v && rm -rf /tmp/community-layout-tests
COPY deploy/community-preview/community-admin-ui-contract.json /app/deploy/community-preview/community-admin-ui-contract.json
COPY scripts/community_admin_ui_release_guard.py scripts/community_web_entries.py scripts/community_admin_management.py scripts/community_admin_route_inventory.py scripts/community_center_operations.py scripts/community_public_directory.py scripts/community_split_returns.py scripts/community_wechat_sp_actions.py scripts/community_merchant_onboarding.py scripts/community_wechat_applyment.py scripts/community_mini_application.py scripts/community_mini_http.py scripts/community_mini_merchant.py scripts/community_license_region.py scripts/community_license_region_areas.json scripts/community_wechat_payment_activation.py scripts/community_split_rules.py scripts/community_reports.py scripts/community_merchant_points.py scripts/community_ad_contract.py scripts/community_ad_store.py scripts/community_commerce.py scripts/community_merchant_store.py scripts/community_workbench.py scripts/community_stage_migration.py scripts/community_platform_views.py /app/scripts/
COPY demos/community-stage/admin-shell.css demos/community-stage/admin-shell.js demos/community-stage/communities.js demos/community-stage/onboarding.css demos/community-stage/onboarding.html demos/community-stage/onboarding.js demos/community-stage/workbench.html demos/community-stage/workbench.css demos/community-stage/workbench.js demos/community-stage/web-session.js /app/demos/community-stage/
COPY clients/community-mini/pages/merchant-join/index.wxml /app/clients/community-mini/pages/merchant-join/index.wxml
COPY demos/community-stage/ui-preview/sources.js /app/demos/community-stage/ui-preview/sources.js
COPY deploy/community-preview/COMMUNITY_SOURCE_SHA.successor /app/COMMUNITY_SOURCE_SHA
RUN chmod 0444 /app/scripts/community_platform_host.py /app/demos/community-stage/ui-preview/sources.js /app/services/ocr_engine/api.py /app/services/ocr_engine/secure_store.py /app/scripts/community_ocr_dependency.json /app/scripts/community_identity_layout.py /app/scripts/community_ocr_bridge.py /app/scripts/community_ocr_host.py /app/scripts/community_license_layout.py /app/scripts/community_license_inference.py /app/COMMUNITY_SOURCE_SHA /app/deploy/community-preview/community-admin-ui-contract.json /app/scripts/community_admin_ui_release_guard.py /app/demos/community-stage/admin-shell.css /app/demos/community-stage/admin-shell.js /app/demos/community-stage/communities.js /app/demos/community-stage/onboarding.css /app/demos/community-stage/onboarding.html /app/demos/community-stage/onboarding.js /app/demos/community-stage/workbench.html /app/demos/community-stage/workbench.css /app/demos/community-stage/workbench.js /app/demos/community-stage/web-session.js /app/scripts/community_web_entries.py /app/scripts/community_admin_management.py /app/scripts/community_admin_route_inventory.py /app/scripts/community_center_operations.py /app/scripts/community_public_directory.py /app/scripts/community_split_returns.py /app/scripts/community_wechat_sp_actions.py /app/scripts/community_merchant_onboarding.py /app/scripts/community_wechat_applyment.py /app/scripts/community_mini_application.py /app/scripts/community_mini_http.py /app/scripts/community_mini_merchant.py /app/scripts/community_license_region.py /app/scripts/community_license_region_areas.json /app/scripts/community_wechat_payment_activation.py /app/scripts/community_split_rules.py /app/scripts/community_reports.py /app/scripts/community_merchant_points.py /app/scripts/community_ad_contract.py /app/scripts/community_ad_store.py /app/scripts/community_commerce.py /app/scripts/community_merchant_store.py /app/scripts/community_workbench.py /app/scripts/community_stage_migration.py /app/scripts/community_platform_views.py /app/clients/community-mini/pages/merchant-join/index.wxml && cd /app && python scripts/community_admin_ui_release_guard.py --contract /app/deploy/community-preview/community-admin-ui-contract.json --expected-owner-contract-sha256 "$OWNER_UI_CONTRACT_SHA256"
ENV COMMUNITY_SOURCE_SHA=1a46a435225dfc888c300eeaf51444429cac73be
LABEL org.opencontainers.image.revision=1a46a435225dfc888c300eeaf51444429cac73be \
      community.source.tree=399ee8de41a491c90b4d48a35a880618d6302a9b \
      com.xuanjun.parent-image=sha256:861161c201bdab8d2586bf32a746ca1f8b0e5998381a653568b557cf144540fb \
      com.xuanjun.change-scope=community-admin-owner-25-requirements
USER 10001:1008
CMD ["--plan","/var/lib/xuanjun-community-preview/config/host.json","--center-keys","/var/lib/xuanjun-community-preview/config/center-keys.json","--wechat-secret","/var/lib/xuanjun-community-preview/config/wechat.json"]
