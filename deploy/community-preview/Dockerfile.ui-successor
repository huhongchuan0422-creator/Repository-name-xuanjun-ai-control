FROM community-admin-ui:f99da75e-owner-requirements
ARG OWNER_UI_CONTRACT_SHA256
USER root
RUN --mount=type=bind,source=.,target=/src,readonly set -eu; \
    for path in \
      deploy/community-preview/community-admin-ui-contract.json \
      scripts/community_admin_ui_release_guard.py \
      demos/community-stage/admin-shell.css \
      demos/community-stage/admin-shell.js \
      demos/community-stage/communities.js \
      demos/community-stage/onboarding.css \
      demos/community-stage/onboarding.html \
      demos/community-stage/onboarding.js \
      demos/community-stage/workbench.html \
      demos/community-stage/workbench.css \
      demos/community-stage/workbench.js \
      demos/community-stage/web-session.js \
      scripts/community_web_entries.py \
      scripts/community_web_session.py \
      scripts/community_mini_http.py \
      scripts/community_admin_management.py \
      scripts/community_admin_route_inventory.py \
      scripts/community_center_operations.py \
      scripts/community_local_admin.py \
      scripts/community_registered_admin.py \
      scripts/community_stage_runtime.py \
      scripts/community_member_merchant_projection.py \
      scripts/community_platform_views.py \
      scripts/community_public_directory.py \
      scripts/community_split_returns.py \
      scripts/community_wechat_sp_actions.py \
      scripts/community_merchant_onboarding.py \
      scripts/community_wechat_applyment.py \
      scripts/community_mini_application.py \
      scripts/community_wechat_payment_activation.py \
      scripts/community_split_rules.py \
      scripts/community_reports.py \
      scripts/community_merchant_points.py \
      scripts/community_ad_contract.py \
      scripts/community_ad_store.py \
      scripts/community_commerce.py \
      scripts/community_merchant_store.py \
      scripts/community_workbench.py \
      scripts/community_stage_migration.py \
      clients/community-mini/pages/checkout/index.js \
      clients/community-mini/pages/merchant-join/index.wxml; \
    do install -D -m 0444 "/src/$path" "/app/$path"; done; \
    install -D -m 0444 /src/deploy/community-preview/COMMUNITY_SOURCE_SHA.successor /app/COMMUNITY_SOURCE_SHA; \
    cd /app; \
    python scripts/community_admin_ui_release_guard.py --contract /app/deploy/community-preview/community-admin-ui-contract.json --expected-owner-contract-sha256 "$OWNER_UI_CONTRACT_SHA256"
ENV COMMUNITY_SOURCE_SHA=9ca6179efa32e2e256542f1f5a61b4d07dbb66ca
LABEL org.opencontainers.image.revision=9ca6179efa32e2e256542f1f5a61b4d07dbb66ca \
      community.source.tree=89007862038e8efada7f42046838b6dd89e441b6 \
      com.xuanjun.parent-image=sha256:861161c201bdab8d2586bf32a746ca1f8b0e5998381a653568b557cf144540fb \
      com.xuanjun.change-scope=community-admin-owner-25-requirements
USER 10001:1008
CMD ["--plan","/var/lib/xuanjun-community-preview/config/host.json","--center-keys","/var/lib/xuanjun-community-preview/config/center-keys.json","--wechat-secret","/var/lib/xuanjun-community-preview/config/wechat.json"]
