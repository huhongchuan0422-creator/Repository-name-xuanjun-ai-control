+    def resolve_material_recovery_job(self, tenant_id, subject, application, document_type, attachment_id, document_sha256):
+        """Read-only exact owner/material search. All states count; never choose newest."""
+        expected = dict(tenant_id=tenant_id,subject=subject,onboarding_application_id=application,
+                        document_type=document_type,attachment_id=attachment_id,document_sha256=document_sha256)
+        if any(type(v) is not str or not v for v in expected.values()):
+            raise ValueError('OCR_RECOVERY_BINDING_INVALID')
+        matches=[]
+        with self._connect() as db:
+            rows=db.execute('SELECT ciphertext FROM ocr_jobs WHERE tenant_key=? AND subject_key=?',
+                (self._index(tenant_id),self._index(tenant_id+'/'+subject)))
+            for row in rows:
+                job=self._open(row['ciphertext'])
+                if all(type(job.get(k)) is str and job[k]==v for k,v in expected.items()):
+                    matches.append(job)
+                    if len(matches)>1:raise ValueError('OCR_RECOVERY_MATERIAL_AMBIGUOUS')
+        if not matches:raise ValueError('OCR_RECOVERY_MATERIAL_NOT_FOUND')
+        return self.resolve_recovery_job(tenant_id,subject,application,document_type,job_id=matches[0]['job_id'])
+
+    def resolve_recovery_job(self, tenant_id, subject, application, document_type, *, job_id=None, original_key=None):
+        """Exact owned lookup only; never create/claim/infer or select latest."""
+        if bool(job_id) == bool(original_key):
+            raise ValueError('OCR_RECOVERY_EXACT_LOCATOR_REQUIRED')
+        if job_id:
+            job = self.get(job_id, tenant_id)
+        else:
+            with self._connect() as db:
+                row = db.execute('SELECT ciphertext FROM ocr_jobs WHERE tenant_key=? AND idem_key=?',
+                    (self._index(tenant_id), self._index(tenant_id + '/' + original_key))).fetchone()
+            job = self._open(row['ciphertext']) if row else None
+        if not job or any(job.get(k) != v for k, v in {
+                'tenant_id':tenant_id,'subject':subject,'onboarding_application_id':application,
+                'document_type':document_type}.items()):
+            raise PermissionError('OCR_RECOVERY_JOB_NOT_FOUND')
+        if not job.get('attachment_id') or not job.get('document_sha256') or not job.get('application_revision'):
+            raise PermissionError('OCR_RECOVERY_BINDING_MISSING')
+        return job
+
+    def recovery_record(self, tenant_id, subject, operation, key, payload, result):
+        """Append-only encrypted operation receipt. Caller reauthorizes every replay.
+
+        Recovery IDs are audit references, not authentication capabilities.
+        No original OCR job or original confirmation receipt is modified.
+        """
+        if operation not in ('view','confirm','apply') or not isinstance(key,str) or not key:
+            raise ValueError('OCR_RECOVERY_OPERATION_INVALID')
+        if type(payload) is not dict or type(result) is not dict:
+            raise ValueError('OCR_RECOVERY_PAYLOAD_INVALID')
+        tenant = self._index(tenant_id)
+        owner = self._index(tenant_id + '/' + subject)
+        idem = self._index('recovery/' + tenant_id + '/' + subject + '/' + operation + '/' + key)
+        digest = self._index(json.dumps(payload,sort_keys=True,separators=(',',':')))
+        with self._connect() as db:
+            db.execute('BEGIN IMMEDIATE')
+            db.execute('''CREATE TABLE IF NOT EXISTS ocr_recovery_receipts(
+                tenant_key TEXT NOT NULL, subject_key TEXT NOT NULL, operation TEXT NOT NULL,
+                idem_key TEXT NOT NULL, payload_hash TEXT NOT NULL, ciphertext BLOB NOT NULL,
+                PRIMARY KEY(tenant_key,subject_key,operation,idem_key))''')
+            row=db.execute('SELECT payload_hash,ciphertext FROM ocr_recovery_receipts WHERE tenant_key=? AND subject_key=? AND operation=? AND idem_key=?',
+                (tenant,owner,operation,idem)).fetchone()
+            if row:
+                if row['payload_hash'] != digest:
+                    db.execute('ROLLBACK')
+                    raise ValueError('OCR_RECOVERY_IDEMPOTENCY_CONFLICT')
+                stored=self._open(row['ciphertext']);db.execute('COMMIT');return stored
+            db.execute('INSERT INTO ocr_recovery_receipts VALUES(?,?,?,?,?,?)',
+                (tenant,owner,operation,idem,digest,self._seal(result)))
+            db.execute('COMMIT')
+        return json.loads(json.dumps(result))
+
+    def recovery_receipt(self, tenant_id, subject, operation, key):
+        if operation not in ('view','confirm','apply') or not isinstance(key,str) or not key:
+            raise ValueError('OCR_RECOVERY_OPERATION_INVALID')
+        with self._connect() as db:
+            exists=db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='ocr_recovery_receipts'").fetchone()
+            if not exists:return None
+            row=db.execute('SELECT ciphertext FROM ocr_recovery_receipts WHERE tenant_key=? AND subject_key=? AND operation=? AND idem_key=?',
+                (self._index(tenant_id),self._index(tenant_id+'/'+subject),operation,
+                 self._index('recovery/'+tenant_id+'/'+subject+'/'+operation+'/'+key))).fetchone()
+        return self._open(row['ciphertext']) if row else None
+
+    def _delete_recovery_receipts(self, db, job_id, tenant_key):
+        exists=db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='ocr_recovery_receipts'").fetchone()
+        if not exists:return
+        rows=db.execute('SELECT rowid,ciphertext FROM ocr_recovery_receipts WHERE tenant_key=?',(tenant_key,)).fetchall()
+        for row in rows:
+            if self._open(row['ciphertext']).get('job_id')==job_id:
+                db.execute('DELETE FROM ocr_recovery_receipts WHERE rowid=?',(row['rowid'],))
