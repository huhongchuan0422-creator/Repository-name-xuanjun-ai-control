#!/usr/bin/python3 -I
import sys
sys.dont_write_bytecode=True
import hashlib,json,pathlib,runpy,stat
r=pathlib.Path('/usr/local/lib/xuanjun-showcase')
p=pathlib.Path('/etc/xuanjun-showcase/BUILDER_POLICY.json')
for x in (p,*p.parents,r,*r.parents):
 s=x.lstat();assert s.st_uid==0 and not stat.S_ISLNK(s.st_mode) and not s.st_mode&0o022
assert stat.S_IMODE(p.stat().st_mode)==0o600 and p.stat().st_nlink==1
q=json.loads(p.read_bytes());raw=(r/'MECHANISM_MANIFEST.json').read_bytes()
assert hashlib.sha256(raw).hexdigest()==q['mechanism_manifest_sha256']
m=json.loads(raw)
for f in m['files']:
 if not f['path'].startswith('scripts/'):continue
 name=pathlib.Path(f['path']);assert not name.is_absolute() and '..' not in name.parts
 target=r/name
 for x in (target,*target.parents):
  s=x.lstat();assert s.st_uid==0 and not stat.S_ISLNK(s.st_mode) and not s.st_mode&0o022
 assert hashlib.sha256(target.read_bytes()).hexdigest()==f['sha256']
sys.path.insert(0,str(r))
runpy.run_module('scripts.pr122_showcase_build_channel',run_name='__main__')
